# SOME は ANY の別名

query T
SELECT (1 = SOME(ARRAY[1,2]))::text
----
true

query T
SELECT (3 = SOME(ARRAY[1,2]))::text
----
false

# 部分式

query T
SELECT (1 = ANY(ARRAY[1,2]) AND 2 = ANY(ARRAY[2,3]))::text
----
true

query T
SELECT (NOT (1 = ANY(ARRAY[2,3])))::text
----
true

query T
SELECT (NOT (1 = ANY(ARRAY[2,NULL])))::text
----
NULL

query T
SELECT (NOT (1 = ALL(ARRAY[1,NULL])))::text
----
NULL

query T
SELECT (NOT (1 <> ALL(ARRAY[2,NULL])))::text
----
NULL

query T
SELECT (1 = ANY(ARRAY[1,2]) IS TRUE)::text
----
true

query T
SELECT (1 = ANY(ARRAY[2,NULL]) IS NULL)::text
----
true

query T
SELECT (1 = ANY(ARRAY[2,NULL]) IS NOT TRUE)::text
----
true

query T
SELECT (1 = ANY(ARRAY[2,NULL]) IS FALSE)::text
----
false

query T
SELECT (coalesce(1 = ANY(ARRAY[2,NULL]), false))::text
----
false

query T
SELECT (1 = ANY(ARRAY[1+0, 2+0]))::text
----
true

query T
SELECT (1 = ANY(ARRAY[length('a'), 2]))::text
----
true

query T
SELECT ((1 + 1) = ANY(ARRAY[2, 3]))::text
----
true

# ARRAY(SELECT ...) との組み合わせ

query T
SELECT (1 = ANY(ARRAY(SELECT 1)))::text
----
true

query T
SELECT (1 = ANY(ARRAY(SELECT 2)))::text
----
false

query T
SELECT (1 = ANY(ARRAY(SELECT 1 WHERE false)))::text
----
false

query T
SELECT (1 = ALL(ARRAY(SELECT 1 WHERE false)))::text
----
true

query T
SELECT (2 = ANY(ARRAY(SELECT g FROM generate_series(1, 3) g)))::text
----
true

query T
SELECT (5 = ANY(ARRAY(SELECT g FROM generate_series(1, 3) g)))::text
----
false

query T
SELECT (2 <> ALL(ARRAY(SELECT g FROM generate_series(1, 3) g)))::text
----
false

query T
SELECT (5 <> ALL(ARRAY(SELECT g FROM generate_series(1, 3) g)))::text
----
true

query T
SELECT (1 = ANY(ARRAY(SELECT NULL::int)))::text
----
NULL

query T
SELECT (1 = ANY(ARRAY(SELECT x FROM (VALUES (1), (NULL)) v(x))))::text
----
true

query T
SELECT (3 = ANY(ARRAY(SELECT x FROM (VALUES (1), (NULL)) v(x))))::text
----
NULL

# IN との同値

query T
SELECT ((1 = ANY(ARRAY[1,2])) = (1 IN (1,2)))::text
----
true

query T
SELECT ((3 = ANY(ARRAY[1,2])) = (3 IN (1,2)))::text
----
true

query T
SELECT ((NULL::int = ANY(ARRAY[1,2])) IS NOT DISTINCT FROM (NULL::int IN (1,2)))::text
----
true

query T
SELECT ((3 = ANY(ARRAY[1,NULL])) IS NOT DISTINCT FROM (3 IN (1,NULL)))::text
----
true

query T
SELECT ((1 <> ALL(ARRAY[2,3])) = (1 NOT IN (2,3)))::text
----
true

query T
SELECT ((1 <> ALL(ARRAY[2,NULL])) IS NOT DISTINCT FROM (1 NOT IN (2,NULL)))::text
----
true

query T
SELECT ((1 <> ALL(ARRAY[1,NULL])) IS NOT DISTINCT FROM (1 NOT IN (1,NULL)))::text
----
true

# WHERE id = ANY(ARRAY[...])

query T
SELECT g::text FROM generate_series(1, 6) g WHERE g = ANY(ARRAY[1,3,5,7]) ORDER BY g
----
1
3
5


query T
SELECT g::text FROM generate_series(1, 6) g WHERE g <> ALL(ARRAY[1,3,5,7]) ORDER BY g
----
2
4
6


query T
SELECT g::text FROM generate_series(1, 6) g WHERE g = ANY('{2,4}') ORDER BY g
----
2
4


query T
SELECT g::text FROM generate_series(1, 6) g WHERE g = ANY(ARRAY[]::int[]) ORDER BY g
----


query T
SELECT g::text FROM generate_series(1, 6) g WHERE g <> ALL(ARRAY[]::int[]) ORDER BY g
----
1
2
3
4
5
6


query T
SELECT g::text FROM generate_series(1, 6) g WHERE g = ANY(ARRAY[2, NULL]) ORDER BY g
----
2


query T
SELECT g::text FROM generate_series(1, 6) g WHERE g <> ALL(ARRAY[2, NULL]) ORDER BY g
----


query T
SELECT g::text FROM generate_series(1, 6) g WHERE NOT (g = ANY(ARRAY[2, NULL])) ORDER BY g
----


query T
SELECT g::text FROM generate_series(1, 6) g WHERE g > ANY(ARRAY[4, 5]) ORDER BY g
----
5
6


query T
SELECT g::text FROM generate_series(1, 6) g WHERE g > ALL(ARRAY[4, 5]) ORDER BY g
----
6


query T
SELECT g::text FROM generate_series(1, 6) g WHERE g = ANY(ARRAY(SELECT x * 2 FROM generate_series(1, 3) x)) ORDER BY g
----
2
4
6


query T
SELECT g::text FROM generate_series(1, 6) g WHERE g::text = ANY(ARRAY['1','6']) ORDER BY g
----
1
6


query T
SELECT g::text FROM generate_series(1, 6) g WHERE g::text = ANY('{1,6}') ORDER BY g
----
1
6


query T
SELECT g::text FROM generate_series(1, 6) g WHERE g IN (1, 3, 5) ORDER BY g
----
1
3
5


query T
SELECT g::text FROM generate_series(1, 6) g WHERE g = ANY(ARRAY[1.0, 3.0, 5.5]) ORDER BY g
----
1
3


query T
SELECT g::text FROM generate_series(1, 6) g WHERE g::numeric = ANY(ARRAY[1.0, 3.00, 5.5]) ORDER BY g
----
1
3


query T
SELECT g::text FROM generate_series(1, 6) g WHERE g::int2 = ANY(ARRAY[1::int8, 3::int8]) ORDER BY g
----
1
3


