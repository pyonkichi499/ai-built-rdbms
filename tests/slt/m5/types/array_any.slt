# ANY / ALL の三値論理と IN との同値

# 接頭辞: types_array_any_（テーブルは作らない。KD-14）

query T
SELECT (1 = ANY(NULL::int[]))::text
----
NULL

query T
SELECT (1 = ALL(NULL::int[]))::text
----
NULL

