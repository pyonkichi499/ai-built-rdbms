----
true

query T
SELECT (1 <> ALL('{2,3}'))::text
----
true

query T
SELECT ('a' = ANY('{a,b}'))::text
----
true

query T
SELECT ('c' = ANY('{a,b}'))::text
----
false

query T
SELECT ('a'::text = ANY('{a,b}'))::text
----
true

query T
SELECT (1 = ANY('{}'))::text
----
false

query T
SELECT (1 = ANY(NULL))::text
----
NULL

