SET TIME ZONE 'UTC'

# to_timestamp(float8)

query T
SELECT (to_timestamp(0))::text
----
1970-01-01 00:00:00+00

query T
SELECT (to_timestamp(1709528767))::text
----
2024-03-04 05:06:07+00

query T
SELECT (to_timestamp(1709528767.5))::text
----
2024-03-04 05:06:07.5+00

query T
SELECT (to_timestamp(-1))::text
----
1969-12-31 23:59:59+00

query T
SELECT (to_timestamp(946684800.123456))::text
----
2000-01-01 00:00:00.123456+00

query T
SELECT (to_timestamp(1e10))::text
----
2286-11-20 17:46:40+00

query T
SELECT (pg_typeof(to_timestamp(0)))::text
----
timestamp with time zone

query T
SELECT (to_timestamp('infinity'::float8))::text
----
infinity

query T
SELECT (to_timestamp('-infinity'::float8))::text
----
-infinity

statement ok
SET TIME ZONE 'Asia/Tokyo'

query T
SELECT (to_timestamp(0))::text
----
1970-01-01 09:00:00+09

statement ok
SET TIME ZONE 'UTC'

# isfinite

query T
SELECT (isfinite(date '2024-03-04'))::text
----
true

query T
SELECT (isfinite(date 'infinity'))::text
----
false

query T
SELECT (isfinite(date '-infinity'))::text
----
false

query T
SELECT (isfinite(timestamp '2024-03-04'))::text
----
true

query T
SELECT (isfinite(timestamp 'infinity'))::text
----
false

query T
SELECT (isfinite(timestamptz '-infinity'))::text
----
false

query T
SELECT (isfinite(timestamptz '2024-03-04 00:00+00'))::text
----
true

# 無限値の比較と演算

query T
SELECT (timestamp 'infinity' > timestamp '9999-12-31')::text
----
true

query T
SELECT (timestamp '-infinity' < timestamp '0001-01-01')::text
----
true

query T
SELECT (date 'infinity' > date '5874897-12-31')::text
----
true

query T
SELECT (timestamp 'infinity' + interval '1 day')::text
----
infinity

query T
SELECT (timestamp 'infinity' = timestamp 'infinity')::text
----
true

query T
SELECT (date 'infinity' + 1)::text
----
infinity

query T
SELECT (date '2024-03-04' + interval 'infinity')::text
----
infinity

statement error (22008)
SELECT timestamp 'infinity' - timestamp 'infinity'

# 日付の算術

query T
SELECT (date '2024-03-04' + 1)::text
----
2024-03-05

query T
SELECT (date '2024-03-04' - 1)::text
----
2024-03-03

query T
SELECT (date '2024-03-04' + 365)::text
----
2025-03-04

query T
SELECT (date '2024-03-04' - date '2023-03-04')::text
----
366

query T
SELECT (date '2024-03-01' - 1)::text
----
2024-02-29

query T
SELECT (date '2023-03-01' - 1)::text
----
2023-02-28

query T
SELECT (pg_typeof(date '2024-03-04' - date '2023-03-04'))::text
----
integer

query T
SELECT (pg_typeof(date '2024-03-04' + 1))::text
----
date

# generate_series（timestamp）

query T
SELECT generate_series(timestamp '2024-01-31', timestamp '2024-05-31', interval '1 month')::text
----
2024-01-31 00:00:00
2024-02-29 00:00:00
2024-03-29 00:00:00
2024-04-29 00:00:00
2024-05-29 00:00:00

query T
SELECT generate_series(timestamp '2024-03-04 00:00', timestamp '2024-03-04 02:00', interval '45 minutes')::text
----
2024-03-04 00:00:00
2024-03-04 00:45:00
2024-03-04 01:30:00

query T
SELECT generate_series(timestamp '2024-03-04', timestamp '2024-03-01', interval '-1 day')::text
----
2024-03-04 00:00:00
2024-03-03 00:00:00
2024-03-02 00:00:00
2024-03-01 00:00:00

statement count 0
SELECT generate_series(timestamp '2024-03-04', timestamp '2024-03-01', interval '1 day')::text

query T
SELECT generate_series(timestamp '2024-03-04', timestamp '2024-03-04', interval '1 day')::text
----
2024-03-04 00:00:00

query T
SELECT generate_series(timestamptz '2024-03-04 00:00+00', timestamptz '2024-03-05 00:00+00', interval '12 hours')::text
----
2024-03-04 00:00:00+00
2024-03-04 12:00:00+00
2024-03-05 00:00:00+00

query T
SELECT generate_series(date '2024-03-01', date '2024-03-03', interval '1 day')::text
----
2024-03-01 00:00:00+00
2024-03-02 00:00:00+00
2024-03-03 00:00:00+00

query I
SELECT count(*) FROM generate_series(timestamp '2024-01-01', timestamp '2024-12-31', interval '1 day')
----
366

query T
SELECT pg_typeof(generate_series(date '2024-03-01', date '2024-03-03', interval '1 day'))::text
----
timestamp with time zone
timestamp with time zone
timestamp with time zone

statement error (22023)
SELECT generate_series(timestamp '2024-03-04', timestamp '2024-03-05', interval '0')::text

statement error (22023)
SELECT generate_series(timestamp '2024-03-04', timestamp '2024-03-05', interval '1 day -24 hours')::text

# generate_series(date, date)は整数ではなく date 版がない: timestamp へ昇格

query T
SELECT (d)::date::text FROM generate_series(date '2024-02-27', date '2024-03-02', interval '1 day') AS g(d)
----
2024-02-27
2024-02-28
2024-02-29
2024-03-01
2024-03-02

# 表と組み合わせ

statement ok
CREATE TABLE types_datetime_funcs_t (id int, ts timestamp, tz timestamptz, d date)

statement ok
INSERT INTO types_datetime_funcs_t VALUES (1, '2024-03-04 05:06:07', '2024-03-04 05:06:07+00', '2024-03-04'), (2, '2023-12-31 23:00:00', '2023-12-31 23:00:00+00', '2023-12-31'), (3, 'infinity', 'infinity', 'infinity'), (4, NULL, NULL, NULL)

query IT
SELECT id, date_trunc('month', ts)::text FROM types_datetime_funcs_t ORDER BY id
----
1	2024-03-01 00:00:00
2	2023-12-01 00:00:00
3	infinity
4	NULL

query IT
SELECT id, extract(year from d)::text FROM types_datetime_funcs_t ORDER BY id
----
1	2024
2	2023
3	Infinity
4	NULL

query IT
SELECT id, (ts - timestamp '2023-01-01')::text FROM types_datetime_funcs_t WHERE isfinite(ts) ORDER BY id
----
1	428 days 05:06:07
2	364 days 23:00:00

query IT
SELECT id, (d + 30)::text FROM types_datetime_funcs_t WHERE isfinite(d) ORDER BY id
----
1	2024-04-03
2	2024-01-30

query T
SELECT date_trunc('year', ts)::text || ' ' || count(*) FROM types_datetime_funcs_t WHERE isfinite(ts) GROUP BY date_trunc('year', ts) ORDER BY 1
----
2023-01-01 00:00:00 1
2024-01-01 00:00:00 1

query IT
SELECT id, extract(epoch from tz)::text FROM types_datetime_funcs_t WHERE isfinite(tz) ORDER BY id
----
1	1709528767.000000
2	1704063600.000000

statement ok
