query T
SELECT (make_timestamp(2024, 3, 4, 5, 6, 0))::text
----
2024-03-04 05:06:00

query T
SELECT (make_timestamp(2024, 12, 31, 23, 59, 59.999999))::text
----
2024-12-31 23:59:59.999999

query T
SELECT (make_timestamptz(2024, 3, 4, 5, 6, 7.5))::text
----
2024-03-04 05:06:07.5+00

query T
SELECT (make_timestamptz(2024, 3, 4, 5, 6, 7.5, 'Asia/Tokyo'))::text
----
2024-03-03 20:06:07.5+00

query T
SELECT (make_timestamptz(2024, 3, 4, 5, 6, 7.5, 'America/New_York'))::text
----
2024-03-04 10:06:07.5+00

query T
