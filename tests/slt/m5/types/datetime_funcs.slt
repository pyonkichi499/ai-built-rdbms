----
00:00:00

query T
SELECT (age(timestamp '2023-01-10', timestamp '2024-03-15'))::text
----
-1 years -2 mons -5 days

query T
SELECT (age(timestamp '2024-03-31', timestamp '2024-02-29'))::text
----
1 mon 2 days

query T
SELECT (age(timestamp '2024-03-01', timestamp '2024-01-31'))::text
----
1 mon 1 day

query T
SELECT (age(timestamp '2024-02-29', timestamp '2023-02-28'))::text
----
1 year 1 day

query T
SELECT (age(timestamp '2025-02-28', timestamp '2024-02-29'))::text
----
11 mons 28 days

query T
SELECT (age(timestamp '2001-04-10', timestamp '1957-06-13'))::text
----
43 years 9 mons 27 days

query T
SELECT (age(timestamp '2024-03-15 01:00', timestamp '2024-03-14 23:00'))::text
----
02:00:00

query T
