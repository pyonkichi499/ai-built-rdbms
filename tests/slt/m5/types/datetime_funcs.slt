----
2024-03-04

query T
SELECT (make_date(2024, 2, 29))::text
----
2024-02-29

query T
SELECT (make_date(1, 1, 1))::text
----
0001-01-01

query T
SELECT (make_date(-44, 3, 15))::text
----
0044-03-15 BC

query T
SELECT (make_timestamp(2024, 3, 4, 5, 6, 7.5))::text
----
