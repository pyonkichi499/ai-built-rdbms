# extract・date_part・date_trunc・age・make_*・to_timestamp・isfinite・generate_series
# 接頭辞: types_datetime_funcs_

statement ok
DROP TABLE IF EXISTS types_datetime_funcs_t

statement ok
SET TIME ZONE 'UTC'

statement ok
SET DateStyle = 'ISO, MDY'

statement ok
SET IntervalStyle = 'postgres'

