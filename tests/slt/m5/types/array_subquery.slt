# 相関

query T
SELECT id || ':' || ARRAY(SELECT b.id FROM types_array_subquery_t b WHERE b.g = a.g ORDER BY b.id)::text FROM types_array_subquery_t a ORDER BY id
----
1:{1,2}
2:{1,2}
3:{3,4}
4:{3,4}
5:{5}


query T
SELECT id || ':' || ARRAY(SELECT b.id FROM types_array_subquery_t b WHERE b.g = a.g AND b.id <> a.id ORDER BY b.id)::text FROM types_array_subquery_t a ORDER BY id
----
1:{2}
2:{1}
3:{4}
4:{3}
5:{}


query T
SELECT id::text FROM types_array_subquery_t a WHERE id = ANY(ARRAY(SELECT b.id FROM types_array_subquery_t b WHERE b.g = 2)) ORDER BY id
----
3
4


query T
SELECT id::text FROM types_array_subquery_t a WHERE cardinality(ARRAY(SELECT b.id FROM types_array_subquery_t b WHERE b.g = a.g)) > 1 ORDER BY id
----
1
2
3
4


query T
SELECT g || ':' || ARRAY(SELECT b.name FROM types_array_subquery_t b WHERE b.g = s.g AND b.name IS NOT NULL ORDER BY b.id)::text FROM (SELECT DISTINCT g FROM types_array_subquery_t) s ORDER BY g
----
1:{a,b}
2:{c}
3:{"a b"}


query T
SELECT x::text || ARRAY(SELECT y FROM generate_series(1, x) y)::text FROM generate_series(0, 3) x ORDER BY x
----
