# interval の演算・比較・集約・インデックス
# 接頭辞: types_interval_ops_

statement ok
DROP TABLE IF EXISTS types_interval_ops_t

statement ok
DROP TABLE IF EXISTS types_interval_ops_u

statement ok
SET TIME ZONE 'UTC'

statement ok
SET DateStyle = 'ISO, MDY'

statement ok
SET IntervalStyle = 'postgres'

# 加減乗除

query T
SELECT (interval '1 day' + interval '2 hours')::text
----
1 day 02:00:00

query T
SELECT (interval '1 mon' - interval '1 day')::text
----
1 mon -1 days

query T
SELECT (interval '1 day' * 2)::text
----
2 days

query T
SELECT (2 * interval '1 day 3 hours')::text
----
2 days 06:00:00

query T
SELECT (interval '1 month' * 1.5)::text
----
1 mon 15 days

query T
SELECT (interval '1 day' * 0.5)::text
----
12:00:00

query T
SELECT (interval '10 days' / 4)::text
----
2 days 12:00:00

query T
SELECT (interval '1 month' / 2)::text
----
15 days

query T
SELECT (interval '1 hour' / 3)::text
----
00:20:00

query T
SELECT (-interval '1 day 2 hours')::text
----
-1 days -02:00:00

query T
SELECT (-interval '1 mon')::text
----
-1 mons

statement error (42883)
SELECT +interval '1 day'


query T
SELECT (interval '1 day' * 0)::text
----
00:00:00

# timestamp の差

query T
SELECT (timestamp '2024-03-01' - timestamp '2024-02-01')::text
----
29 days

query T
SELECT (timestamp '2024-02-01 12:00' - timestamp '2024-03-01')::text
----
-28 days -12:00:00

query T
SELECT (timestamp '2000-01-01' - timestamp '2024-01-02 03:04:05')::text
----
-8767 days -03:04:05

query T
SELECT (timestamptz '2024-03-10 12:00+00' - timestamptz '2024-03-09 00:00+00')::text
----
1 day 12:00:00

query T
SELECT (date '2024-03-01' - date '2024-02-01')::text
----
29

query T
SELECT (age(timestamp '2024-03-15', timestamp '2023-01-10'))::text
----
1 year 2 mons 5 days

# timestamp ± interval

query T
SELECT (timestamp '2024-01-31' + interval '1 month')::text
----
2024-02-29 00:00:00

query T
SELECT (timestamp '2023-01-31' + interval '1 month')::text
----
2023-02-28 00:00:00

query T
SELECT (timestamp '2024-02-29' + interval '1 year')::text
----
2025-02-28 00:00:00

query T
SELECT (timestamp '2024-02-29' - interval '1 year')::text
----
2023-02-28 00:00:00

query T
SELECT (timestamp '2024-03-31' - interval '1 month')::text
----
2024-02-29 00:00:00

query T
SELECT (timestamp '2024-01-01 00:00' + interval '1 day 36 hours')::text
----
2024-01-03 12:00:00

query T
SELECT (timestamp '2024-01-01' + interval '1 month 1 day')::text
----
2024-02-02 00:00:00

query T
SELECT (interval '1 month' + timestamp '2024-01-31')::text
----
2024-02-29 00:00:00

query T
SELECT (timestamp '2024-01-01' - interval '-1 day')::text
----
2024-01-02 00:00:00

# date ± interval

query T
SELECT (date '2024-01-31' + interval '1 month')::text
----
2024-02-29 00:00:00

query T
SELECT (date '2024-01-31' + interval '1 day 12 hours')::text
----
2024-02-01 12:00:00

query T
SELECT (date '2024-03-01' - interval '1 day')::text
----
2024-02-29 00:00:00

query T
SELECT (interval '2 days' + date '2024-02-28')::text
----
2024-03-01 00:00:00

query T
SELECT (pg_typeof(date '2024-01-01' + interval '1 day'))::text
----
timestamp without time zone

# timestamptz ± interval

query T
SELECT (timestamptz '2024-01-31 10:00+00' + interval '1 month')::text
----
2024-02-29 10:00:00+00

query T
SELECT (timestamptz '2024-01-31 10:00+00' - interval '2 hours')::text
----
2024-01-31 08:00:00+00

# 比較

query T
SELECT (interval '1 mon' = interval '30 days')::text
----
true

query T
SELECT (interval '1 mon' = interval '720 hours')::text
----
true

query T
SELECT (interval '1 day' = interval '24 hours')::text
----
true

query T
SELECT (interval '1 day' < interval '25 hours')::text
----
true

query T
SELECT (interval '1 mon' > interval '29 days')::text
----
true

query T
SELECT (interval '1 year' = interval '12 mons')::text
----
true

query T
SELECT (interval '2 mon' <> interval '60 days')::text
----
false

query T
SELECT (interval '1 day' <= interval '24 hours')::text
----
true

query T
SELECT (interval '-1 day' < interval '0')::text
----
true

# justify

query T
SELECT (justify_hours(interval '50 hours'))::text
----
2 days 02:00:00

query T
SELECT (justify_hours(interval '-50 hours'))::text
----
-2 days -02:00:00

query T
SELECT (justify_days(interval '45 days'))::text
----
1 mon 15 days

query T
SELECT (justify_days(interval '-45 days'))::text
----
-1 mons -15 days

query T
SELECT (justify_interval(interval '1 mon -1 hour'))::text
----
29 days 23:00:00

query T
SELECT (justify_interval(interval '45 days 50 hours'))::text
----
1 mon 17 days 02:00:00

query T
SELECT (justify_interval(interval '1 mon -2 days'))::text
----
28 days

# テーブルと並べ替え・集約

statement ok
CREATE TABLE types_interval_ops_t (id int, v interval)

statement ok
INSERT INTO types_interval_ops_t VALUES (1, '1 mon'), (2, '30 days'), (3, '1 day'), (4, '24 hours'), (5, '-1 day'), (6, '2 hours'), (7, NULL), (8, '1 year')

query IT
SELECT id, v::text FROM types_interval_ops_t ORDER BY v, id
----
5	-1 days
6	02:00:00
3	1 day
1	1 mon
8	1 year
4	24:00:00
2	30 days
7	NULL

query IT
SELECT id, v::text FROM types_interval_ops_t ORDER BY v DESC NULLS LAST, id
----
2	30 days
4	24:00:00
8	1 year
1	1 mon
3	1 day
6	02:00:00
5	-1 days
7	NULL

query T
SELECT v::text FROM types_interval_ops_t GROUP BY v ORDER BY v
----
-1 days
02:00:00
1 day
1 mon
1 year
NULL

query T
SELECT DISTINCT v::text FROM types_interval_ops_t WHERE v IS NOT NULL ORDER BY 1
----
-1 days
02:00:00
1 day
1 mon
1 year
24:00:00
30 days

query I
SELECT count(DISTINCT v) FROM types_interval_ops_t
----
5

query T
SELECT sum(v)::text FROM types_interval_ops_t
----
1 year 1 mon 30 days 26:00:00

query T
SELECT avg(v)::text FROM types_interval_ops_t
----
1 mon 30 days 03:42:51.453257

query T
SELECT min(v)::text FROM types_interval_ops_t
----
-1 days

query T
SELECT max(v)::text FROM types_interval_ops_t
----
1 year

query T
SELECT sum(v)::text, avg(v)::text, min(v)::text, max(v)::text FROM types_interval_ops_t WHERE id IN (1, 3, 6)
----
1 mon 1 day 02:00:00	10 days 08:40:00	02:00:00	1 mon

query T
SELECT (sum(v) FILTER (WHERE id > 100))::text FROM types_interval_ops_t
----
NULL

query IT
SELECT id, (v - interval '1 hour')::text FROM types_interval_ops_t WHERE v < interval '1 day' ORDER BY id
----
5	-1 days -01:00:00
6	01:00:00

# 主キー・UNIQUE・インデックス

statement ok
CREATE TABLE types_interval_ops_u (k interval PRIMARY KEY, n int)

statement ok
INSERT INTO types_interval_ops_u VALUES ('1 day', 1), ('2 days', 2), ('1 mon', 3), ('-1 hour', 4)

statement error (23505)
INSERT INTO types_interval_ops_u VALUES ('24 hours', 5)


statement error (23505)
INSERT INTO types_interval_ops_u VALUES ('30 days', 6)


statement ok
INSERT INTO types_interval_ops_u VALUES ('1 mon 1 day', 7)

query IT
SELECT n, k::text FROM types_interval_ops_u ORDER BY k
----
4	-01:00:00
1	1 day
3	1 mon
7	1 mon 1 day
2	2 days

query IT
SELECT n, k::text FROM types_interval_ops_u WHERE k = interval '720 hours'
----
3	1 mon

query IT
SELECT n, k::text FROM types_interval_ops_u WHERE k >= interval '1 day' AND k < interval '1 mon' ORDER BY k
----
1	1 day
2	2 days

statement ok
DROP INDEX IF EXISTS types_interval_ops_u_n

statement ok
CREATE INDEX types_interval_ops_u_n ON types_interval_ops_u (n)

statement ok
DROP INDEX types_interval_ops_u_n

statement ok
RESET IntervalStyle

statement ok
RESET DateStyle

statement ok
RESET TIME ZONE

statement ok
DROP TABLE types_interval_ops_t

statement ok
DROP TABLE types_interval_ops_u
