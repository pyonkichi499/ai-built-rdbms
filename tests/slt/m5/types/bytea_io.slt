query T
SELECT ('\x0102030405060708090a0b0c0d0e0f1011121314'::bytea)::text
----
\x0102030405060708090a0b0c0d0e0f1011121314

# 先頭が \x でない場合は escape 形式

query T
SELECT ('abc'::bytea)::text
----
\x616263

query T
SELECT (''::bytea)::text
----
\x

query T
SELECT ('a b'::bytea)::text
----
\x612062

query T
SELECT ('é'::bytea)::text
----
\xc3a9

query T
SELECT ('日本'::bytea)::text
----
\xe697a5e69cac

# escape 入力

query T
SELECT (E'\\000'::bytea)::text
----
