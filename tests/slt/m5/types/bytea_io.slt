statement ok
SET TIME ZONE 'UTC'

statement ok
SET DateStyle = 'ISO, MDY'

statement ok
SET bytea_output = 'hex'

# bytea の入力形式と出力形式（hex / escape）

# 接頭辞: bytea_io_（テーブルは作らない）

# hex 入力

query T
SELECT ('\x'::bytea)::text
----
\x

query T
SELECT ('\x00'::bytea)::text
----
\x00

query T
SELECT ('\xDEADBEEF'::bytea)::text
----
\xdeadbeef

query T
SELECT ('\xdeadbeef'::bytea)::text
----
\xdeadbeef

query T
SELECT ('\xDeAdBeEf'::bytea)::text
----
\xdeadbeef

query T
SELECT ('\x de ad be ef'::bytea)::text
----
\xdeadbeef

query T
SELECT ('\xde  ad'::bytea)::text
----
\xdead

query T
SELECT (E'\\x01\t02\n03'::bytea)::text
----
\x010203

