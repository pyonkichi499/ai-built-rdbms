statement ok
SET bytea_output = 'hex'

query T
SELECT (convert_to('é', 'UTF8'))::text
----
\xc3a9

# 全 256 バイトの出力（hex / escape）

query T
SELECT ((SELECT md5(string_agg(chr(i), '' ORDER BY i)) FROM generate_series(1, 255) i))::text
----
0ce171571eda170f6edc1d4f9d6457e4

query T
SELECT ((SELECT string_agg(to_hex(get_byte(b, i)), ',' ORDER BY i) FROM (SELECT '\x00ff7f80'::bytea AS b) s, generate_series(0, 3) i))::text
----
0,ff,7f,80

query T
SELECT ((SELECT length(string_agg(set_byte('\x00'::bytea, 0, i)::text, '' ORDER BY i)) FROM generate_series(0, 255) i))::text
----
1024

statement ok
SET bytea_output = 'escape'

query T
SELECT ((SELECT md5(string_agg(set_byte('\x00'::bytea, 0, i)::text, '' ORDER BY i)) FROM generate_series(0, 255) i))::text
----
226436bdff571e4eea53cc65ad94d943

query T
SELECT ((SELECT length(string_agg(set_byte('\x00'::bytea, 0, i)::text, '' ORDER BY i)) FROM generate_series(0, 255) i))::text
----
740

statement ok
SET bytea_output = 'hex'

query T
SELECT ((SELECT md5(string_agg(set_byte('\x00'::bytea, 0, i)::text, '' ORDER BY i)) FROM generate_series(0, 255) i))::text
----
54e837db4dc1bda3afa186eebe1e8a2c

# escape で出力して escape で読み戻すと元に戻る

statement ok
SET bytea_output = 'escape'

query T
SELECT ((SELECT bool_and(((set_byte('\x00'::bytea, 0, i)::text)::bytea) = set_byte('\x00'::bytea, 0, i)) FROM generate_series(0, 255) i))::text
----
true

statement ok
SET bytea_output = 'hex'

# hex で出力して hex で読み戻すと元に戻る

query T
SELECT ((SELECT bool_and(((set_byte('\x00'::bytea, 0, i)::text)::bytea) = set_byte('\x00'::bytea, 0, i)) FROM generate_series(0, 255) i))::text
----
true

# bytea_output

statement error (22023)
SET bytea_output = 'base64'

query T
SELECT (current_setting('bytea_output'))::text
----
hex

statement ok
SET bytea_output = 'escape'

query T
SELECT (current_setting('bytea_output'))::text
----
escape

statement ok
SET bytea_output = 'hex'

# 型

query T
SELECT (pg_typeof('\x00'::bytea))::text
----
bytea

query T
SELECT (pg_typeof('\x00'::bytea || '\x01'::bytea))::text
----
bytea

# bytea[] の入出力

query T
SELECT ('{}'::bytea[])::text
----
{}

query T
SELECT ('{"\\x00","\\xff"}'::bytea[])::text
----
{"\\x00","\\xff"}

query T
SELECT ('{"\\\\x00","\\\\xff"}'::bytea[])::text
----
{"\\x5c783030","\\x5c786666"}

query T
SELECT (ARRAY['\x00'::bytea, '\xdeadbeef'::bytea, NULL])::text
----
{"\\x00","\\xdeadbeef",NULL}

query T
SELECT (ARRAY['\x00'::bytea, '\xdeadbeef'::bytea]::text)::text
----
{"\\x00","\\xdeadbeef"}

query T
SELECT (ARRAY['\x61'::bytea])::text
----
{"\\x61"}

statement ok
SET bytea_output = 'escape'

query T
SELECT (ARRAY['\x615c62'::bytea, '\x20'::bytea, '\x'::bytea])::text
----
{"a\\\\b"," ",""}

query T
SELECT (ARRAY['a"b'::bytea])::text
----
{"a\"b"}

statement ok
SET bytea_output = 'hex'

query T
SELECT ((ARRAY['\x01'::bytea, '\x02'::bytea])[2])::text
----
\x02

query T
SELECT (array_length(ARRAY['\x01'::bytea, '\x02'::bytea], 1))::text
----
2

# キャスト

query T
SELECT ('\x31'::bytea::text)::text
----
\x31

query T
SELECT ('abc'::text::bytea)::text
----
\x616263

query T
SELECT ('\x4142'::bytea::text)::text
----
\x4142

