# 配列の入出力（要素型ごと・引用符・NULL・下限・不正入力）

# 接頭辞: array_io_（テーブルは作らない。KD-14）

# 基本

query T
SELECT ('{1,2,3}'::int[])::text
----
{1,2,3}

query T
SELECT ('{}'::int[])::text
----
{}

query T
SELECT ('{ }'::int[])::text
----
{}

query T
SELECT (' { 1 , 2 , 3 } '::int[])::text
----
{1,2,3}

query T
SELECT ('{1,NULL,3}'::int[])::text
----
{1,NULL,3}

query T
SELECT ('{NULL}'::int[])::text
----
{NULL}

query T
