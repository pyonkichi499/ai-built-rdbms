# 出力の引用符

query T
SELECT (ARRAY['a b', 'c'])::text
----
{"a b",c}

query T
SELECT (ARRAY['', 'a'])::text
----
{"",a}

query T
SELECT (ARRAY['NULL', 'null', 'Null'])::text
----
{"NULL","null","Null"}

query T
SELECT (ARRAY['a,b', 'c{d', 'e}f', 'g"h', 'i\j'])::text
----
{"a,b","c{d","e}f","g\"h","i\\j"}

query T
SELECT (ARRAY[' a', 'a ', ' '])::text
----
{" a","a "," "}

query T
SELECT (ARRAY['a'::text, NULL])::text
----
{a,NULL}

query T
SELECT (ARRAY[NULL::text])::text
----
{NULL}

query T
