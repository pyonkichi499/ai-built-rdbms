# 往復

query T
SELECT (('{"a b","c,d","","NULL",x}'::text[])::text)::text
----
{"a b","c,d","","NULL",x}

query T
SELECT ((('{"a b","c,d","","NULL",x}'::text[])::text)::text[] = '{"a b","c,d","","NULL",x}'::text[])::text
----
true

query T
SELECT ((ARRAY['a\"b', 'c\\d', NULL, 'NULL', '', ' ', '{', '}', ',']::text)::text[] = ARRAY['a\"b', 'c\\d', NULL, 'NULL', '', ' ', '{', '}', ','])::text
----
true

