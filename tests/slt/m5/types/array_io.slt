----
{NULL,NULL}

query T
SELECT ('{"1","2"}'::int[])::text
----
{1,2}

query T
SELECT ('{ "1" , 2 }'::int[])::text
----
{1,2}

query T
SELECT ('{-1,+2}'::int[])::text
----
