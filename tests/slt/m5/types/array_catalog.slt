statement ok
SET TIME ZONE 'UTC'

statement ok
SET DateStyle = 'ISO, MDY'

statement ok
SET bytea_output = 'hex'

# カタログの配列列（conkey / confkey / indkey / typarray / typelem）

# 接頭辞: types_array_catalog_

statement ok
DROP TABLE IF EXISTS types_array_catalog_c

statement ok
DROP TABLE IF EXISTS types_array_catalog_p

statement ok
DROP TABLE IF EXISTS types_array_catalog_bad

statement ok
CREATE TABLE types_array_catalog_p (a int, b int, c int, PRIMARY KEY (a, b), UNIQUE (c))

statement ok
CREATE TABLE types_array_catalog_c (x int PRIMARY KEY, pa int, pb int, y int, UNIQUE (y, x), FOREIGN KEY (pa, pb) REFERENCES types_array_catalog_p (a, b))

statement ok
CREATE INDEX types_array_catalog_c_idx ON types_array_catalog_c (pb, pa, x)

# conkey / confkey

query T
SELECT contype::text || ':' || conkey::text || ':' || coalesce(confkey::text, 'NULL') FROM pg_constraint WHERE conrelid = 'types_array_catalog_p'::regclass ORDER BY contype
----
p:{1,2}:NULL
u:{3}:NULL


query T
SELECT contype::text || ':' || conkey::text || ':' || coalesce(confkey::text, 'NULL') FROM pg_constraint WHERE conrelid = 'types_array_catalog_c'::regclass ORDER BY contype
----
f:{2,3}:{1,2}
p:{1}:NULL
u:{4,1}:NULL


query T
SELECT contype::text || ':' || conkey[1] || ':' || array_length(conkey, 1) || ':' || cardinality(conkey) FROM pg_constraint WHERE conrelid = 'types_array_catalog_p'::regclass ORDER BY contype
----
p:1:2:2
u:3:1:1


query T
SELECT contype::text || ':' || confkey[1] || ':' || confkey[2] || ':' || array_length(confkey, 1) FROM pg_constraint WHERE conrelid = 'types_array_catalog_c'::regclass AND contype = 'f'
----
f:1:2:2


query T
SELECT contype::text || ':' || array_to_string(conkey, ',') FROM pg_constraint WHERE conrelid IN ('types_array_catalog_p'::regclass, 'types_array_catalog_c'::regclass) ORDER BY conrelid::regclass::text, contype
----
f:2,3
p:1
u:4,1
p:1,2
u:3


query T
SELECT array_to_string(confkey, ',') FROM pg_constraint WHERE conrelid = 'types_array_catalog_c'::regclass AND contype = 'f'
----
1,2


query T
SELECT pg_typeof(conkey)::text || ':' || pg_typeof(confkey)::text FROM pg_constraint WHERE conrelid = 'types_array_catalog_c'::regclass AND contype = 'f'
----
smallint[]:smallint[]


query T
SELECT (conkey = ARRAY[2,3]::int2[])::text FROM pg_constraint WHERE conrelid = 'types_array_catalog_c'::regclass AND contype = 'f'
----
true


query T
SELECT (confkey = '{1,2}'::int2[])::text FROM pg_constraint WHERE conrelid = 'types_array_catalog_c'::regclass AND contype = 'f'
----
true


query T
SELECT 'found' FROM pg_constraint WHERE conrelid = 'types_array_catalog_c'::regclass AND 2 = ANY(conkey) AND contype = 'f'
----
found


query T
SELECT array_ndims(conkey)::text || ':' || array_dims(conkey) FROM pg_constraint WHERE conrelid = 'types_array_catalog_c'::regclass AND contype = 'f'
----
1:[1:2]


# pg_index.indkey（int2vector）

query T
SELECT c.relname || ':' || i.indkey::text || ':' || i.indkey[0] || ':' || coalesce(i.indkey[1]::text, 'NULL') FROM pg_index i JOIN pg_class c ON c.oid = i.indexrelid WHERE i.indrelid = 'types_array_catalog_c'::regclass ORDER BY c.relname
----
types_array_catalog_c_idx:3 2 1:3:2
types_array_catalog_c_pkey:1:1:NULL
types_array_catalog_c_y_x_key:4 1:4:1


query T
SELECT c.relname || ':' || array_upper(i.indkey::int2[], 1) || ':' || array_lower(i.indkey::int2[], 1) FROM pg_index i JOIN pg_class c ON c.oid = i.indexrelid WHERE i.indrelid = 'types_array_catalog_c'::regclass ORDER BY c.relname
----
types_array_catalog_c_idx:2:0
types_array_catalog_c_pkey:0:0
types_array_catalog_c_y_x_key:1:0


query T
SELECT c.relname || ':' || array_to_string(i.indkey::int2[], ',') FROM pg_index i JOIN pg_class c ON c.oid = i.indexrelid WHERE i.indrelid = 'types_array_catalog_p'::regclass ORDER BY c.relname
----
types_array_catalog_p_c_key:3
types_array_catalog_p_pkey:1,2


query T
SELECT c.relname || ':' || i.indnatts || ':' || i.indnkeyatts || ':' || array_length(i.indkey::int2[], 1) FROM pg_index i JOIN pg_class c ON c.oid = i.indexrelid WHERE i.indrelid = 'types_array_catalog_c'::regclass ORDER BY c.relname
----
types_array_catalog_c_idx:3:3:3
types_array_catalog_c_pkey:1:1:1
types_array_catalog_c_y_x_key:2:2:2


query T
SELECT pg_typeof(indkey)::text FROM pg_index WHERE indrelid = 'types_array_catalog_p'::regclass LIMIT 1
----
int2vector


query T
SELECT pg_typeof(indkey::int2[])::text FROM pg_index WHERE indrelid = 'types_array_catalog_p'::regclass LIMIT 1
----
smallint[]


query T
SELECT c.relname || ':' || (i.indkey::int2[])::text FROM pg_index i JOIN pg_class c ON c.oid = i.indexrelid WHERE i.indrelid = 'types_array_catalog_c'::regclass ORDER BY c.relname
----
types_array_catalog_c_idx:[0:2]={3,2,1}
types_array_catalog_c_pkey:[0:0]={1}
types_array_catalog_c_y_x_key:[0:1]={4,1}


query T
SELECT c.relname || ':' || array_dims(i.indkey) FROM pg_index i JOIN pg_class c ON c.oid = i.indexrelid WHERE i.indrelid = 'types_array_catalog_p'::regclass ORDER BY c.relname
----
types_array_catalog_p_c_key:[0:0]
types_array_catalog_p_pkey:[0:1]


query T
SELECT c.relname FROM pg_index i JOIN pg_class c ON c.oid = i.indexrelid WHERE i.indrelid = 'types_array_catalog_c'::regclass AND i.indkey[0] = 4 ORDER BY c.relname
----
types_array_catalog_c_y_x_key


# pg_type: typarray と typelem の整合

query T
SELECT count(*)::text FROM pg_type t WHERE t.typarray <> 0 AND NOT EXISTS (SELECT 1 FROM pg_type a WHERE a.oid = t.typarray AND a.typelem = t.oid)
----
0


query T
SELECT count(*)::text FROM pg_type a WHERE a.typcategory = 'A' AND NOT EXISTS (SELECT 1 FROM pg_type t WHERE t.oid = a.typelem AND t.typarray = a.oid)
----
2


query T
SELECT t.typname || '>' || a.typname FROM pg_type t JOIN pg_type a ON a.oid = t.typarray WHERE t.typname IN ('bool','bytea','char','name','int8','int2','int4','text','oid','float4','float8','varchar','bpchar','numeric','uuid','date','timestamp','timestamptz','interval','time') ORDER BY t.typname
----
bool>_bool
bpchar>_bpchar
bytea>_bytea
char>_char
date>_date
float4>_float4
float8>_float8
int2>_int2
int4>_int4
int8>_int8
interval>_interval
name>_name
numeric>_numeric
oid>_oid
text>_text
time>_time
timestamp>_timestamp
timestamptz>_timestamptz
uuid>_uuid
varchar>_varchar


query T
SELECT typname || ':' || typlen || ':' || typcategory::text || ':' || typalign::text || ':' || typinput::text || ':' || typreceive::text || ':' || typelem::regtype::text || ':' || typdelim::text FROM pg_type WHERE typname IN ('_int4','_text','_bytea','_uuid','_numeric','_bool','_varchar','_bpchar','_float8','_int8','_int2','_oid','_name','_date','_timestamp') ORDER BY typname
----
_bool:-1:A:i:array_in:array_recv:boolean:,
_bpchar:-1:A:i:array_in:array_recv:character:,
_bytea:-1:A:i:array_in:array_recv:bytea:,
_date:-1:A:i:array_in:array_recv:date:,
_float8:-1:A:d:array_in:array_recv:double precision:,
_int2:-1:A:i:array_in:array_recv:smallint:,
_int4:-1:A:i:array_in:array_recv:integer:,
_int8:-1:A:d:array_in:array_recv:bigint:,
_name:-1:A:i:array_in:array_recv:name:,
_numeric:-1:A:i:array_in:array_recv:numeric:,
_oid:-1:A:i:array_in:array_recv:oid:,
_text:-1:A:i:array_in:array_recv:text:,
_timestamp:-1:A:d:array_in:array_recv:timestamp without time zone:,
_uuid:-1:A:i:array_in:array_recv:uuid:,
_varchar:-1:A:i:array_in:array_recv:character varying:,


query T
SELECT typname || ':' || typoutput::text || ':' || typsend::text || ':' || typstorage::text || ':' || typbyval::text FROM pg_type WHERE typname IN ('_int4','_text','_uuid') ORDER BY typname
----
_int4:array_out:array_send:x:false
_text:array_out:array_send:x:false
_uuid:array_out:array_send:x:false


query T
SELECT typname || ':' || typlen || ':' || typcategory::text || ':' || typelem::regtype::text FROM pg_type WHERE typname IN ('int2vector','oidvector') ORDER BY typname
----
int2vector:-1:A:smallint
oidvector:-1:A:oid


query T
SELECT typname || ':' || typarray::regtype::text FROM pg_type WHERE typname IN ('int2vector','oidvector') ORDER BY typname
----
int2vector:int2vector[]
oidvector:oidvector[]


query T
SELECT (typarray::regtype::text) FROM pg_type WHERE oid = 'int4'::regtype
----
integer[]


query T
SELECT 'int4[]'::regtype::text
----
integer[]


query T
SELECT '_int4'::regtype::text
----
integer[]


query T
SELECT 'text[]'::regtype::oid::text
----
1009


query T
SELECT (SELECT typelem::regtype::text FROM pg_type WHERE oid = 'int4[]'::regtype)
----
integer


query T
SELECT format_type('int4[]'::regtype, NULL)
----
integer[]


query T
SELECT format_type('text[]'::regtype, NULL)
----
text[]


query T
SELECT format_type('varchar[]'::regtype, 7)
----
character varying(3)[]


query T
SELECT format_type('numeric[]'::regtype, 327683)
----
numeric(4,-1)[]


query T
SELECT format_type('bpchar[]'::regtype, 7)
----
character(3)[]


query T
SELECT format_type(1007, NULL)
----
integer[]


query T
SELECT format_type(1009, NULL)
----
text[]


query T
SELECT format_type(2951, NULL)
----
uuid[]


query T
SELECT format_type(1001, NULL)
----
bytea[]


query T
SELECT format_type(1000, NULL)
----
boolean[]


query T
SELECT format_type(1016, NULL)
----
bigint[]


query T
SELECT format_type(1005, NULL)
----
smallint[]


query T
SELECT format_type(1028, NULL)
----
oid[]


query T
SELECT format_type(1015, NULL)
----
character varying[]


query T
SELECT format_type(1014, NULL)
----
character[]


query T
SELECT format_type(1231, NULL)
----
numeric[]


# 列の型（式の結果として配列を返す列は pg_attribute で見える）

query T
SELECT attname || ':' || format_type(atttypid, atttypmod) FROM pg_attribute WHERE attrelid = 'pg_constraint'::regclass AND attname IN ('conkey', 'confkey', 'conpfeqop', 'conffeqop') ORDER BY attname
----
conffeqop:oid[]
confkey:smallint[]
conkey:smallint[]
conpfeqop:oid[]


query T
SELECT attname || ':' || format_type(atttypid, atttypmod) FROM pg_attribute WHERE attrelid = 'pg_index'::regclass AND attname IN ('indkey', 'indcollation', 'indclass', 'indoption') ORDER BY attname
----
indclass:oidvector
indcollation:oidvector
indkey:int2vector
indoption:int2vector


query T
SELECT attname || ':' || format_type(atttypid, atttypmod) FROM pg_attribute WHERE attrelid = 'pg_type'::regclass AND attname IN ('typelem', 'typarray') ORDER BY attname
----
typarray:oid
typelem:oid


