statement ok
SET TIME ZONE 'UTC'

statement ok
SET DateStyle = 'ISO, MDY'

statement ok
SET bytea_output = 'hex'

# bpchar の M4 の bpchar.slt が見ない境界（実機の値）

# 接頭辞: types_bpchar_gap_

statement ok
DROP TABLE IF EXISTS types_bpchar_gap_t

# 関数形式のキャストと bpcharcmp

query T
SELECT (bpchar('ab'::name) || '|')::text
----
ab|

query T
SELECT (name('ab '::bpchar) || '|')::text
----
ab|

query T
SELECT (length(name('ab  '::char(5))::text))::text
----
2

query T
SELECT (text('ab  '::char(5)) || '|')::text
----
ab|

query T
SELECT (length(text('ab  '::char(5))))::text
----
2

query T
SELECT (bpchar('a'::"char") || '|')::text
----
a|

query T
SELECT ("char"('abc'::char(5)))::text
----
a

query T
SELECT ("char"(''::char(3)))::text
----
(empty)

query T
SELECT ("char"('é'::char(3)))::text
----
\303

query T
SELECT (bpcharcmp('a'::char(3), 'a '::char(5)))::text
----
0

query T
SELECT (bpcharcmp('a'::char(3), 'b'::char(3)))::text
----
-1

query T
SELECT (bpcharcmp('b'::char(3), 'a'::char(3)))::text
----
1

query T
SELECT (bpcharcmp('a'::char(3), NULL))::text
----
NULL

query T
SELECT (bpchareq('a'::char(3), 'a  '::char(3)))::text
----
true

query T
SELECT (bpchareq('a'::char(3), 'b'::char(3)))::text
----
false

query T
SELECT (bpcharne('a'::char(3), 'b'::char(3)))::text
----
true

query T
SELECT (bpcharlt('a'::char(3), 'b'::char(3)))::text
----
true

query T
SELECT (bpcharle('a'::char(3), 'a'::char(3)))::text
----
true

query T
SELECT (bpchargt('b'::char(3), 'a'::char(3)))::text
----
true

query T
SELECT (bpcharge('a'::char(3), 'b'::char(3)))::text
----
false

# 代入（INSERT）での 22001 と空白だけの超過の切り捨て

statement ok
CREATE TABLE types_bpchar_gap_t (id int, c char(3), v varchar(3))

statement ok
INSERT INTO types_bpchar_gap_t VALUES (1, 'abc', 'abc')

statement ok
INSERT INTO types_bpchar_gap_t VALUES (2, 'ab   ', 'ab   ')

statement ok
INSERT INTO types_bpchar_gap_t VALUES (3, 'abc      ', 'abc ')

statement ok
INSERT INTO types_bpchar_gap_t VALUES (4, '', '')

statement ok
INSERT INTO types_bpchar_gap_t VALUES (5, '   ', '   ')

statement ok
INSERT INTO types_bpchar_gap_t VALUES (6, 'é', 'é')

statement ok
INSERT INTO types_bpchar_gap_t VALUES (7, 'éé ', 'éé ')

statement ok
INSERT INTO types_bpchar_gap_t VALUES (8, NULL, NULL)

statement error (22001)
INSERT INTO types_bpchar_gap_t VALUES (9, 'abcd', 'a')

statement error (22001)
INSERT INTO types_bpchar_gap_t VALUES (9, 'a', 'abcd')

statement error (22001)
INSERT INTO types_bpchar_gap_t VALUES (9, 'abc  d', 'a')

statement error (22001)
INSERT INTO types_bpchar_gap_t VALUES (9, 'éééé', 'a')

statement error (22001)
INSERT INTO types_bpchar_gap_t VALUES (9, 'a', 'ab  c')

statement ok
INSERT INTO types_bpchar_gap_t VALUES (10, 'abcd'::char(3), 'abcde'::varchar(3))

statement ok
INSERT INTO types_bpchar_gap_t VALUES (11, 'abcdef'::text::char(3), 'x')

query T
SELECT id || ':' || coalesce(c::text, 'NULL') || '|' || coalesce(length(c)::text, 'NULL') || ':' || coalesce(octet_length(c)::text, 'NULL') FROM types_bpchar_gap_t ORDER BY id
----
1:abc|3:3
2:ab|2:3
3:abc|3:3
4:|0:3
5:|0:3
6:é|1:4
7:éé|2:5
8:NULL|NULL:NULL
10:abc|3:3
11:abc|3:3


query T
SELECT id || ':' || coalesce(v, 'NULL') || '|' FROM types_bpchar_gap_t ORDER BY id
----
1:abc|
2:ab |
3:abc|
4:|
5:   |
6:é|
7:éé |
8:NULL|
10:abc|
11:x|


statement ok
UPDATE types_bpchar_gap_t SET c = 'xy' WHERE id = 1

query T
SELECT c::text || '|' FROM types_bpchar_gap_t WHERE id = 1
----
xy|


statement error (22001)
UPDATE types_bpchar_gap_t SET c = 'wxyz' WHERE id = 1

statement ok
UPDATE types_bpchar_gap_t SET c = 'xy      ' WHERE id = 1

query T
SELECT octet_length(c)::text FROM types_bpchar_gap_t WHERE id = 1
----
3


