# interval のフィールド指定（extract・date_part・date_trunc・make_interval・列の型修飾子）
# 接頭辞: types_interval_fields_

statement ok
DROP TABLE IF EXISTS types_interval_fields_t

statement ok
SET TIME ZONE 'UTC'

statement ok
SET DateStyle = 'ISO, MDY'

statement ok
SET IntervalStyle = 'postgres'

# extract

query T
SELECT (extract(year from interval '2 years 3 months 4 days 05:06:07.5'))::text
----
2

query T
SELECT (extract(month from interval '2 years 15 months'))::text
----
3

query T
SELECT (extract(day from interval '3 days 25 hours'))::text
----
3

query T
SELECT (extract(hour from interval '3 days 25 hours'))::text
----
25

query T
SELECT (extract(minute from interval '01:02:03.5'))::text
----
2

query T
SELECT (extract(second from interval '01:02:03.5'))::text
----
3.500000

query T
SELECT (extract(epoch from interval '1 day 01:00:00'))::text
----
90000.000000

query T
SELECT (extract(epoch from interval '1 mon'))::text
----
2592000.000000

query T
SELECT (extract(epoch from interval '1 year'))::text
----
31557600.000000

query T
SELECT (extract(quarter from interval '7 months'))::text
----
3

query T
SELECT (extract(decade from interval '25 years'))::text
----
2

query T
SELECT (extract(century from interval '250 years'))::text
----
2

query T
SELECT (extract(millennium from interval '2500 years'))::text
----
2

query T
SELECT (extract(milliseconds from interval '01:02:03.5'))::text
----
3500.000

query T
SELECT (extract(microseconds from interval '01:02:03.5'))::text
----
3500000

query T
SELECT (extract(hour from interval '-01:30:00'))::text
----
-1

query T
SELECT (extract(minute from interval '-01:30:00'))::text
----
-30

query T
SELECT (extract(year from interval '-2 years -3 months'))::text
----
-2

query T
SELECT (date_part('hour', interval '1 day 02:03:04'))::text
----
2

query T
SELECT (date_part('epoch', interval '1 hour'))::text
----
3600

query T
SELECT (pg_typeof(extract(hour from interval '1 hour')))::text
----
numeric

query T
SELECT (pg_typeof(date_part('hour', interval '1 hour')))::text
----
double precision

# date_trunc（interval）

query T
SELECT (date_trunc('hour', interval '1 day 02:03:04.5'))::text
----
1 day 02:00:00

query T
SELECT (date_trunc('minute', interval '1 day 02:03:04.5'))::text
----
1 day 02:03:00

query T
SELECT (date_trunc('second', interval '1 day 02:03:04.567'))::text
----
1 day 02:03:04

query T
SELECT (date_trunc('day', interval '1 day 02:03:04'))::text
----
1 day

query T
SELECT (date_trunc('month', interval '1 year 2 mons 3 days 04:05:06'))::text
----
1 year 2 mons

query T
SELECT (date_trunc('year', interval '1 year 2 mons 3 days 04:05:06'))::text
----
1 year

query T
SELECT (date_trunc('milliseconds', interval '00:00:01.234567'))::text
----
00:00:01.234

query T
SELECT (date_trunc('microseconds', interval '00:00:01.234567'))::text
----
00:00:01.234567

query T
SELECT (date_trunc('decade', interval '25 years 3 mons'))::text
----
20 years

query T
SELECT (date_trunc('quarter', interval '1 year 5 mons'))::text
----
1 year 3 mons

# make_interval

query T
SELECT (make_interval(1, 2, 3, 4, 5, 6, 7.5))::text
----
1 year 2 mons 25 days 05:06:07.5

query T
SELECT (make_interval(years => 1))::text
----
1 year

query T
SELECT (make_interval(mins => 90))::text
----
01:30:00

query T
SELECT (make_interval(days => 10, hours => -3))::text
----
10 days -03:00:00

query T
SELECT (make_interval(secs => 0.25))::text
----
00:00:00.25

query T
SELECT (make_interval())::text
----
00:00:00

# interval 同士の変換と丸め

query T
SELECT ('1 day 12 hours'::interval::text)::text
----
1 day 12:00:00

query T
SELECT (interval '1 day' + interval '1 day' + interval '1 day')::text
----
3 days

# 列の型修飾子

statement ok
CREATE TABLE types_interval_fields_t (a interval, b interval(2), c interval day to second(1), d interval year to month, e interval hour to minute)

statement ok
INSERT INTO types_interval_fields_t VALUES ('1 day 02:03:04.56789', '1 day 02:03:04.56789', '1 day 02:03:04.56789', '1 year 2 months 3 days', '1 day 02:03:04')

query TTTTT
SELECT a::text, b::text, c::text, d::text, e::text FROM types_interval_fields_t
----
1 day 02:03:04.56789	1 day 02:03:04.57	1 day 02:03:04.6	1 year 2 mons	1 day 02:03:00

query TTTTT
SELECT format_type(atttypid, atttypmod), '', '', '', '' FROM pg_attribute WHERE attrelid = 'types_interval_fields_t'::regclass AND attnum > 0 ORDER BY attnum
----
interval	(empty)	(empty)	(empty)	(empty)
interval(2)	(empty)	(empty)	(empty)	(empty)
interval day to second(1)	(empty)	(empty)	(empty)	(empty)
interval year to month	(empty)	(empty)	(empty)	(empty)
interval hour to minute	(empty)	(empty)	(empty)	(empty)

statement ok
RESET IntervalStyle

statement ok
RESET DateStyle

statement ok
RESET TIME ZONE

statement ok
DROP TABLE types_interval_fields_t
