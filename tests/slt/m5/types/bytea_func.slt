# encode / decode

query T
SELECT (encode('\xdeadbeef'::bytea, 'hex'))::text
----
deadbeef

query T
SELECT (encode('\x'::bytea, 'hex'))::text
----
(empty)

query T
SELECT (encode('\xDEADBEEF'::bytea, 'HEX'))::text
----
deadbeef

query T
SELECT (encode('\x00ff'::bytea, 'escape'))::text
