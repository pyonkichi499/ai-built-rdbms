# 集約

query T
SELECT ((SELECT count(DISTINCT b)::text FROM (VALUES ('\x01'::bytea), ('\x01'::bytea), ('\x0100'::bytea), ('\x'::bytea), (NULL)) v(b)))::text
----
3

query T
SELECT b::text FROM (VALUES ('\x02'::bytea), ('\x0100'::bytea), ('\x01'::bytea), ('\x'::bytea), ('\x00'::bytea), ('\xff'::bytea), (NULL)) v(b) ORDER BY b
----
\x
\x00
\x01
\x0100
\x02
\xff
NULL


query T
SELECT b::text FROM (VALUES ('\x02'::bytea), ('\x0100'::bytea), ('\x01'::bytea), ('\x'::bytea), ('\x00'::bytea), ('\xff'::bytea), (NULL)) v(b) ORDER BY b DESC NULLS LAST
----
\xff
\x02
\x0100
\x01
\x00
\x
NULL


