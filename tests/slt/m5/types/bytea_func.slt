SET bytea_output = 'hex'

# bytea の演算子と関数（境界を含む）

# 接頭辞: bytea_func_（テーブルは作らない）

# 比較

query T
SELECT ('\x01'::bytea = '\x01'::bytea)::text
----
true

query T
SELECT ('\x01'::bytea = '\x0100'::bytea)::text
----
false

query T
SELECT ('\x01'::bytea <> '\x02'::bytea)::text
----
true

query T
SELECT ('\x01'::bytea < '\x0100'::bytea)::text
----
true

query T
SELECT ('\x0100'::bytea < '\x02'::bytea)::text
----
true

query T
SELECT ('\x00'::bytea < '\x'::bytea)::text
----
false

query T
SELECT ('\x'::bytea < '\x00'::bytea)::text
----
true

query T
SELECT ('\x7f'::bytea < '\x80'::bytea)::text
----
true

query T
SELECT ('\xff'::bytea > '\x7f'::bytea)::text
----
true

query T
SELECT ('\x01'::bytea <= '\x01'::bytea)::text
----
true

query T
SELECT ('\x01'::bytea >= '\x02'::bytea)::text
----
false

query T
SELECT ('\x0001'::bytea < '\x0002'::bytea)::text
----
true

query T
SELECT ('\x61'::bytea = 'a'::bytea)::text
----
true

query T
SELECT (NULL::bytea = '\x01'::bytea)::text
----
NULL

query T
SELECT (NULL::bytea = NULL::bytea)::text
----
NULL

query T
SELECT ('\x01'::bytea IS NOT DISTINCT FROM NULL::bytea)::text
----
false

# 連結

query T
SELECT ('\x01'::bytea || '\x02'::bytea)::text
----
\x0102

query T
SELECT ('\x'::bytea || '\x02'::bytea)::text
----
\x02

query T
SELECT ('\x01'::bytea || '\x'::bytea)::text
----
\x01

query T
SELECT ('\x01'::bytea || NULL::bytea)::text
----
NULL

query T
SELECT (NULL::bytea || NULL::bytea)::text
----
NULL

query T
SELECT ('\x00'::bytea || '\x00'::bytea)::text
----
\x0000

# length / octet_length / bit_length

query T
SELECT (length('\x'::bytea))::text
----
0

query T
SELECT (length('\x00'::bytea))::text
----
1

query T
SELECT (length('\x00ff00'::bytea))::text
----
3

query T
SELECT (octet_length('\xdeadbeef'::bytea))::text
----
4

query T
SELECT (bit_length('\xdeadbeef'::bytea))::text
----
32

query T
SELECT (length(NULL::bytea))::text
----
NULL

# substring

query T
