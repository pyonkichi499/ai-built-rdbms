statement ok
SET DateStyle = 'ISO, MDY'

statement error (22008)
SELECT date '31/12/2024'


statement error (22008)
SELECT date '2024-13-01'


# 出力は date_trunc 等でも同じ形式

statement ok
SET DateStyle = 'SQL, DMY'

query T
SELECT (date_trunc('day', timestamp '2024-03-04 05:06:07'))::text
----
04/03/2024 00:00:00

query T
SELECT (timestamp '2024-03-04 05:06:07' + interval '1 day')::text
----
05/03/2024 05:06:07

query T
SELECT ((timestamp '2024-03-04 05:06:07')::date)::text
----
04/03/2024

query T
SELECT (make_date(2024, 3, 4))::text
----
04/03/2024

statement ok
SET DateStyle = 'ISO, MDY'

# 無限

statement ok
SET DateStyle = 'SQL, MDY'

query T
SELECT (date 'infinity')::text
----
infinity

query T
SELECT (date '-infinity')::text
----
-infinity

query T
SELECT (timestamp 'infinity')::text
----
infinity

query T
SELECT (timestamptz '-infinity')::text
----
-infinity

statement ok
SET DateStyle = 'ISO, MDY'

# SET LOCAL / ROLLBACK

statement ok
BEGIN

statement ok
SET LOCAL DateStyle = 'German'

query T
SHOW DateStyle
----
German, DMY

query T
SELECT (date '2024-03-04')::text
----
04.03.2024

statement ok
ROLLBACK

query T
SHOW DateStyle
----
ISO, MDY

query T
SELECT (date '2024-03-04')::text
----
2024-03-04

statement ok
BEGIN

statement ok
SET DateStyle = 'SQL, DMY'

statement ok
ROLLBACK

query T
SHOW DateStyle
----
ISO, MDY

statement ok
BEGIN

statement ok
SET DateStyle = 'SQL, DMY'

statement ok
COMMIT

query T
SHOW DateStyle
----
SQL, DMY

statement ok
RESET DateStyle

query T
SHOW DateStyle
----
ISO, MDY

statement ok
SET DateStyle TO 'sql', 'dmy'

query T
SHOW DateStyle
----
SQL, DMY

statement ok
SET DateStyle = DEFAULT

query T
SHOW DateStyle
----
ISO, MDY

statement ok
SET DateStyle TO ISO, MDY

query T
SHOW DateStyle
----
ISO, MDY

# 不正値

statement error (22023)
SET DateStyle = 'bogus'


statement error (22023)
SET DateStyle = 'ISO, bogus'


statement error (22023)
SET DateStyle = 'ISO, MDY, DMY'


query T
SHOW DateStyle
----
ISO, MDY

statement ok
RESET IntervalStyle

statement ok
RESET DateStyle

statement ok
RESET TIME ZONE

statement ok
DROP TABLE types_datestyle_t
