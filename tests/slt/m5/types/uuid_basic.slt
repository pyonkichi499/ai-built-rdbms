query T
SELECT ('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11'::varchar::uuid)::text
----
a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11

query T
SELECT ('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11'::uuid || 'x')::text
----
