# uuid の入力形式・出力・比較・キャスト・gen_random_uuid

# 接頭辞: uuid_basic_（テーブルは作らない）

# 入力の形（5 種）

query T
SELECT ('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11'::uuid)::text
----
a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11

query T
SELECT ('A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11'::uuid)::text
----
a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11

query T
SELECT ('a0eebc999c0b4ef8bb6d6bb9bd380a11'::uuid)::text
----
a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11

query T
SELECT ('{a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11}'::uuid)::text
----
a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11

query T
SELECT ('a0eebc99-9c0b4ef8-bb6d6bb9-bd380a11'::uuid)::text
----
a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11

query T
SELECT ('a0ee-bc99-9c0b-4ef8-bb6d-6bb9-bd38-0a11'::uuid)::text
----
a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11

query T
SELECT ('{a0eebc999c0b4ef8bb6d6bb9bd380a11}'::uuid)::text
----
a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11

query T
SELECT ('00000000-0000-0000-0000-000000000000'::uuid)::text
----
00000000-0000-0000-0000-000000000000

query T
SELECT ('ffffffff-ffff-ffff-ffff-ffffffffffff'::uuid)::text
----
ffffffff-ffff-ffff-ffff-ffffffffffff

query T
SELECT ('FFFFFFFF-FFFF-FFFF-FFFF-FFFFFFFFFFFF'::uuid)::text
----
ffffffff-ffff-ffff-ffff-ffffffffffff

query T
SELECT ('a0ee-bc999c0b-4ef8bb6d6bb9bd380a11'::uuid)::text
----
a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11

query T
SELECT (uuid 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11')::text
----
a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11

query T
SELECT (CAST('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11' AS uuid))::text
----
a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11

