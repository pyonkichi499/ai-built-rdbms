# 出力は小文字・ハイフン形式

query T
SELECT ('A0EEBC999C0B4EF8BB6D6BB9BD380A11'::uuid::text)::text
----
a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11

query T
SELECT ('{A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11}'::uuid::text)::text
----
a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11

query T
SELECT (length('A0EEBC999C0B4EF8BB6D6BB9BD380A11'::uuid::text))::text
----
36

query T
SELECT (pg_typeof('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11'::uuid))::text
----
uuid

# 比較

query T
SELECT ('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11'::uuid = 'A0EEBC999C0B4EF8BB6D6BB9BD380A11'::uuid)::text
----
true

query T
SELECT ('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11'::uuid <> 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a12'::uuid)::text
----
true

query T
SELECT ('00000000-0000-0000-0000-000000000001'::uuid > '00000000-0000-0000-0000-000000000000'::uuid)::text
----
true

query T
SELECT ('00000000-0000-0000-0000-000000000001'::uuid < '00000000-0000-0000-0000-000000000000'::uuid)::text
----
false

query T
SELECT ('10000000-0000-0000-0000-000000000000'::uuid > '0fffffff-ffff-ffff-ffff-ffffffffffff'::uuid)::text
----
true

query T
SELECT ('7fffffff-ffff-ffff-ffff-ffffffffffff'::uuid < '80000000-0000-0000-0000-000000000000'::uuid)::text
----
true

query T
SELECT ('ffffffff-ffff-ffff-ffff-ffffffffffff'::uuid > '80000000-0000-0000-0000-000000000000'::uuid)::text
----
true

query T
SELECT ('00000000-0000-0000-0000-000000000000'::uuid <= '00000000-0000-0000-0000-000000000000'::uuid)::text
----
true

query T
SELECT ('00000000-0000-0000-0000-000000000000'::uuid >= '00000000-0000-0000-0000-000000000001'::uuid)::text
----
false

query T
SELECT ('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11'::uuid = NULL::uuid)::text
----
NULL

query T
SELECT (NULL::uuid IS NULL)::text
----
true

query T
SELECT ('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11'::uuid IS DISTINCT FROM NULL::uuid)::text
----
true

query T
SELECT ('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11'::uuid IN ('00000000-0000-0000-0000-000000000000', 'a0eebc999c0b4ef8bb6d6bb9bd380a11'))::text
----
true

# unknown との比較

query T
SELECT ('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11'::uuid = 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11')::text
----
true

