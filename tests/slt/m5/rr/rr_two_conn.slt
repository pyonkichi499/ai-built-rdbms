# RR の 2 接続（相手がコミット済みの状態で確かめる。待たない）

statement ok
DROP TABLE IF EXISTS rr_rr_two_conn_t

statement ok
CREATE TABLE rr_rr_two_conn_t (id int PRIMARY KEY, v int)

statement ok
INSERT INTO rr_rr_two_conn_t VALUES (1, 10), (2, 20), (3, 30)

# --- スナップショットは最初の問い合わせで決まる ---
connection a
statement ok
BEGIN ISOLATION LEVEL REPEATABLE READ

connection a
query I
SELECT count(*) FROM rr_rr_two_conn_t
----
3

connection b
statement ok
INSERT INTO rr_rr_two_conn_t VALUES (4, 40)

connection b
statement ok
UPDATE rr_rr_two_conn_t SET v = 11 WHERE id = 1

connection b
statement ok
DELETE FROM rr_rr_two_conn_t WHERE id = 3

# a には変更が見えない
connection a
query II
SELECT id, v FROM rr_rr_two_conn_t ORDER BY id
----
1 10
2 20
3 30

# b がコミット済みの行の更新は 40001
connection a
statement error (40001)
UPDATE rr_rr_two_conn_t SET v = 12 WHERE id = 1

connection a
statement error (25P02)
SELECT 1

connection a
statement ok
ROLLBACK

