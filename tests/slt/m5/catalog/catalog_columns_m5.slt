# M2 の catalog_columns.slt の回帰（M5 の後も pg_class の列が PostgreSQL 17 と同じ）。
# relfrozenxid / relminmxid の型は xid（OID 28）のまま。64 ビットの境界は別カタログ yz_relxid に持つ（00 D14）

query IITIII
SELECT attrelid, attnum, attname, atttypid, attlen, attcollation FROM pg_attribute WHERE attrelid = 1259 AND attnum > 0 ORDER BY 1, 2
