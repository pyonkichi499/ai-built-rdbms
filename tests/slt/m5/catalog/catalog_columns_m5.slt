query TT
SELECT format_type(atttypid, atttypmod), attnotnull::text FROM pg_attribute WHERE attrelid = 'pg_class'::regclass AND attname = 'relfrozenxid'
----
xid true

query TT
SELECT format_type(atttypid, atttypmod), attnotnull::text FROM pg_attribute WHERE attrelid = 'pg_database'::regclass AND attname = 'datfrozenxid'
----
xid true

statement ok
DROP TABLE IF EXISTS catalog_catalog_columns_m5_t

statement ok
CREATE TABLE catalog_catalog_columns_m5_t (a int)

query TT
SELECT pg_typeof(relfrozenxid)::text, (relfrozenxid::text::bigint >= 0)::text FROM pg_class WHERE oid = 'catalog_catalog_columns_m5_t'::regclass
----
xid true

statement ok
DROP TABLE catalog_catalog_columns_m5_t
