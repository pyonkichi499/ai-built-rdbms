# FOREIGN KEY: NO ACTION（既定。明示も同じ）
# 接頭辞: fk_action_no_action_

statement ok
DROP TABLE IF EXISTS fk_action_no_action_c2

statement ok
DROP TABLE IF EXISTS fk_action_no_action_c

statement ok
DROP TABLE IF EXISTS fk_action_no_action_p

statement ok
CREATE TABLE fk_action_no_action_p (id int PRIMARY KEY)

statement ok
CREATE TABLE fk_action_no_action_c (n int PRIMARY KEY, pid int REFERENCES fk_action_no_action_p)

statement ok
CREATE TABLE fk_action_no_action_c2 (n int PRIMARY KEY, pid int REFERENCES fk_action_no_action_p ON DELETE NO ACTION ON UPDATE NO ACTION)

statement ok
INSERT INTO fk_action_no_action_p VALUES (1), (2), (3)

statement ok
INSERT INTO fk_action_no_action_c VALUES (1, 1)

statement ok
INSERT INTO fk_action_no_action_c2 VALUES (1, 2)

# SQLSTATE は 23503
statement error (23503)
DELETE FROM fk_action_no_action_p WHERE id = 1

statement error (23503)
DELETE FROM fk_action_no_action_p WHERE id = 2

statement error (23503)
UPDATE fk_action_no_action_p SET id = id + 10 WHERE id = 1

statement error (?s)violates foreign key constraint "fk_action_no_action_c2_pid_fkey" on table "fk_action_no_action_c2"
UPDATE fk_action_no_action_p SET id = id + 10 WHERE id = 2

# 同じ文の中で参照が解消されれば通る（文末で検査する）
statement ok
WITH d AS (DELETE FROM fk_action_no_action_c WHERE pid = 1 RETURNING 1) DELETE FROM fk_action_no_action_p WHERE id = 3

query I
SELECT id FROM fk_action_no_action_p ORDER BY id
----
1
2

# pg_constraint の action 列
query TT
SELECT confupdtype, confdeltype FROM pg_constraint WHERE conname IN ('fk_action_no_action_c_pid_fkey', 'fk_action_no_action_c2_pid_fkey') ORDER BY conname
----
a a
a a

