# FOREIGN KEY: ON DELETE SET DEFAULT / ON UPDATE SET DEFAULT
# 接頭辞: fk_action_set_default_

statement ok
DROP TABLE IF EXISTS fk_action_set_default_c

statement ok
DROP TABLE IF EXISTS fk_action_set_default_p

statement ok
CREATE TABLE fk_action_set_default_p (id int PRIMARY KEY)

statement ok
CREATE TABLE fk_action_set_default_c (n int PRIMARY KEY, pid int DEFAULT 0 REFERENCES fk_action_set_default_p ON DELETE SET DEFAULT ON UPDATE SET DEFAULT)

statement ok
INSERT INTO fk_action_set_default_p VALUES (0), (1), (2), (3)

statement ok
INSERT INTO fk_action_set_default_c VALUES (1, 1), (2, 2), (3, 3), (4, NULL)

# DELETE: 既定値（0）になる
statement ok
DELETE FROM fk_action_set_default_p WHERE id = 1

query II
SELECT n, pid FROM fk_action_set_default_c ORDER BY n
----
1 0
2 2
3 3
4 NULL

# UPDATE: キーを変えると既定値になる
statement ok
UPDATE fk_action_set_default_p SET id = 30 WHERE id = 3

query II
SELECT n, pid FROM fk_action_set_default_c ORDER BY n
----
1 0
2 2
3 0
4 NULL

# 既定値の親が存在しない -> 23503（子が 0 を指す違反）
statement ok
DELETE FROM fk_action_set_default_c WHERE pid = 0

statement ok
DELETE FROM fk_action_set_default_p WHERE id = 0

statement error (?s)insert or update on table "fk_action_set_default_c" violates foreign key constraint "fk_action_set_default_c_pid_fkey".*Key \(pid\)=\(0\) is not present in table "fk_action_set_default_p"\.
DELETE FROM fk_action_set_default_p WHERE id = 2

# 失敗した文は何も変えない
query II
SELECT n, pid FROM fk_action_set_default_c ORDER BY n
----
2 2
4 NULL

# 既定値が、消そうとしている親と同じ -> 23503
statement ok
INSERT INTO fk_action_set_default_p VALUES (0)

statement ok
UPDATE fk_action_set_default_c SET pid = 0 WHERE n = 2

# 親 0 を消すと、SET DEFAULT で 0 を指したまま -> 23503
statement error (?s)violates foreign key constraint "fk_action_set_default_c_pid_fkey"
DELETE FROM fk_action_set_default_p WHERE id = 0

statement ok
DROP TABLE fk_action_set_default_c

statement ok
DROP TABLE fk_action_set_default_p
