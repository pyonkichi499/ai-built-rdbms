# FOREIGN KEY: MATCH FULL。全列 NULL か全列非 NULL のみ
# 接頭辞: fk_match_full_

statement ok
DROP TABLE IF EXISTS fk_match_full_c

statement ok
DROP TABLE IF EXISTS fk_match_full_p

statement ok
CREATE TABLE fk_match_full_p (a int, b int, PRIMARY KEY (a, b))

statement ok
