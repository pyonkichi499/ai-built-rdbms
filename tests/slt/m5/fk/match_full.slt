statement error (?s)MATCH FULL does not allow mixing of null and nonnull key values\.
UPDATE fk_match_full_c SET b = NULL WHERE n = 1

# 親に無い組
statement error (?s)Key \(a, b\)=\(1, 2\) is not present in table "fk_match_full_p"\.
INSERT INTO fk_match_full_c VALUES (5, 1, 2)

# 親の削除の違反
statement error (?s)Key \(a, b\)=\(1, 1\) is still referenced from table "fk_match_full_c"\.
DELETE FROM fk_match_full_p WHERE a = 1

