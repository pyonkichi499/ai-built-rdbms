statement ok
CREATE TABLE fk_match_full_c (n int PRIMARY KEY, a int, b int, FOREIGN KEY (a, b) REFERENCES fk_match_full_p MATCH FULL)

# 全 NULL と全一致は通る
statement ok
INSERT INTO fk_match_full_c VALUES (1, 1, 1), (2, NULL, NULL)

# NULL 混在は 23503
statement error (?s)insert or update on table "fk_match_full_c" violates foreign key constraint "fk_match_full_c_a_b_fkey".*MATCH FULL does not allow mixing of null and nonnull key values\.
