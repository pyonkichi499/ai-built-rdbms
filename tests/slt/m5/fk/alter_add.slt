ALTER TABLE fk_alter_add_c ADD CONSTRAINT fk_alter_add_dup FOREIGN KEY (pid) REFERENCES fk_alter_add_p (id), ADD CONSTRAINT fk_alter_add_dup FOREIGN KEY (pid) REFERENCES fk_alter_add_p (id)

