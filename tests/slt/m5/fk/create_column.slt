# FOREIGN KEY: 列制約（REFERENCES）の作成と基本動作
# 接頭辞: fk_create_column_

statement ok
DROP TABLE IF EXISTS fk_create_column_c

statement ok
DROP TABLE IF EXISTS fk_create_column_c2

statement ok
DROP TABLE IF EXISTS fk_create_column_c3

statement ok
DROP TABLE IF EXISTS fk_create_column_p

statement ok
CREATE TABLE fk_create_column_p (id int PRIMARY KEY, v text)

# 列制約。列名を省略すると親の主キーを参照する
statement ok
CREATE TABLE fk_create_column_c (id int PRIMARY KEY, pid int REFERENCES fk_create_column_p)

# 列名を明示
statement ok
CREATE TABLE fk_create_column_c2 (id int PRIMARY KEY, pid int REFERENCES fk_create_column_p (id))

# 他の列制約との組み合わせ
statement ok
CREATE TABLE fk_create_column_c3 (id int PRIMARY KEY, pid int NOT NULL DEFAULT 1 REFERENCES fk_create_column_p (id) CHECK (pid > 0))

statement ok
INSERT INTO fk_create_column_p VALUES (1, 'a'), (2, 'b')

statement ok
INSERT INTO fk_create_column_c VALUES (1, 1), (2, 2), (3, NULL)

statement ok
INSERT INTO fk_create_column_c2 VALUES (1, 2)

statement ok
INSERT INTO fk_create_column_c3 (id) VALUES (1)

query II
SELECT id, pid FROM fk_create_column_c3
----
1 1

statement error (?s)violates foreign key constraint "fk_create_column_c_pid_fkey"
INSERT INTO fk_create_column_c VALUES (4, 99)

statement error (?s)violates foreign key constraint "fk_create_column_c2_pid_fkey"
INSERT INTO fk_create_column_c2 VALUES (2, 99)

# 行は増えていない
query I
SELECT count(*) FROM fk_create_column_c
----
3

# 制約の一覧
query TT
SELECT conname, contype FROM pg_constraint WHERE conrelid = 'fk_create_column_c'::regclass ORDER BY conname
----
fk_create_column_c_pid_fkey f
fk_create_column_c_pkey p

