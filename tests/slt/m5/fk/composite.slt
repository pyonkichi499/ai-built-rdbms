# FOREIGN KEY: 複合キー（列順の入れ替え、一部だけ NULL）
# 接頭辞: fk_composite_

statement ok
DROP TABLE IF EXISTS fk_composite_c

statement ok
DROP TABLE IF EXISTS fk_composite_c2

statement ok
DROP TABLE IF EXISTS fk_composite_p

statement ok
CREATE TABLE fk_composite_p (id int, k text, v int, PRIMARY KEY (id, k))

statement ok
INSERT INTO fk_composite_p VALUES (1, 'a', 10), (1, 'b', 20), (2, 'a', 30)

statement ok
CREATE TABLE fk_composite_c (n int PRIMARY KEY, a int, b text, FOREIGN KEY (a, b) REFERENCES fk_composite_p (id, k))

# 列の順序を入れ替えて参照する: 子 (k, id) -> 親 (k, id)。親の主キーは (id, k)
statement ok
CREATE TABLE fk_composite_c2 (n int PRIMARY KEY, kk text, ii int, FOREIGN KEY (kk, ii) REFERENCES fk_composite_p (k, id))

statement ok
INSERT INTO fk_composite_c VALUES (1, 1, 'a'), (2, 1, 'b'), (3, 2, 'a')

statement ok
INSERT INTO fk_composite_c2 VALUES (1, 'a', 1), (2, 'b', 1), (3, 'a', 2)

# 組が親に無い（各列の値は別々には存在する）
statement error (?s)violates foreign key constraint "fk_composite_c_a_b_fkey".*Key \(a, b\)=\(2, b\) is not present in table "fk_composite_p"\.
INSERT INTO fk_composite_c VALUES (4, 2, 'b')

statement error (?s)violates foreign key constraint "fk_composite_c2_kk_ii_fkey".*Key \(kk, ii\)=\(b, 2\) is not present in table "fk_composite_p"\.
INSERT INTO fk_composite_c2 VALUES (4, 'b', 2)

# MATCH SIMPLE: 一部でも NULL なら検査されない
statement ok
INSERT INTO fk_composite_c VALUES (5, 99, NULL), (6, NULL, 'zzz'), (7, NULL, NULL)

# 親の削除の違反
statement error (?s)update or delete on table "fk_composite_p" violates foreign key constraint "fk_composite_c_a_b_fkey" on table "fk_composite_c".*Key \(id, k\)=\(1, a\) is still referenced from table "fk_composite_c"\.
DELETE FROM fk_composite_p WHERE id = 1 AND k = 'a'

# キーでない列の更新は通る
statement ok
UPDATE fk_composite_p SET v = 11 WHERE id = 1 AND k = 'a'

# 参照されていない親は消せない順序が無い
statement ok
INSERT INTO fk_composite_p VALUES (3, 'z', 0)

statement ok
DELETE FROM fk_composite_p WHERE id = 3

# 列の数が合わない
statement error (?s)number of referencing and referenced columns for foreign key disagree
CREATE TABLE fk_composite_bad (a int, b text, FOREIGN KEY (a) REFERENCES fk_composite_p (id, k))

# 一意制約が無い列の組
statement error (?s)there is no unique constraint matching given keys for referenced table "fk_composite_p"
CREATE TABLE fk_composite_bad (a int, b int, FOREIGN KEY (a, b) REFERENCES fk_composite_p (id, v))

# 一部の列だけ（主キーは (id, k) なので id 単独は一意でない）
statement error (?s)there is no unique constraint matching given keys for referenced table "fk_composite_p"
CREATE TABLE fk_composite_bad (a int, FOREIGN KEY (a) REFERENCES fk_composite_p (id))

statement ok
DROP TABLE fk_composite_c

statement ok
DROP TABLE fk_composite_c2

statement ok
DROP TABLE fk_composite_p
