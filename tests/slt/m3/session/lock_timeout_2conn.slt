# lock_timeout: 書き込みの待ちが 55P03 で中断される

statement ok
CREATE TABLE lt_t (id int, v int)

statement ok
INSERT INTO lt_t VALUES (1, 0), (2, 0)

connection a
statement ok
BEGIN

connection a
statement ok
UPDATE lt_t SET v = 1 WHERE id = 1

connection b
statement ok
SET lock_timeout = '100ms'

connection b
query T
SHOW lock_timeout
----
100ms

connection b
statement error (55P03)
UPDATE lt_t SET v = 2 WHERE id = 1

# b の読み取りは待たない
connection b
query II
SELECT id, v FROM lt_t ORDER BY id
----
1 0
2 0

connection a
statement ok
COMMIT

connection b
statement ok
UPDATE lt_t SET v = 2 WHERE id = 1

connection b
query II
SELECT id, v FROM lt_t ORDER BY id
----
1 2
2 0

# b のブロック内で 55P03 になったら失敗状態
connection a
statement ok
BEGIN

connection a
statement ok
UPDATE lt_t SET v = 3 WHERE id = 1

connection b
statement ok
BEGIN

connection b
statement error (55P03)
UPDATE lt_t SET v = 4 WHERE id = 1

connection b
statement error (25P02)
SELECT 1

connection b
statement ok
ROLLBACK

connection a
statement ok
ROLLBACK

connection b
statement ok
RESET lock_timeout

connection a
query II
SELECT id, v FROM lt_t ORDER BY id
----
1 2
2 0

statement ok
DROP TABLE lt_t
