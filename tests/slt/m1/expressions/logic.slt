# 三値論理と IS 述語

# AND
query ?????????
SELECT true AND true, true AND false, true AND NULL, false AND true, false AND false, false AND NULL, NULL AND true, NULL AND false, NULL AND NULL
----
t f NULL f f f NULL f NULL

# OR
query ?????????
SELECT true OR true, true OR false, true OR NULL, false OR true, false OR false, false OR NULL, NULL OR true, NULL OR false, NULL OR NULL
----
t t t t f NULL t NULL NULL

# NOT
query ???
SELECT NOT true, NOT false, NOT NULL::bool
----
f t NULL

# IS [NOT] NULL
query ????
SELECT NULL IS NULL, 1 IS NULL, NULL IS NOT NULL, 1 IS NOT NULL
----
t f f t

query ??
SELECT '' IS NULL, 'x' IS NOT NULL
----
f t

# IS [NOT] TRUE / FALSE は NULL を返さない
query ???
SELECT true IS TRUE, false IS TRUE, NULL IS TRUE
----
t f f

query ???
SELECT true IS NOT TRUE, false IS NOT TRUE, NULL IS NOT TRUE
----
f t t

query ???
SELECT true IS FALSE, false IS FALSE, NULL IS FALSE
----
f t f

query ???
SELECT true IS NOT FALSE, false IS NOT FALSE, NULL IS NOT FALSE
----
t f t

query ??
SELECT (1 = NULL) IS NULL, (1 = NULL) IS NOT TRUE
----
t t

# IS TRUE の引数は bool でなければならない
