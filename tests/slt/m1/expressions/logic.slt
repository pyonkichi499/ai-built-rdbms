SELECT 1 IS TRUE

# AND/OR の引数は bool でなければならない
statement error (42804)
SELECT 1 AND true

statement error (42804)
SELECT NOT 1

# 文字列リテラルは bool として解釈される
query ??
SELECT 't' AND true, 'no' OR false
----
t f

# 表の値に対する三値論理
statement ok
CREATE TABLE expr_logic_t (id int, p bool, q bool)

statement ok
INSERT INTO expr_logic_t VALUES (1, true, NULL), (2, false, NULL), (3, NULL, NULL), (4, true, true)

query I??
SELECT id, p AND q, p OR q FROM expr_logic_t ORDER BY id
----
1 NULL t
2 f NULL
3 NULL NULL
4 t t

query I rowsort
SELECT id FROM expr_logic_t WHERE p IS NOT FALSE
----
1
3
4

query I rowsort
SELECT id FROM expr_logic_t WHERE NOT (p AND q)
----
2

statement ok
DROP TABLE expr_logic_t
