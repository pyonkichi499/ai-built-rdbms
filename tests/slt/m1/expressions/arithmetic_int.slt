# 整数の算術: 型ごとの演算、オーバーフロー、ゼロ除算、整数除算、剰余

query IIIII
SELECT 2 + 3, 2 - 3, 2 * 3, 7 / 2, 7 % 2
----
5 -1 6 3 1

# 整数除算は 0 方向への切り捨て
query IIII
SELECT -7 / 2, 7 / -2, -7 / -2, 1 / 3
----
-3 -3 3 0

# 剰余の符号は被除数と同じ
query IIII
SELECT -7 % 2, 7 % -2, -7 % -2, 0 % 5
----
-1 1 -1 0

# 単項演算子
query III
SELECT -5, +5, - -5
----
-5 5 5

query I
SELECT -(2 + 3)
----
-5

# ゼロ除算: 22012
statement error (22012)
SELECT 1 / 0

statement error (22012)
SELECT 1 % 0

statement error (22012)
SELECT 0 / 0

statement error (22012)
SELECT 1::int2 / 0::int2

statement error (22012)
SELECT 1::int8 / 0::int8

statement error (22012)
SELECT 1::int8 % 0

# int4 のオーバーフロー: 22003
query I
SELECT 2147483647
----
2147483647

statement error (22003)
SELECT 2147483647 + 1

statement error (22003)
SELECT -2147483647 - 2

statement error (22003)
SELECT 65536 * 65536

statement error (22003)
SELECT (-2147483647 - 1) * -1

statement error (22003)
SELECT (-2147483647 - 1) / -1

# INT_MIN % -1 は 0（エラーにならない）
query I
SELECT (-2147483647 - 1) % -1
----
0

# INT_MIN の符号反転はオーバーフロー
statement error (22003)
SELECT -(-2147483647 - 1)

# 2147483648 は int8 のリテラルになるので、それを使った演算は int8
query II
SELECT 2147483648, 2147483648 + 1
----
2147483648 2147483649

query I
SELECT -2147483648
----
-2147483648

# int8 のオーバーフロー
query I
SELECT 9223372036854775807
----
9223372036854775807

statement error (22003)
SELECT 9223372036854775807 + 1

query I
SELECT -9223372036854775807 - 1
----
-9223372036854775808

statement error (22003)
SELECT -9223372036854775807 - 2

statement error (22003)
SELECT 4294967296 * 4294967296

statement error (22003)
SELECT (-9223372036854775807 - 1) / -1

# int2 のオーバーフロー（int2 同士の演算は int2）
query I
SELECT 32767::int2
----
32767

statement error (22003)
SELECT 32767::int2 + 1::int2

statement error (22003)
SELECT 200::int2 * 200::int2

statement error (22003)
SELECT -(-32767::int2 - 1::int2)

# int2 と int4 を混ぜると int4 で計算する
query I
SELECT 32767::int2 + 1
----
32768

query I
SELECT 32767::int2 * 32767::int2::int4
----
1073676289

# int4 と int8 を混ぜると int8
query I
SELECT 2147483647 + 1::int8
----
2147483648

statement error (22003)
SELECT 2147483647::int2

# int と float8 を混ぜると float8
query R
SELECT 1 + '0.5'::float8
----
1.5

query R
SELECT 7 / '2'::float8
----
3.5

# NULL を含む算術は NULL
query IIII
SELECT 1 + NULL, NULL * 2, NULL / 0, -NULL::int
----
NULL NULL NULL NULL

# abs のオーバーフロー
statement error (22003)
SELECT abs(-2147483647 - 1)

query I
SELECT abs(-2147483647 - 1::int8)
----
2147483648
