# STRICT 関数・演算子の NULL 定数畳み込みと、OR TRUE / AND FALSE の短絡。
# PostgreSQL のプランナは評価しない部分式（桁あふれなど）でエラーにならない。

statement ok
CREATE TABLE nf_t (c0 int, c1 int)

statement ok
INSERT INTO nf_t VALUES (2147483647, 10), (5, 90), (-3, 20)

query IB
SELECT c0, ((((-84) * c0) * NULL) >= '1.5'::float8) FROM nf_t WHERE c1 BETWEEN 1 AND 50 ORDER BY 1
----
-3 NULL
2147483647 NULL

query I
SELECT c0 FROM nf_t WHERE ((65 - c1) <= abs(NULL)) AND (c1 >= 79) ORDER BY 1
----

query I
SELECT 2 FROM nf_t WHERE ((CASE WHEN c0 > 0 THEN 2147483647 ELSE 0 END + 21) IS NULL) OR TRUE ORDER BY 1
----
2
2
2

query I
SELECT c0 FROM nf_t WHERE (c0 + 2147483647 < 0 AND FALSE) OR c1 = 90
----
5

statement ok
DROP TABLE nf_t
