# 浮動小数点の算術
# 注意: PostgreSQL では 1.5 のような小数リテラルは numeric 型になる。numeric は M1 の範囲外なので、
# float8 の値は '1.5'::float8 のように書く。

query RRRR
SELECT '1.5'::float8 + '2.25'::float8, '1.5'::float8 - '2.25'::float8, '1.5'::float8 * '2'::float8, '1'::float8 / '4'::float8
----
3.75 -0.75 3 0.25

query R
SELECT '0.1'::float8 + '0.2'::float8
----
0.30000000000000004

query R
SELECT '1'::float8 / '3'::float8
----
0.3333333333333333

query R
SELECT -'2.5'::float8
----
-2.5

# float8 のゼロ除算も 22012
statement error (22012)
SELECT '1'::float8 / '0'::float8

statement error (22012)
SELECT '1'::float8 / 0

statement error (22012)
SELECT '0'::float8 / '0'::float8

statement error (22012)
SELECT '1'::float4 / '0'::float4

# float8 には % 演算子がない（42883）
statement error (42883)
SELECT '5'::float8 % '2'::float8

# オーバーフローとアンダーフロー: 22003
statement error (22003)
SELECT '1e308'::float8 * '10'::float8

statement error (22003)
SELECT '1e-300'::float8 * '1e-300'::float8

statement error (22003)
SELECT '3e38'::float4 * '10'::float4

# 無限大と NaN
query RRR
SELECT 'Infinity'::float8 + '1'::float8, '-Infinity'::float8 * '2'::float8, 'Infinity'::float8 / '1e308'::float8
----
Infinity -Infinity Infinity

query RRR
SELECT 'Infinity'::float8 - 'Infinity'::float8, 'Infinity'::float8 * '0'::float8, 'NaN'::float8 + '1'::float8
----
NaN NaN NaN

query R
SELECT '1'::float8 / 'Infinity'::float8
----
0

# -0
query RR
SELECT '0'::float8 * '-1'::float8, -'0'::float8
----
-0 -0

# float4 同士の演算は float4
query R
SELECT '1'::float4 / '3'::float4
----
0.33333334

query R
SELECT '0.1'::float4 + '0.2'::float4
----
0.3

# float4 と float8 を混ぜると float8
query R
SELECT '0.1'::float4 + '0'::float8
----
0.10000000149011612

# 整数と float4 を混ぜると、float8 と float4 の演算子（float84pl など）が選ばれ、結果は float8
query R
SELECT 1 + '0.5'::float4
----
1.5

query R
SELECT 1 / '3'::float4
----
0.3333333333333333

# abs
query RRR
SELECT abs('-1.5'::float8), abs('1.5'::float8), abs('-Infinity'::float8)
----
1.5 1.5 Infinity

query R
SELECT abs('-0.1'::float4)
----
0.1
