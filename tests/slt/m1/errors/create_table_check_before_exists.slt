# CREATE TABLE: 列定義の検査（型修飾子・NULL/NOT NULL の矛盾）は「テーブル既存」エラーより先

statement ok
CREATE TABLE ctbe_j (a integer)

statement error (22023)
CREATE TABLE ctbe_j (a varchar(0))

statement error (42601)
CREATE TABLE ctbe_j (a integer NOT NULL NULL)

statement error (42P07)
CREATE TABLE ctbe_j (a integer)

statement ok
CREATE TABLE IF NOT EXISTS ctbe_j (a varchar(0))

statement ok
DROP TABLE ctbe_j
