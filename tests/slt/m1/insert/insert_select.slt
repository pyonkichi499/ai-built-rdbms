# INSERT ... SELECT

statement ok
CREATE TABLE ins_s_src (a int, b text)

statement ok
CREATE TABLE ins_s_dst (x int, y text, z int DEFAULT -1)

statement ok
INSERT INTO ins_s_src VALUES (1, 'a'), (2, 'b'), (3, 'c'), (NULL, 'n')

statement count 4
INSERT INTO ins_s_dst SELECT a, b FROM ins_s_src

statement count 2
INSERT INTO ins_s_dst (y, x) SELECT b || '!', a * 100 FROM ins_s_src WHERE a >= 2

# FROM なしの SELECT
statement count 1
INSERT INTO ins_s_dst SELECT 9, 'nine', 99

# VALUES を問い合わせとして使う
statement count 2
INSERT INTO ins_s_dst (x, y) VALUES (10, 'ten'), (11, 'eleven')

# 0 行の SELECT
statement count 0
INSERT INTO ins_s_dst SELECT a, b FROM ins_s_src WHERE false

query ITI
SELECT x, y, z FROM ins_s_dst ORDER BY x NULLS FIRST, y
----
NULL n -1
1 a -1
2 b -1
3 c -1
9 nine 99
10 ten -1
11 eleven -1
200 b! -1
300 c! -1

# 列数が多すぎる: 42601
statement error (42601)
INSERT INTO ins_s_dst (x) SELECT a, b FROM ins_s_src

# 型が合わない（text → int）: 42804
statement error (42804)
INSERT INTO ins_s_dst (x) SELECT b FROM ins_s_src

# 自分自身への INSERT ... SELECT: 入力は文の開始時点の内容
statement ok
CREATE TABLE ins_s_self (n int)

statement ok
INSERT INTO ins_s_self VALUES (1), (2)

statement count 2
INSERT INTO ins_s_self SELECT n + 10 FROM ins_s_self

statement count 4
INSERT INTO ins_s_self SELECT n + 100 FROM ins_s_self

query I
SELECT n FROM ins_s_self ORDER BY n
----
1
2
11
12
101
102
111
112

# ORDER BY と LIMIT 付きの SELECT
statement ok
CREATE TABLE ins_s_top (n int)

statement count 3
INSERT INTO ins_s_top SELECT n FROM ins_s_self ORDER BY n DESC LIMIT 3

query I
SELECT n FROM ins_s_top ORDER BY n
----
102
111
112

statement ok
DROP TABLE ins_s_src, ins_s_dst, ins_s_self, ins_s_top
