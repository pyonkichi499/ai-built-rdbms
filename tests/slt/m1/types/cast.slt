# CAST(x AS t) と x::t

query II
SELECT CAST('12' AS int), '12'::int
----
12 12

query I
SELECT CAST(CAST('7' AS int) AS bigint)
----
7

# text → 整数: 前後の空白は許される
query III
SELECT ' 12 '::int, '+5'::int, '-0'::int
----
12 5 0

# PostgreSQL 16 以降: 16 進・8 進・2 進の接頭辞と、桁区切りの _
query IIII
SELECT '0x1F'::int, '0o17'::int, '0b101'::int, '1_000'::int
----
31 15 5 1000

