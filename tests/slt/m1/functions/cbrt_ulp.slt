# cbrt(float8) は libm と最終桁まで一致する（f64::cbrt とは 1ulp 異なる値がある）。

query T
SELECT cbrt('1.5'::float8) || '|' || cbrt(27::float8) || '|' || cbrt(2::float8) || '|' || cbrt(10::float8) || '|' || cbrt(0.5::float8) || '|' || cbrt(-1.5::float8) || '|' || cbrt(1e300::float8) || '|' || cbrt(1e-310::float8) || '|' || cbrt(0::float8) || '|' || cbrt(100::float8)
----
1.1447142425533317|3.0000000000000004|1.2599210498948734|2.1544346900318834|0.7937005259840998|-1.1447142425533317|1e+100|4.641588833612775e-104|0|4.641588833612778
