# UPDATE / DELETE のエラー

statement ok
CREATE TABLE upd_x_t (a int, b text)

statement ok
INSERT INTO upd_x_t VALUES (1, 'x')

# 42703: 存在しない列
statement error (42703)
UPDATE upd_x_t SET zzz = 1

statement error (42703)
UPDATE upd_x_t SET a = zzz

statement error (42703)
UPDATE upd_x_t SET a = 1 WHERE zzz = 1

statement error (42703)
DELETE FROM upd_x_t WHERE zzz = 1

# 42601: 構文エラー
statement error (42601)
UPDATE upd_x_t SET

statement error (42601)
UPDATE upd_x_t SET a = 1,

statement error (42601)
UPDATE upd_x_t WHERE a = 1

statement error (42601)
DELETE upd_x_t

# 42804: 型の不一致
statement error (42804)
UPDATE upd_x_t SET a = 'abc'::text

statement error (42804)
UPDATE upd_x_t SET a = true

statement error (42804)
UPDATE upd_x_t SET a = b

statement error (42804)
UPDATE upd_x_t SET a = 1 WHERE b

statement error (42804)
DELETE FROM upd_x_t WHERE a

# 22P02: unknown リテラルの変換失敗
statement error (22P02)
UPDATE upd_x_t SET a = 'abc'

# 42P01: 存在しないテーブル
statement error (42P01)
UPDATE upd_x_nonexistent SET a = 1

statement error (42P01)
DELETE FROM upd_x_nonexistent

# 0A000: M2 で対応しない構文（PostgreSQL では成功するので yuzhu だけで確かめる）
onlyif yuzhu
statement error (0A000)
UPDATE upd_x_t SET a = 2 RETURNING a

onlyif yuzhu
statement error (0A000)
DELETE FROM upd_x_t RETURNING a

# システム列への代入（PostgreSQL は 0A000）
statement error (0A000)
UPDATE upd_x_t SET ctid = '(0,1)'

statement error (0A000)
UPDATE upd_x_t SET xmin = 1

# 失敗した文のあともデータは変わっていない
query IT
SELECT a, b FROM upd_x_t
----
1 x

# UPDATE ... FROM / DELETE ... USING は M4 で実装済み（空の表との結合なので 0 行）
statement ok
CREATE TABLE upd_x_u (a int)

statement ok
UPDATE upd_x_t SET a = upd_x_u.a FROM upd_x_u

statement ok
DELETE FROM upd_x_t USING upd_x_u WHERE upd_x_t.a = upd_x_u.a

statement ok
DROP TABLE upd_x_u

statement ok
DROP TABLE upd_x_t
