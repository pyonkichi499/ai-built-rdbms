# 13 個のカタログの列（名前、型、長さ、照合順序）が PostgreSQL 17 と同じこと。
# NULL 専用列は attnotnull が違うので attnotnull は比べない。
# 1259 pg_class, 1249 pg_attribute, 1247 pg_type, 1255 pg_proc, 2615 pg_namespace, 2617 pg_operator,
# 2605 pg_cast, 2601 pg_am, 2604 pg_attrdef, 2606 pg_constraint, 1262 pg_database, 1260 pg_authid, 1213 pg_tablespace

query IITIII
SELECT attrelid, attnum, attname, atttypid, attlen, attcollation FROM pg_attribute WHERE attrelid IN (1259, 1249, 1247, 1255, 2615, 2617, 2605, 2601, 2604, 2606, 1262, 1260, 1213) AND attnum > 0 ORDER BY 1, 2
