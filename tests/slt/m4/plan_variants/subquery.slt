statement ok
CREATE TABLE pv_sq_t (a int PRIMARY KEY, b int)

statement ok
CREATE TABLE pv_sq_u (d int, b int)

statement ok
INSERT INTO pv_sq_t SELECT g, g % 8 FROM generate_series(1, 60) g

statement ok
INSERT INTO pv_sq_u SELECT g % 40, g % 8 FROM generate_series(1, 80) g

