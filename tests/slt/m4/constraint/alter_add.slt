statement ok
CREATE SEQUENCE cst_ad_seq

statement error (42809)
ALTER TABLE cst_ad_seq ADD PRIMARY KEY (a)

statement error (42809)
ALTER TABLE cst_ad_e_pkey ADD PRIMARY KEY (a)

statement ok
