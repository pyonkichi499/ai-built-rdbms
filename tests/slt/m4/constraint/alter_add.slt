# OWNER TO
query T
SELECT pg_get_userbyid(relowner) FROM pg_class WHERE oid = 'cst_ad_e'::regclass
----
postgres

statement ok
ALTER TABLE cst_ad_e OWNER TO postgres

statement ok
ALTER TABLE cst_ad_e OWNER TO pg_database_owner

query T
SELECT pg_get_userbyid(relowner) FROM pg_class WHERE oid = 'cst_ad_e'::regclass
----
pg_database_owner

# 索引の所有者も変わる
query TT
SELECT c.relname, pg_get_userbyid(c.relowner) FROM pg_index i JOIN pg_class c ON c.oid = i.indexrelid WHERE i.indrelid = 'cst_ad_e'::regclass ORDER BY c.relname
----
cst_ad_e_pkey pg_database_owner
cst_ad_ff pg_database_owner

