# 制約・索引の自動名（ChooseRelationName / ChooseIndexName の動き）。名前は pg_class と pg_constraint で一致する

statement ok
CREATE TABLE cst_nm_t2 (a int, b int, c text, PRIMARY KEY (a, b), UNIQUE (b, c), UNIQUE (a))

statement ok
CREATE INDEX ON cst_nm_t2 (a DESC)

statement ok
CREATE INDEX ON cst_nm_t2 (a DESC NULLS LAST)

statement ok
CREATE INDEX ON cst_nm_t2 (a NULLS FIRST)

statement ok
CREATE INDEX ON cst_nm_t2 (a)

statement ok
CREATE INDEX ON cst_nm_t2 (a, b)

statement ok
CREATE INDEX ON cst_nm_t2 (a)

# 索引名は t_a_idx からの連番（列・向きが違っても同じ）。indoption は DESC = 3、DESC NULLS LAST = 1、NULLS FIRST = 2
query TT
SELECT c.relname, i.indoption::text FROM pg_index i JOIN pg_class c ON c.oid = i.indexrelid WHERE i.indrelid = 'cst_nm_t2'::regclass ORDER BY c.relname
----
cst_nm_t2_a_b_idx 0 0
cst_nm_t2_a_idx 3
cst_nm_t2_a_idx1 1
cst_nm_t2_a_idx2 2
cst_nm_t2_a_idx3 0
cst_nm_t2_a_idx4 0
cst_nm_t2_a_key 0
cst_nm_t2_b_c_key 0 0
cst_nm_t2_pkey 0 0

# 制約の conkey（PRIMARY KEY が先に作られる）
query TTT
SELECT conname, contype::text, conkey::text FROM pg_constraint WHERE conrelid = 'cst_nm_t2'::regclass ORDER BY conname
----
cst_nm_t2_a_key u {1}
cst_nm_t2_b_c_key u {2,3}
cst_nm_t2_pkey p {1,2}

# 制約の索引の名前は制約の名前と同じ（pg_class と pg_constraint の一致）
query TT
SELECT c.conname, ic.relname FROM pg_constraint c JOIN pg_class ic ON ic.oid = c.conindid WHERE c.conrelid = 'cst_nm_t2'::regclass AND c.conname <> ic.relname
----

# 同じ列を 2 回: 列名は a, a1
statement ok
CREATE TABLE cst_nm_e1 (a int, b int)

statement ok
CREATE INDEX ON cst_nm_e1 (a, a)

query TT
SELECT c.relname, string_agg(a.attname, ',' ORDER BY a.attnum) FROM pg_class c JOIN pg_attribute a ON a.attrelid = c.oid WHERE c.relname = 'cst_nm_e1_a_a1_idx' GROUP BY c.relname
----
cst_nm_e1_a_a1_idx a,a1

query T
SELECT indkey::text FROM pg_index WHERE indexrelid = 'cst_nm_e1_a_a1_idx'::regclass
----
1 1

# 明示名の索引の重複は 42P07
statement ok
CREATE INDEX cst_nm_e1_a ON cst_nm_e1 (a)

statement error (42P07)
CREATE INDEX cst_nm_e1_a ON cst_nm_e1 (b)

statement ok
CREATE INDEX IF NOT EXISTS cst_nm_e1_a ON cst_nm_e1 (a)

# 同名のリレーションがすでにあると連番になる
statement ok
CREATE TABLE cst_nm_t3_a_key (x int)

statement ok
CREATE TABLE cst_nm_t3 (a int UNIQUE)

query T
SELECT conname FROM pg_constraint WHERE conrelid = 'cst_nm_t3'::regclass
----
cst_nm_t3_a_key1

# 同名の制約がすでにあると、索引も制約も連番になる
statement ok
CREATE TABLE cst_nm_t4 (a int, CONSTRAINT cst_nm_t4_a_key CHECK (a > 0), UNIQUE (a))

query TT
SELECT conname, contype::text FROM pg_constraint WHERE conrelid = 'cst_nm_t4'::regclass ORDER BY conname
----
cst_nm_t4_a_key c
cst_nm_t4_a_key1 u

query T
SELECT c.relname FROM pg_index i JOIN pg_class c ON c.oid = i.indexrelid WHERE i.indrelid = 'cst_nm_t4'::regclass
----
cst_nm_t4_a_key1

# 明示した制約名は連番にしない
statement ok
CREATE TABLE cst_nm_t5 (a int, CONSTRAINT cst_nm_x UNIQUE (a))

statement error (42P07)
CREATE TABLE cst_nm_t6 (a int, CONSTRAINT cst_nm_x UNIQUE (a))

# 同じ列の UNIQUE の重複は 1 つの索引に統合される
statement ok
CREATE TABLE cst_nm_t7 (a int, UNIQUE (a), UNIQUE (a))

query T
SELECT relname FROM pg_class WHERE relname LIKE 'cst\_nm\_t7%' ORDER BY relname
----
cst_nm_t7
cst_nm_t7_a_key

# PRIMARY KEY の名前がなく、後の UNIQUE が名前を持つ: 名前は u2、種類は p
statement ok
CREATE TABLE cst_nm_a5 (a int PRIMARY KEY, CONSTRAINT cst_nm_u2 UNIQUE (a))

query TT
SELECT conname, contype::text FROM pg_constraint WHERE conrelid = 'cst_nm_a5'::regclass
----
cst_nm_u2 p

query T
SELECT relname FROM pg_class WHERE relname LIKE 'cst\_nm\_a5%' OR relname = 'cst_nm_u2' ORDER BY relname
----
cst_nm_a5
cst_nm_u2

statement ok
DROP TABLE cst_nm_a5

# 名前つきの UNIQUE が先、PRIMARY KEY が後: 名前は p1、種類は p
statement ok
CREATE TABLE cst_nm_a5 (a int, CONSTRAINT cst_nm_u1 UNIQUE (a), CONSTRAINT cst_nm_p1 PRIMARY KEY (a))

query TT
SELECT conname, contype::text FROM pg_constraint WHERE conrelid = 'cst_nm_a5'::regclass
----
cst_nm_p1 p

statement ok
DROP TABLE cst_nm_a5

# 複数の UNIQUE の統合
statement ok
CREATE TABLE cst_nm_a5 (a int UNIQUE, b int, UNIQUE (a, b), UNIQUE (b, a), UNIQUE (a))

query T
SELECT conname FROM pg_constraint WHERE conrelid = 'cst_nm_a5'::regclass ORDER BY conname
----
cst_nm_a5_a_b_key
cst_nm_a5_a_key
cst_nm_a5_b_a_key

statement ok
DROP TABLE cst_nm_a5

# 長い名前（63 バイトに切り詰める。長い方から削る）
statement ok
CREATE TABLE cst_nm_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa (b int PRIMARY KEY, c int UNIQUE, long_column_name_number_one int, long_column_name_number_two int, UNIQUE (long_column_name_number_one, long_column_name_number_two))

statement ok
CREATE INDEX ON cst_nm_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa (c)

query IT
SELECT length(relname), relname FROM pg_class WHERE relname LIKE 'cst\_nm\_aaa%' AND relkind = 'i' ORDER BY relname
----
63 cst_nm_aaaaaaaaaaaaaaaaaaaaaa_long_column_name_number_one_l_key
63 cst_nm_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa_c_idx
63 cst_nm_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa_c_key
63 cst_nm_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa_pkey

statement ok
DROP TABLE cst_nm_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

statement ok
DROP TABLE cst_nm_t2

statement ok
DROP TABLE cst_nm_e1

statement ok
DROP TABLE cst_nm_t3

statement ok
DROP TABLE cst_nm_t3_a_key

statement ok
DROP TABLE cst_nm_t4

statement ok
DROP TABLE cst_nm_t5

statement ok
DROP TABLE cst_nm_t7
