# 追加カタログの OID 参照が閉じている（NOT IN の件数が 0）

query I
SELECT count(*) FROM pg_opfamily WHERE opfmethod NOT IN (SELECT oid FROM pg_am)
----
0

query I
SELECT count(*) FROM pg_opfamily WHERE opfnamespace NOT IN (SELECT oid FROM pg_namespace)
----
0

query I
SELECT count(*) FROM pg_opfamily WHERE opfowner NOT IN (SELECT oid FROM pg_authid)
----
0

query I
SELECT count(*) FROM pg_opclass WHERE opcfamily NOT IN (SELECT oid FROM pg_opfamily)
----
0

query I
SELECT count(*) FROM pg_opclass WHERE opcintype NOT IN (SELECT oid FROM pg_type)
----
0

query I
SELECT count(*) FROM pg_opclass WHERE opcmethod NOT IN (SELECT oid FROM pg_am)
----
0

query I
SELECT count(*) FROM pg_opclass WHERE opcnamespace NOT IN (SELECT oid FROM pg_namespace)
----
0

query I
SELECT count(*) FROM pg_opclass WHERE opcowner NOT IN (SELECT oid FROM pg_authid)
----
0

query I
SELECT count(*) FROM pg_amop WHERE amopfamily NOT IN (SELECT oid FROM pg_opfamily)
----
0

query I
