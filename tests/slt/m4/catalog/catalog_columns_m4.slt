# M4 で追加した 9 カタログの列（attnum・attname・型・NOT NULL・照合順序）が PostgreSQL と一致する

# pg_index
query ITTTI
SELECT attnum, attname, format_type(atttypid, atttypmod), attnotnull::text, attcollation FROM pg_attribute WHERE attrelid = 'pg_index'::regclass AND attnum > 0 ORDER BY attnum
----
1 indexrelid oid true 0
2 indrelid oid true 0
3 indnatts smallint true 0
4 indnkeyatts smallint true 0
5 indisunique boolean true 0
6 indnullsnotdistinct boolean true 0
7 indisprimary boolean true 0
8 indisexclusion boolean true 0
9 indimmediate boolean true 0
10 indisclustered boolean true 0
11 indisvalid boolean true 0
12 indcheckxmin boolean true 0
13 indisready boolean true 0
14 indislive boolean true 0
15 indisreplident boolean true 0
16 indkey int2vector true 0
17 indcollation oidvector true 0
18 indclass oidvector true 0
19 indoption int2vector true 0
20 indexprs pg_node_tree false 950
21 indpred pg_node_tree false 950

# pg_depend
query ITTTI
SELECT attnum, attname, format_type(atttypid, atttypmod), attnotnull::text, attcollation FROM pg_attribute WHERE attrelid = 'pg_depend'::regclass AND attnum > 0 ORDER BY attnum
----
1 classid oid true 0
2 objid oid true 0
3 objsubid integer true 0
4 refclassid oid true 0
5 refobjid oid true 0
6 refobjsubid integer true 0
7 deptype "char" true 0

# pg_sequence
query ITTTI
SELECT attnum, attname, format_type(atttypid, atttypmod), attnotnull::text, attcollation FROM pg_attribute WHERE attrelid = 'pg_sequence'::regclass AND attnum > 0 ORDER BY attnum
----
1 seqrelid oid true 0
2 seqtypid oid true 0
3 seqstart bigint true 0
4 seqincrement bigint true 0
5 seqmax bigint true 0
6 seqmin bigint true 0
7 seqcache bigint true 0
8 seqcycle boolean true 0

# pg_language
query ITTTI
SELECT attnum, attname, format_type(atttypid, atttypmod), attnotnull::text, attcollation FROM pg_attribute WHERE attrelid = 'pg_language'::regclass AND attnum > 0 ORDER BY attnum
