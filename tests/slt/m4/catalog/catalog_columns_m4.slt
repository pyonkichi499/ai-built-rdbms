4 description text true 950

# 9 カタログが pg_class にある
query TT
SELECT relname, relkind::text FROM pg_class WHERE relname IN ('pg_index', 'pg_depend', 'pg_sequence', 'pg_language', 'pg_opfamily', 'pg_opclass', 'pg_amop', 'pg_amproc', 'pg_description') ORDER BY relname
----
pg_amop r
pg_amproc r
pg_depend r
pg_description r
pg_index r
pg_language r
pg_opclass r
pg_opfamily r
pg_sequence r
