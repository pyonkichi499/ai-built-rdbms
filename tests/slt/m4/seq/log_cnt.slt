101 32 1

# YUZHU-ONLY: log_cnt は PostgreSQL の実装と時機が違う
onlyif yuzhu
statement ok
ALTER SEQUENCE sq_lc_a INCREMENT 2

# YUZHU-ONLY: log_cnt は PostgreSQL の実装と時機が違う
onlyif yuzhu
query III
SELECT last_value, log_cnt, is_called::int FROM sq_lc_a
----
101 0 1

