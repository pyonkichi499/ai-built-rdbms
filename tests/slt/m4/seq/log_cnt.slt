onlyif yuzhu
statement ok
SELECT setval('sq_lc_a', 100)

# YUZHU-ONLY: log_cnt は PostgreSQL の実装と時機が違う
onlyif yuzhu
query III
SELECT last_value, log_cnt, is_called::int FROM sq_lc_a
----
100 0 1

# YUZHU-ONLY: log_cnt は PostgreSQL の実装と時機が違う
onlyif yuzhu
statement ok
SELECT nextval('sq_lc_a')

# YUZHU-ONLY: log_cnt は PostgreSQL の実装と時機が違う
onlyif yuzhu
query III
SELECT last_value, log_cnt, is_called::int FROM sq_lc_a
