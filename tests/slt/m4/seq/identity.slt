# IDENTITY 列（GENERATED ALWAYS / BY DEFAULT AS IDENTITY）

statement ok
CREATE TABLE id_a (id int GENERATED ALWAYS AS IDENTITY, v text)

statement ok
CREATE TABLE id_d (id int GENERATED BY DEFAULT AS IDENTITY, v text)

# カタログ: attidentity、atthasdef = f、pg_attrdef に行なし、pg_depend が i
query TTT
SELECT attname, attidentity::text, atthasdef::text FROM pg_attribute WHERE attrelid IN ('id_a'::regclass) AND attnum > 0 ORDER BY attnum
----
id a false
v (empty) false

query T
SELECT attidentity::text FROM pg_attribute WHERE attrelid = 'id_d'::regclass AND attname = 'id'
----
d

query I
SELECT count(*) FROM pg_attrdef WHERE adrelid IN ('id_a'::regclass, 'id_d'::regclass)
----
0

query TTI
SELECT d.deptype::text, d.refobjid::regclass::text, d.refobjsubid FROM pg_depend d WHERE d.classid = 'pg_class'::regclass AND d.objid = 'id_a_id_seq'::regclass AND d.refclassid = 'pg_class'::regclass
----
i id_a 1

query T
SELECT attnotnull::text FROM pg_attribute WHERE attrelid = 'id_a'::regclass AND attname = 'id'
----
true

# ALWAYS: DEFAULT は成功、値を指定すると 428C9
statement count 2
INSERT INTO id_a (v) VALUES ('a'), ('b')

statement count 1
INSERT INTO id_a (id, v) VALUES (DEFAULT, 'c')

statement error (428C9)
INSERT INTO id_a (id, v) VALUES (10, 'x')

statement error (?s)cannot insert a non-DEFAULT value into column "id".*DETAIL: Column "id" is an identity column defined as GENERATED ALWAYS\..*HINT: Use OVERRIDING SYSTEM VALUE to override\.
INSERT INTO id_a (id, v) VALUES (10, 'x')

statement error (428C9)
INSERT INTO id_a VALUES (10, 'x')

statement error (428C9)
INSERT INTO id_a (id, v) VALUES (DEFAULT, 'y'), (11, 'z')

# 複数行 VALUES の途中でエラーでも、先の行は入らない
query IT
SELECT id, v FROM id_a ORDER BY id
----
1 a
2 b
3 c

# NULL は 23502
statement error (23502)
INSERT INTO id_a (id, v) OVERRIDING SYSTEM VALUE VALUES (NULL, 'n')

# OVERRIDING SYSTEM VALUE は明示の値を入れる
statement count 1
INSERT INTO id_a (id, v) OVERRIDING SYSTEM VALUE VALUES (100, 'sys')

# OVERRIDING USER VALUE は明示の値を捨てて生成する
statement count 1
INSERT INTO id_a (id, v) OVERRIDING USER VALUE VALUES (200, 'user')

query IT
SELECT id, v FROM id_a ORDER BY id
----
1 a
2 b
3 c
4 user
100 sys

# INSERT ... SELECT
statement error (428C9)
INSERT INTO id_a (id, v) SELECT g, 'g' FROM generate_series(1, 2) g

statement count 2
INSERT INTO id_a (v) SELECT 'g' || g FROM generate_series(1, 2) g

statement count 2
INSERT INTO id_a (id, v) OVERRIDING SYSTEM VALUE SELECT g + 1000, 'g' FROM generate_series(1, 2) g

# BY DEFAULT: 明示の値を受け付ける
statement count 2
INSERT INTO id_d (v) VALUES ('a'), ('b')

statement count 1
INSERT INTO id_d (id, v) VALUES (50, 'explicit')

statement count 1
INSERT INTO id_d (id, v) VALUES (DEFAULT, 'c')

statement count 1
INSERT INTO id_d (id, v) OVERRIDING USER VALUE VALUES (999, 'user')

statement error (23502)
INSERT INTO id_d (id, v) VALUES (NULL, 'n')

query IT
SELECT id, v FROM id_d ORDER BY id
----
1 a
2 b
3 c
4 user
50 explicit

# UPDATE: ALWAYS は DEFAULT 以外が 428C9（WHERE false でも）
statement error (428C9)
UPDATE id_a SET id = 5 WHERE id = 1

statement error (?s)column "id" can only be updated to DEFAULT.*DETAIL: Column "id" is an identity column defined as GENERATED ALWAYS\.
UPDATE id_a SET id = 5 WHERE id = 1

statement error (428C9)
UPDATE id_a SET id = 5 WHERE false

statement error (428C9)
UPDATE id_a SET id = id

statement count 1
UPDATE id_a SET id = DEFAULT WHERE v = 'a'

statement count 1
UPDATE id_a SET v = 'a2' WHERE v = 'b'

# BY DEFAULT の UPDATE は自由
statement count 1
UPDATE id_d SET id = 60 WHERE id = 50

# 型: smallint / bigint は可、text / numeric は不可
statement ok
CREATE TABLE id_t (a smallint GENERATED ALWAYS AS IDENTITY, b bigint GENERATED BY DEFAULT AS IDENTITY)

query TT
SELECT c.relname, s.seqtypid::regtype::text FROM pg_sequence s JOIN pg_class c ON c.oid = s.seqrelid WHERE c.relname LIKE 'id\_t\_%' ORDER BY c.relname
----
id_t_a_seq smallint
id_t_b_seq bigint

statement error (?s)identity column type must be smallint, integer, or bigint
CREATE TABLE id_e (a text GENERATED ALWAYS AS IDENTITY)

statement error (22023)
CREATE TABLE id_e (a text GENERATED ALWAYS AS IDENTITY)

statement error (22023)
CREATE TABLE id_e (a numeric GENERATED ALWAYS AS IDENTITY)

# オプション
statement ok
CREATE TABLE id_o (id int GENERATED ALWAYS AS IDENTITY (START WITH 100 INCREMENT BY 10 MINVALUE 50 MAXVALUE 1000 CACHE 3 CYCLE), v int)

query IIIIIT
SELECT seqstart, seqincrement, seqmin, seqmax, seqcache, seqcycle::text FROM pg_sequence WHERE seqrelid = 'id_o_id_seq'::regclass
----
100 10 50 1000 3 true

statement count 3
INSERT INTO id_o (v) VALUES (1), (2), (3)

query I
SELECT id FROM id_o ORDER BY id
----
100
110
120

statement ok
CREATE TABLE id_n (id int GENERATED BY DEFAULT AS IDENTITY (SEQUENCE NAME id_n_myseq START 7))

statement count 1
INSERT INTO id_n DEFAULT VALUES

query I
SELECT id FROM id_n
----
7

query T
SELECT relname FROM pg_class WHERE relname LIKE 'id\_n%' ORDER BY relname
----
id_n
id_n_myseq

# 列の制約の衝突
statement error (?s)both default and identity specified for column "a" of table "id_e"
CREATE TABLE id_e (a int DEFAULT 1 GENERATED ALWAYS AS IDENTITY)

statement error (42601)
CREATE TABLE id_e (a int DEFAULT 1 GENERATED ALWAYS AS IDENTITY)

statement error (?s)multiple identity specifications for column "a" of table "id_e"
CREATE TABLE id_e (a int GENERATED ALWAYS AS IDENTITY GENERATED BY DEFAULT AS IDENTITY)

statement error (42601)
CREATE TABLE id_e (a int GENERATED ALWAYS AS IDENTITY GENERATED BY DEFAULT AS IDENTITY)

# DROP SEQUENCE は 2BP01
statement error (2BP01)
DROP SEQUENCE id_a_id_seq

# TRUNCATE ... RESTART IDENTITY（IDENTITY も SERIAL も）
statement ok
CREATE TABLE id_r (id int GENERATED ALWAYS AS IDENTITY, s serial)

statement count 1
INSERT INTO id_r DEFAULT VALUES

statement count 1
INSERT INTO id_r DEFAULT VALUES

statement ok
TRUNCATE id_r

statement count 1
INSERT INTO id_r DEFAULT VALUES

query II
SELECT id, s FROM id_r
----
3 3

statement ok
TRUNCATE id_r RESTART IDENTITY

statement count 1
INSERT INTO id_r DEFAULT VALUES

query II
SELECT id, s FROM id_r
----
1 1

statement ok
DROP TABLE id_a

statement ok
DROP TABLE id_d

statement ok
DROP TABLE id_t

statement ok
DROP TABLE id_o

statement ok
DROP TABLE id_n

statement ok
DROP TABLE id_r

query T
SELECT relname FROM pg_class WHERE relname LIKE 'id\_%' AND relkind IN ('r', 'S')
----
