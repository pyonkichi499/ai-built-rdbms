# CACHE: 2 接続の交互の nextval

statement ok
CREATE SEQUENCE sq_c_a CACHE 5

connection a
query I
SELECT nextval('sq_c_a')
----
1

connection b
query I
SELECT nextval('sq_c_a')
----
6

connection a
query I
SELECT nextval('sq_c_a')
----
2

connection a
query I
SELECT nextval('sq_c_a') FROM generate_series(1, 3)
----
3
4
5

connection a
query I
SELECT nextval('sq_c_a')
----
11

connection b
query I
SELECT nextval('sq_c_a')
----
7

# 上限での打ち切り
statement ok
CREATE SEQUENCE sq_c_b CACHE 3 MAXVALUE 7

connection a
query I
SELECT nextval('sq_c_b')
----
1

connection b
query I
SELECT nextval('sq_c_b')
----
4

connection a
query I
SELECT nextval('sq_c_b')
----
2

connection a
query I
SELECT nextval('sq_c_b')
----
3

connection a
query I
SELECT nextval('sq_c_b')
----
7

connection b
query I
SELECT nextval('sq_c_b')
----
5

connection b
query I
SELECT nextval('sq_c_b')
----
6

connection b
statement error (2200H)
SELECT nextval('sq_c_b')

# INCREMENT と CACHE
statement ok
CREATE SEQUENCE sq_c_c INCREMENT 2 CACHE 5 START 10

query I
SELECT nextval('sq_c_c')
----
10

query I
SELECT nextval('sq_c_c')
----
12

# 他の接続は次のブロックから（10, 12, 14, 16, 18 を確保済み）
connection b
query I
SELECT nextval('sq_c_c')
----
20

query I
SELECT nextval('sq_c_c')
----
14

statement ok
DROP SEQUENCE sq_c_a, sq_c_b, sq_c_c
