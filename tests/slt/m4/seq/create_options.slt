# システムカタログのスキーマ
statement error (42501)
CREATE SEQUENCE pg_catalog.sq_co_zz

# 失敗した CREATE は何も作らない
query T
SELECT relname FROM pg_class WHERE relname LIKE 'sq\_co\_x%' OR relname LIKE 'sq\_co\_y%' OR relname LIKE 'sq\_co\_zz%'
----

# OWNED BY
statement ok
CREATE TABLE sq_co_u (a int, b int)

statement ok
CREATE SEQUENCE sq_co_ob OWNED BY sq_co_u.a

query T
SELECT deptype::text FROM pg_depend WHERE objid = 'sq_co_ob'::regclass AND refobjid = 'sq_co_u'::regclass AND refobjsubid = 1
----
a

statement ok
CREATE SEQUENCE sq_co_on OWNED BY NONE

statement error (?s)invalid OWNED BY option.*HINT: Specify OWNED BY table\.column or OWNED BY NONE\.
CREATE SEQUENCE sq_co_x OWNED BY sq_co_u

statement error (42601)
CREATE SEQUENCE sq_co_x OWNED BY sq_co_u

statement error (?s)sequence cannot be owned by relation "sq_co_a"
CREATE SEQUENCE sq_co_x OWNED BY sq_co_a.last_value

statement error (42809)
CREATE SEQUENCE sq_co_x OWNED BY sq_co_a.last_value

statement error (?s)column "nope" of relation "sq_co_u" does not exist
CREATE SEQUENCE sq_co_x OWNED BY sq_co_u.nope

statement error (42703)
CREATE SEQUENCE sq_co_x OWNED BY sq_co_u.nope

# 所有する表を消すとシーケンスも消える
statement ok
DROP TABLE sq_co_u

query T
SELECT relname FROM pg_class WHERE relname = 'sq_co_ob'
----

# OWNED BY の所有側の表と一緒に消えているので IF EXISTS で明示する（lint L01 用）
statement ok
DROP SEQUENCE IF EXISTS sq_co_ob

statement ok
DROP TABLE sq_co_t

statement ok
DROP SEQUENCE sq_co_a, sq_co_b, sq_co_c, sq_co_d, sq_co_e, sq_co_f, sq_co_g, sq_co_h, sq_co_i, sq_co_j, sq_co_k, sq_co_l, sq_co_on
