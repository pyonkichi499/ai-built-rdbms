# CREATE SEQUENCE のオプションと検証メッセージ

statement ok
CREATE SEQUENCE sq_co_a

query TIIIIIT
SELECT seqtypid::regtype::text, seqstart, seqmin, seqmax, seqincrement, seqcache, seqcycle::text FROM pg_sequence WHERE seqrelid = 'sq_co_a'::regclass
----
bigint 1 1 9223372036854775807 1 1 false

statement ok
CREATE SEQUENCE sq_co_b AS int2

statement ok
CREATE SEQUENCE sq_co_c AS int4

statement ok
CREATE SEQUENCE sq_co_d AS int8

statement ok
CREATE SEQUENCE sq_co_e AS integer

statement ok
CREATE SEQUENCE sq_co_f AS smallint

statement ok
CREATE SEQUENCE sq_co_g AS bigint

query TTIII
SELECT c.relname, seqtypid::regtype::text, seqmin, seqmax, seqstart FROM pg_sequence s JOIN pg_class c ON c.oid = s.seqrelid WHERE c.relname ~ '^sq_co_[b-g]$' ORDER BY c.relname
----
sq_co_b smallint 1 32767 1
sq_co_c integer 1 2147483647 1
sq_co_d bigint 1 9223372036854775807 1
sq_co_e integer 1 2147483647 1
sq_co_f smallint 1 32767 1
sq_co_g bigint 1 9223372036854775807 1

# 降順の既定値
statement ok
CREATE SEQUENCE sq_co_h INCREMENT BY -1

query IIIII
SELECT seqstart, seqmin, seqmax, seqincrement, seqcache FROM pg_sequence WHERE seqrelid = 'sq_co_h'::regclass
----
-1 -9223372036854775808 -1 -1 1

statement ok
CREATE SEQUENCE sq_co_i AS smallint INCREMENT -2

query III
SELECT seqstart, seqmin, seqmax FROM pg_sequence WHERE seqrelid = 'sq_co_i'::regclass
----
-1 -32768 -1

# 全オプション
statement ok
CREATE SEQUENCE sq_co_j AS int4 INCREMENT BY 3 MINVALUE 10 MAXVALUE 1000 START WITH 20 CACHE 7 CYCLE

query IIIIIT
SELECT seqstart, seqmin, seqmax, seqincrement, seqcache, seqcycle::text FROM pg_sequence WHERE seqrelid = 'sq_co_j'::regclass
----
20 10 1000 3 7 true

statement ok
CREATE SEQUENCE sq_co_k NO MINVALUE NO MAXVALUE NO CYCLE START 5

query IIIT
SELECT seqstart, seqmin, seqmax, seqcycle::text FROM pg_sequence WHERE seqrelid = 'sq_co_k'::regclass
----
5 1 9223372036854775807 false

statement ok
CREATE SEQUENCE sq_co_l MINVALUE -5 START -2 INCREMENT 1

query I
SELECT nextval('sq_co_l')
----
-2

statement ok
CREATE SEQUENCE IF NOT EXISTS sq_co_a

# 同名
statement error (42P07)
CREATE SEQUENCE sq_co_a

statement error (?s)relation "sq_co_a" already exists
CREATE SEQUENCE sq_co_a

statement ok
CREATE TABLE sq_co_t (a int)

statement error (42P07)
CREATE SEQUENCE sq_co_t

# 検証エラー
statement error (42601)
CREATE SEQUENCE sq_co_x MAXVALUE 5 MAXVALUE 6

statement error (?s)conflicting or redundant options
CREATE SEQUENCE sq_co_x INCREMENT 1 INCREMENT 2

statement error (?s)invalid sequence option SEQUENCE NAME
CREATE SEQUENCE sq_co_x SEQUENCE NAME sq_co_y

statement error (?s)sequence type must be smallint, integer, or bigint
CREATE SEQUENCE sq_co_x AS text

statement error (22023)
CREATE SEQUENCE sq_co_x AS numeric

statement error (?s)type "sq_co_nope" does not exist
CREATE SEQUENCE sq_co_x AS sq_co_nope

statement error (42704)
CREATE SEQUENCE sq_co_x AS sq_co_nope

statement error (?s)value "9223372036854775808" is out of range for type bigint
CREATE SEQUENCE sq_co_x MAXVALUE 9223372036854775808

statement error (22003)
CREATE SEQUENCE sq_co_x MAXVALUE 9223372036854775808

statement error (?s)invalid input syntax for type bigint: "1\.5"
CREATE SEQUENCE sq_co_x START 1.5

statement error (22P02)
CREATE SEQUENCE sq_co_x START 1.5

statement error (?s)INCREMENT must not be zero
CREATE SEQUENCE sq_co_x INCREMENT 0

statement error (22023)
CREATE SEQUENCE sq_co_x INCREMENT 0

statement error (?s)MAXVALUE \(40000\) is out of range for sequence data type smallint
CREATE SEQUENCE sq_co_x AS smallint MAXVALUE 40000

statement error (?s)MINVALUE \(-40000\) is out of range for sequence data type smallint
CREATE SEQUENCE sq_co_x AS smallint MINVALUE -40000

statement error (?s)MINVALUE \(5\) must be less than MAXVALUE \(1\)
