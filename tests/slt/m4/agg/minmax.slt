# min / max: text・char(n)・numeric・date・float の NaN・NULL のみ・等しいとき後の値（09 D-9-12）

statement ok
CREATE TABLE ag_mm (g int, t text, c char(5), n numeric, d date, f float8, i int)

statement ok
INSERT INTO ag_mm VALUES
  (1, 'banana', 'bb', 1.10, '2024-03-01', 1.5, 3),
  (1, 'Apple', 'a', 1.1, '2024-01-15', 'NaN', 1),
  (1, 'cherry', 'ccc', 1.100, '2023-12-31', -2.5, 2),
  (1, NULL, NULL, NULL, NULL, NULL, NULL),
  (2, NULL, NULL, NULL, NULL, NULL, NULL)

# text は C 照合のバイト順（大文字が小文字より前）
query TT
SELECT min(t), max(t) FROM ag_mm
----
Apple cherry

query TT
SELECT min(c)::text, max(c)::text FROM ag_mm
----
a    ccc  

# char(n) の比較は末尾の空白を無視
query TT
SELECT min(c), max(c) FROM ag_mm
----
a ccc

query TT
SELECT min(d)::text, max(d)::text FROM ag_mm
----
2023-12-31 2024-03-01

# NaN は最大
query TT
SELECT min(f)::text, max(f)::text FROM ag_mm
----
-2.5 NaN

query TT
SELECT min(f)::text, max(f)::text FROM ag_mm WHERE f <> 'NaN'
----
-2.5 1.5

query II
SELECT min(i), max(i) FROM ag_mm
----
1 3

# 等しいときに残る値: 1.10 / 1.1 / 1.100 の挿入順で最後
query TT
SELECT min(n)::text, max(n)::text FROM ag_mm
----
1.100 1.100

statement ok
CREATE TABLE ag_mm2 (n numeric)

statement ok
INSERT INTO ag_mm2 VALUES (1.10), (1.1)

query TT
SELECT min(n)::text, max(n)::text FROM ag_mm2
----
1.1 1.1

statement ok
DELETE FROM ag_mm2

statement ok
INSERT INTO ag_mm2 VALUES (1.1), (1.10), (1.100)

query TT
SELECT min(n)::text, max(n)::text FROM ag_mm2
----
1.100 1.100

# 全部 NULL のグループ
query ITTTT
SELECT g, min(t), max(c), min(n)::text, max(d)::text FROM ag_mm GROUP BY g ORDER BY g
----
1 Apple ccc 1.100 2024-03-01
2 NULL NULL NULL NULL

# 負のゼロとゼロは等しい
query T
SELECT max(x)::text FROM (VALUES (-0.0::float8), (0.0::float8)) v(x)
----
0

# 式の引数と DISTINCT（結果は同じ）
query II
SELECT min(DISTINCT i), max(DISTINCT i) FROM ag_mm
----
1 3

query I
SELECT max(i + 1) FROM ag_mm
----
4

statement ok
DROP TABLE ag_mm, ag_mm2
