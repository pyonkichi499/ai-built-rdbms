statement error (22003)
SELECT 1e1000000::numeric

# 比較
query ????
SELECT 1.10 = 1.1, 1.10 <> 1.1, 1.5 < 2, 2.5 >= 2.5
----
t f t t

query ???
SELECT 1.0 = 1, 2 > 1.5, 1.5 <= 1
----
t t f

query ??
SELECT 0.1 + 0.2 = 0.3, 1 / 3.0 * 3 = 1
----
t f

# ORDER BY / GROUP BY / DISTINCT（1.10 と 1.1 は同じ値）
statement ok
CREATE TABLE ty_nb_t (id int, v numeric)

statement ok
INSERT INTO ty_nb_t VALUES (1, 1.10), (2, 1.1), (3, 2.50), (4, NULL), (5, 'NaN'), (6, -0.5), (7, 2.5), (8, NULL)

query IT
SELECT id, v::text FROM ty_nb_t ORDER BY v, id
----
6 -0.5
2 1.1
1 1.10
7 2.5
3 2.50
5 NaN
4 NULL
8 NULL

query IT
SELECT id, v::text FROM ty_nb_t ORDER BY v DESC, id
----
4 NULL
8 NULL
5 NaN
3 2.50
7 2.5
1 1.10
2 1.1
6 -0.5

query IT
SELECT id, v::text FROM ty_nb_t ORDER BY v NULLS FIRST, id
----
4 NULL
8 NULL
6 -0.5
2 1.1
1 1.10
7 2.5
3 2.50
5 NaN

query I
SELECT id FROM ty_nb_t WHERE v = 1.1 ORDER BY id
----
1
2

query I
SELECT count(*) FROM ty_nb_t WHERE v > 1 AND v < 'NaN'
----
4

query I
SELECT count(*) FROM (SELECT DISTINCT v FROM ty_nb_t) d
----
5

query I
SELECT count(*) FROM (SELECT v FROM ty_nb_t GROUP BY v) g
----
5

query IT
SELECT count(*), max(v)::text FROM ty_nb_t WHERE v IN (1.1, 2.5)
----
4 2.5

query T
SELECT v::text FROM ty_nb_t WHERE v IN (1.10, 2.5, -0.5) ORDER BY v, id
----
-0.5
1.1
1.10
2.5
2.50

statement ok
DROP TABLE ty_nb_t

# 型の混合: numeric + 整数は numeric、numeric + float8 は float8
query TTTT
SELECT pg_typeof(1.5 + 1), pg_typeof(1.5 + 1.0::float8), pg_typeof(1 + 1.5), pg_typeof(1.5 + 1::bigint)
----
numeric double precision numeric numeric

query ??T
SELECT 1.5 = 1.5::float8, 0.1 = 0.1::float8, pg_typeof(1.5 < 2::float8)
----
t t boolean

query TT
SELECT (1.5 + 1)::text, (2::int2 * 1.5)::text
----
2.5 3.0

query TTT
SELECT pg_typeof(2 ^ 3), pg_typeof(10 / 4.0), pg_typeof(10 / 4)
----
double precision numeric integer

query TT
SELECT (10 / 4.0)::text, (10 / 4)::text
----
2.5000000000000000 2

# numeric と整数・文字列のキャスト
query TTT
SELECT 1::numeric::text, '12.50'::numeric::text, 5::numeric(10,3)::text
----
1 12.50 5.000

query T
SELECT pg_typeof(1::numeric)
----
numeric

statement ok
RESET TIME ZONE
