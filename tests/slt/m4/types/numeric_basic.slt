# numeric: リテラルの型、四則と scale、丸め関数、NaN / Infinity、比較、グルーピング、型の混合
# numeric の値は文字列（::text）で比べる（scale の違いを見落とさないため）

statement ok
SET TIME ZONE 'UTC'

# リテラルの型
query TTTTT
SELECT pg_typeof(1.5), pg_typeof(.5), pg_typeof(1e3), pg_typeof(2147483648), pg_typeof(9223372036854775808)
----
numeric numeric numeric bigint numeric

query TTT
SELECT 1.5::text, .5::text, 1e3::text
----
1.5 0.5 1000

query TTT
SELECT 1.50::text, 0.10::text, 100.::text
----
1.50 0.10 100

# 四則と scale
query TTTT
SELECT (0.1 + 0.2)::text, (1.50 * 2.25)::text, (1.0 / 3)::text, (100::numeric / 3)::text
----
0.3 3.3750 0.33333333333333333333 33.3333333333333333

query TTTT
SELECT (10 / 4.0)::text, (7.0 % 2.5)::text, (-7.5 % 2)::text, (1.5 - 2.25)::text
----
2.5000000000000000 2.0 -1.5 -0.75

query TTTT
SELECT (2.0 * 3)::text, (1.10 + 1.1)::text, (5.00 - 5)::text, (0.001 * 0.001)::text
----
6.0 2.20 0.00 0.000001

query TTTT
SELECT (1 / 3.0)::text, (2 / 3.0)::text, (22 / 7.0)::text, (1.0 / 8)::text
----
0.33333333333333333333 0.66666666666666666667 3.1428571428571429 0.12500000000000000000

query TT
SELECT (-(1.5))::text, (+(1.5))::text
----
-1.5 1.5

# 単項演算子と符号つきの定数
query TT
SELECT (3 + -1.5)::text, (3 - -1.5)::text
----
1.5 4.5

# 丸め関数
query TTTT
SELECT round(2.5)::text, round(-2.5)::text, round(3.5)::text, round(0.5)::text
----
3 -3 4 1

query TTTT
SELECT round(1.2345, 2)::text, round(1.235, 2)::text, round(-1.235, 2)::text, round(1234.5678, -2)::text
----
1.23 1.24 -1.24 1200

query TTTT
SELECT trunc(2.9)::text, trunc(-2.9)::text, trunc(1.2399, 2)::text, trunc(1234.5, -2)::text
----
2 -2 1.23 1200

query TTTT
SELECT ceil(1.1)::text, ceil(-1.1)::text, floor(1.9)::text, floor(-1.1)::text
----
2 -1 1 -2

query TTTT
SELECT ceiling(1.0)::text, floor(2.0)::text, ceil(0.0)::text, floor(-0.5)::text
----
1 2 0 -1

query TTTT
SELECT abs(-1.50)::text, abs(1.50)::text, sign(-3.2)::text, sign(0.0)::text
----
1.50 1.50 -1 0

query TTT
SELECT mod(7.5, 2)::text, mod(-7.5, 2)::text, mod(7, 2.5)::text
----
1.5 -1.5 2.0

query TTT
SELECT div(7.5, 2)::text, div(-7.5, 2)::text, div(100, 7)::text
----
3 -3 14

query III
SELECT scale(1.50), scale(100), scale(0.001)
----
2 0 3

# 戻り値の型
query TTTT
SELECT pg_typeof(round(2.5)), pg_typeof(round(2)), pg_typeof(round(2.5, 1)), pg_typeof(round(2.5::float8))
----
numeric double precision numeric double precision

query TTTT
SELECT pg_typeof(trunc(2)), pg_typeof(ceil(2)), pg_typeof(floor(2.5)), pg_typeof(abs(-2.5))
----
double precision double precision numeric numeric

query TTTT
SELECT pg_typeof(mod(5, 2)), pg_typeof(mod(5.0, 2)), pg_typeof(div(5, 2)), pg_typeof(sign(2))
----
integer numeric numeric double precision

# round(2) は float8（0.5 の丸めは偶数ではなく 0 から遠い方へ。float8 は偶数丸め）
query TT
SELECT round(2.5::float8)::text, round(3.5::float8)::text
----
2 4

query TT
SELECT round(2)::text, mod(5, 2)::text
----
2 1

# NaN / Infinity
query TTTT
SELECT 'NaN'::numeric::text, 'Infinity'::numeric::text, '-Infinity'::numeric::text, 'inf'::numeric::text
----
NaN Infinity -Infinity Infinity

query TTT
SELECT ('NaN'::numeric + 1)::text, ('Infinity'::numeric + 1)::text, ('Infinity'::numeric - 'Infinity'::numeric)::text
----
NaN Infinity NaN

query ???
SELECT ('NaN'::numeric = 'NaN'::numeric), ('NaN'::numeric > 1e100), ('Infinity'::numeric < 'NaN'::numeric)
----
t t t

query TTT
SELECT round('NaN'::numeric)::text, trunc('Infinity'::numeric)::text, abs('-Infinity'::numeric)::text
----
NaN Infinity Infinity

