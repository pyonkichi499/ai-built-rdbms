SELECT 'Foo.Bar' ~ '^(Foo\.Bar)$', 'FooxBar' ~ '^(Foo\.Bar)$', 't$' ~ '^(t\$)$', 't' ~ '^(t\$)$', 'x' ~ '^((x|y))$', 'xy' ~ '^((x|y))$'
----
t f t f t f

query ?????
SELECT 'apple' ~ '^([a-c].*)$', 'dog' ~ '^([a-c].*)$', 'aaab' ~ '^(a+b)$', 'b' ~ '^(a+b)$', '' ~ '^(.*)$'
----
t f t f t

query ???????
SELECT '(x)' ~ '^(\(x\))$', '[x]' ~ '^(\[x\])$', 'a*b' ~ '^(a\*b)$', 'a?b' ~ '^(a\?b)$', 'a+b' ~ '^(a\+b)$', 'a{2}' ~ '^(a\{2\})$', 'a^b' ~ '^(a\^b)$'
----
t t t t t t t

query ???
SELECT 'a|b' ~ '^(a\|b)$', 'a' ~ '^(a\|b)$', 'foo' ~ '^(Foo)$'
----
t f f

# ReDoS 型でも速い
query ??
SELECT 'aaaaaaaaaaaaaaaaaaaaaaaaaaaa!' ~ '^(a+)+$', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaab' ~ '(a*)*b'
----
f t

# \dt 相当の問い合わせ（pg_class と pg_namespace）
query I
SELECT count(*) FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE n.nspname !~ '^pg_toast' AND n.nspname <> 'information_schema' AND c.relname ~ '^(ty_rx_t)$'
----
1

query I
SELECT count(*) FROM pg_class c LEFT JOIN pg_namespace n ON n.oid = c.relnamespace WHERE c.relname OPERATOR(pg_catalog.~) '^(ty_rx_.*)$' COLLATE pg_catalog.default AND n.nspname !~ '^pg_'
----
1

