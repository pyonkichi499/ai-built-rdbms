# 正規表現演算子 ~ ~* !~ !~*（text / name / bpchar）。psql の \dt が使うパターンを含む

# 基本（部分一致）
query ??????
SELECT 'foobar' ~ 'oba', 'foobar' ~ '^foo', 'foobar' ~ 'bar$', 'foobar' ~ '^bar', 'foobar' ~ 'x', 'foobar' ~ ''
----
t t t f f t

query ????
SELECT 'FooBar' ~ 'foo', 'FooBar' ~* 'foo', 'FooBar' !~ 'foo', 'FooBar' !~* 'foo'
----
f t t f

query ????
SELECT 'abc' ~ 'a.c', 'a' || chr(10) || 'c' ~ 'a.c', 'abc' ~ 'a[bx]c', 'abc' ~ 'a[^b]c'
----
t t t f

# NULL
query ????
SELECT NULL ~ 'a', 'a' ~ NULL, NULL !~ 'a', NULL::text ~* NULL
----
NULL NULL NULL NULL

# 量指定子・選択・グループ
query ??????
SELECT 'aaa' ~ '^a{3}$', 'aa' ~ '^a{3}$', 'aaaa' ~ '^a{2,3}$', 'ab' ~ '^(a|b)+$', 'abab' ~ '^(ab)*$', 'abc' ~ '^(ab)?c$'
----
t f f t t t

query ????
SELECT 'x' ~ '^a*$', '' ~ '^a*$', 'a' ~ '^a+$', '' ~ '^a+$'
----
f t t f

query ???
SELECT 'a{x}' ~ 'a{x}', 'a{' ~ 'a{', 'a{,2}' ~ 'a{,2}'
----
t t t

# 文字クラスとエスケープ
query ??????
SELECT 'a1' ~ '^[[:alpha:]][[:digit:]]$', 'a1' ~ '^\w\d$', ' ' ~ '^\s$', 'a' ~ '\D', '1' ~ '\D', 'ab' ~ '^[a-c]+$'
----
t t t t f t

query ????
SELECT 'a-b' ~ '^a\-b$', 'a.b' ~ '^a\.b$', 'axb' ~ '^a\.b$', 'a$' ~ 'a\$'
----
t t f t

query ???
SELECT 'foo bar' ~ '\mbar', 'foobar' ~ '\mbar', 'foo bar' ~ 'foo\M'
----
t f t

query ???
SELECT 'ab' ~ '\Aab\Z', 'ab' ~ '^ab$', 'a b' ~ 'a\yb'
----
t t f

# 先頭のオプション
query ????
SELECT 'ABC' ~ '(?i)abc', 'ABC' ~ '(?c)abc', 'a b' ~ '(?x)a b', 'ab' ~ '(?x) a b '
----
t f f t

query ???
SELECT E'a\nb' ~ 'a.b', E'a\nb' ~ '(?n)a.b', E'a\nb' ~ '(?n)^b'
----
t f t

query ??
SELECT E'a\n' ~ 'a$', E'a\nb' ~ '^b'
----
f f

# 非 ASCII
query ???
SELECT 'é' ~ '.', 'é' ~ '^.$', 'あい' ~ '^..$'
----
t t t

query ??
SELECT 'é' ~ '\w', 'é' ~* 'É'
----
f f

# 型: text / name / bpchar / varchar
query ????
SELECT 'abc'::name ~ '^abc$', 'abc'::name !~ 'x', 'ABC'::name ~* 'abc', 'ABC'::name !~* 'abc'
----
t t t f

query ????
SELECT 'abc'::varchar ~ 'b', 'abc'::varchar !~ 'b', 'abc'::char(5) ~ 'c  $', 'abc'::char(5) ~ 'c$'
----
t f t f

query ??
SELECT 'abc'::char(5) !~ 'c$', 'ABC'::char(5) ~* '^abc  $'
----
t t

query TTTT
SELECT pg_typeof('a' ~ 'a'), pg_typeof('a'::name ~ 'a'), pg_typeof('a'::char(2) ~ 'a'), pg_typeof('a' !~* 'a')
----
boolean boolean boolean boolean

# 列に対して
statement ok
CREATE TABLE ty_rx_t (id int, s text, n name, c char(12))

statement ok
INSERT INTO ty_rx_t VALUES (1, 'foo', 'foo', 'foo'), (2, 'foobar', 'foobar', 'foobar'), (3, 'xfoo', 'xfoo', 'xfoo'), (4, 'Foo', 'Foo', 'Foo'), (5, NULL, NULL, NULL), (6, '', '', ''), (7, 'tbl_42', 'tbl_42', 'tbl_42'), (8, 'pg_catalog', 'pg_catalog', 'pg_catalog')

query I
SELECT id FROM ty_rx_t WHERE s ~ '^foo' ORDER BY id
----
1
2

query I
SELECT id FROM ty_rx_t WHERE s ~* '^foo' ORDER BY id
----
1
2
4

query I
SELECT id FROM ty_rx_t WHERE s !~ '^foo' ORDER BY id
----
3
4
6
7
8

query I
SELECT id FROM ty_rx_t WHERE n ~ 'foo$' ORDER BY id
----
1
3

query I
SELECT id FROM ty_rx_t WHERE c ~ 'o +$' ORDER BY id
----
1
3
4

query I
SELECT id FROM ty_rx_t WHERE s ~ '' ORDER BY id
----
1
2
3
4
6
7
8

query I
SELECT id FROM ty_rx_t WHERE s ~ s ORDER BY id
----
1
2
3
4
6
7
8

# psql が作るパターン
query I
SELECT id FROM ty_rx_t WHERE s ~ '^(foo.*)$' ORDER BY id
----
1
2

query I
SELECT id FROM ty_rx_t WHERE s ~ '^(foo.)$' ORDER BY id
----

query I
SELECT id FROM ty_rx_t WHERE s ~ '^(tbl_[0-9]+)$' ORDER BY id
----
7

query I
SELECT id FROM ty_rx_t WHERE n OPERATOR(pg_catalog.~) '^(foo.*)$' COLLATE pg_catalog.default ORDER BY id
----
1
2

query I
SELECT id FROM ty_rx_t WHERE n !~ '^pg_' ORDER BY id
----
1
2
3
4
6
7

query I
SELECT id FROM ty_rx_t WHERE n !~ '^pg_toast' AND n <> 'information_schema' ORDER BY id
----
1
2
3
4
6
7
8

