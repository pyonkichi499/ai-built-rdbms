----
4713-01-01 00:00:00 BC 294276-12-31 23:59:59.999999

query ?
SELECT '2000-02-29'::date
----
2000-02-29

# タイムゾーンつきの入力
query ????
SELECT '2024-03-15 12:00:00+09'::timestamptz, '2024-03-15 12:00:00-05'::timestamptz, '2024-03-15 12:00:00 Asia/Tokyo'::timestamptz, '2024-03-15 12:00:00+05:30'::timestamptz
----
2024-03-15 03:00:00+00 2024-03-15 17:00:00+00 2024-03-15 03:00:00+00 2024-03-15 06:30:00+00

query ??
SELECT '2024-03-15 12:00:00+09'::timestamp, '2024-03-15 12:00:00 America/New_York'::timestamp
----
2024-03-15 12:00:00 2024-03-15 12:00:00

query ??
SELECT '2024-03-15 12:00:00'::timestamptz, '2024-03-15'::timestamptz
----
2024-03-15 12:00:00+00 2024-03-15 00:00:00+00

# 型
query TTT
SELECT pg_typeof('2024-03-15'::date), pg_typeof('2024-03-15'::timestamp), pg_typeof('2024-03-15'::timestamptz)
----
date timestamp without time zone timestamp with time zone

query TTT
SELECT pg_typeof('2024-03-15'::timestamp(3)), pg_typeof(now()), pg_typeof(CURRENT_DATE)
----
timestamp without time zone timestamp with time zone date

query TT
SELECT pg_typeof(CURRENT_TIMESTAMP), pg_typeof(LOCALTIMESTAMP)
----
timestamp with time zone timestamp without time zone

