query ??
SELECT 'infinity'::date + 1, '-infinity'::date - 1
----
infinity -infinity

# 日付 date の列
statement ok
CREATE TABLE ty_dt_t (id int, d date, ts timestamp, tz timestamptz, ts0 timestamp(0), ts3 timestamp(3), tz0 timestamptz(0))

statement ok
INSERT INTO ty_dt_t VALUES (1, '2024-03-15', '2024-03-15 10:00:00', '2024-03-15 10:00:00+00', '2024-03-15 10:00:00.5', '2024-03-15 10:00:00.1236', '2024-03-15 10:00:00.5+00')

statement ok
INSERT INTO ty_dt_t VALUES (2, '2024-01-01', '2023-12-31 23:59:59.999999', '2023-12-31 23:59:59.999999+00', '2023-12-31 23:59:59.4', '2023-12-31 23:59:59.9996', '2023-12-31 23:59:59.4+00')

statement ok
INSERT INTO ty_dt_t VALUES (3, NULL, NULL, NULL, NULL, NULL, NULL), (4, 'infinity', 'infinity', 'infinity', 'infinity', 'infinity', 'infinity'), (5, '-infinity', '-infinity', '-infinity', '-infinity', '-infinity', '-infinity')

query I?
SELECT id, d FROM ty_dt_t ORDER BY d NULLS FIRST, id
----
3 NULL
5 -infinity
2 2024-01-01
1 2024-03-15
4 infinity

query I?
SELECT id, ts FROM ty_dt_t ORDER BY ts DESC, id
----
3 NULL
4 infinity
1 2024-03-15 10:00:00
2 2023-12-31 23:59:59.999999
5 -infinity

query I?
SELECT id, tz FROM ty_dt_t ORDER BY tz, id
----
5 -infinity
2 2023-12-31 23:59:59.999999+00
1 2024-03-15 10:00:00+00
4 infinity
3 NULL

query I??
SELECT id, ts0, tz0 FROM ty_dt_t ORDER BY id
----
1 2024-03-15 10:00:01 2024-03-15 10:00:01+00
2 2023-12-31 23:59:59 2023-12-31 23:59:59+00
3 NULL NULL
4 infinity infinity
5 -infinity -infinity

query I?
SELECT id, ts3 FROM ty_dt_t ORDER BY id
----
1 2024-03-15 10:00:00.124
2 2024-01-01 00:00:00
3 NULL
4 infinity
5 -infinity

# timestamp(0) の丸めが日付をまたぐ
statement ok
INSERT INTO ty_dt_t (id, ts0) VALUES (6, '2024-12-31 23:59:59.6')

query ?
SELECT ts0 FROM ty_dt_t WHERE id = 6
----
2025-01-01 00:00:00

# min / max（infinity を含む）
query ??
SELECT min(d), max(d) FROM ty_dt_t
----
-infinity infinity

query ??
SELECT min(ts), max(ts) FROM ty_dt_t WHERE ts < 'infinity' AND ts > '-infinity'
----
2023-12-31 23:59:59.999999 2024-03-15 10:00:00

query ??
SELECT min(tz), max(tz) FROM ty_dt_t
----
-infinity infinity

query ??
SELECT pg_typeof(min(d)), pg_typeof(max(ts)) FROM ty_dt_t
----
date timestamp without time zone

# 範囲検索とグルーピング
query I
SELECT id FROM ty_dt_t WHERE d BETWEEN '2024-01-01' AND '2024-12-31' ORDER BY id
----
1
2

query I
SELECT id FROM ty_dt_t WHERE ts >= '2024-01-01' AND ts < 'infinity' ORDER BY id
----
1

query I
SELECT count(*) FROM (SELECT DISTINCT d FROM ty_dt_t) x
----
5

query ?I
SELECT d, count(*) FROM ty_dt_t GROUP BY d ORDER BY d NULLS LAST
----
-infinity 1
2024-01-01 1
2024-03-15 1
infinity 1
NULL 2

query I
SELECT id FROM ty_dt_t WHERE d = '2024-01-01' ORDER BY id
----
2

query I
SELECT id FROM ty_dt_t WHERE d IN ('2024-01-01', '2024-03-15') ORDER BY id
----
1
2

query I
SELECT id FROM ty_dt_t WHERE tz = '2024-03-15 19:00:00+09' ORDER BY id
----
1

# date の列と date の演算
query I?
SELECT id, d + 10 FROM ty_dt_t WHERE d BETWEEN '2024-01-01' AND '2024-12-31' ORDER BY id
----
1 2024-03-25
2 2024-01-11

query II
SELECT id, d - '2024-01-01'::date FROM ty_dt_t WHERE d BETWEEN '2024-01-01' AND '2024-12-31' ORDER BY id
----
1 74
2 0

# timestamptz を timestamp / date の列へ代入する（CURRENT_TIMESTAMP は pgbench が使う）
statement ok
INSERT INTO ty_dt_t (id, ts, d) VALUES (7, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)

statement ok
INSERT INTO ty_dt_t (id, ts, d, ts0) VALUES (8, now(), now(), LOCALTIMESTAMP)

query I
SELECT count(*) FROM ty_dt_t WHERE id IN (7, 8) AND ts IS NOT NULL AND d IS NOT NULL
----
2

query T
SELECT pg_typeof(ts) FROM ty_dt_t WHERE id = 7
----
timestamp without time zone

query ?
SELECT d IS NOT NULL AND ts IS NOT NULL FROM ty_dt_t WHERE id = 7
----
t

statement ok
UPDATE ty_dt_t SET ts = '2024-03-15 10:00:00+09'::timestamptz WHERE id = 7

query ?
SELECT ts FROM ty_dt_t WHERE id = 7
----
2024-03-15 01:00:00

