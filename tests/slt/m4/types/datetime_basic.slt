# date / timestamp / timestamptz の入出力、比較、date の加減算、列への代入、min / max
# interval を使う演算は M5（KD-1）

statement ok
SET TIME ZONE 'UTC'

statement ok
SET DateStyle = 'ISO, MDY'

# 入力と出力
query ???
SELECT '2024-03-15'::date, '2024-03-15 12:34:56'::timestamp, '2024-03-15 12:34:56+00'::timestamptz
----
2024-03-15 2024-03-15 12:34:56 2024-03-15 12:34:56+00

query ???
SELECT '3/15/2024'::date, 'March 15, 2024'::date, '20240315'::date
----
2024-03-15 2024-03-15 2024-03-15

query ???
SELECT '2024-03-15 12:34:56.789'::timestamp, '2024-03-15 12:34:56.1234565'::timestamp, '2024-03-15 12:34:56.999999'::timestamp
----
2024-03-15 12:34:56.789 2024-03-15 12:34:56.123456 2024-03-15 12:34:56.999999

query ??
SELECT '2024-03-15 12:34:56.9999996'::timestamp, '2024-03-15 23:59:59.9999999'::timestamp
----
2024-03-15 12:34:57 2024-03-16 00:00:00

query ??
SELECT '2024-03-15 12:34'::timestamp, '2024-03-15 12:34:56'::timestamp(0)
----
2024-03-15 12:34:00 2024-03-15 12:34:56

query ??
SELECT '2024-03-15 12:34:56.5'::timestamp(0), '2024-03-15 12:34:56.4'::timestamp(0)
----
2024-03-15 12:34:57 2024-03-15 12:34:56

query ??
SELECT '2024-03-15 12:34:56.123456'::timestamp(3), '2024-03-15 12:34:56.123456'::timestamp(1)
----
2024-03-15 12:34:56.123 2024-03-15 12:34:56.1

# 特殊な値
query ?????
SELECT 'infinity'::date, '-infinity'::date, 'infinity'::timestamp, '-infinity'::timestamp, 'epoch'::timestamp
----
infinity -infinity infinity -infinity 1970-01-01 00:00:00

query ??
SELECT 'infinity'::timestamptz, '-infinity'::timestamptz
----
infinity -infinity

query ??
SELECT 'epoch'::date, 'epoch'::timestamptz
----
1970-01-01 1970-01-01 00:00:00+00

