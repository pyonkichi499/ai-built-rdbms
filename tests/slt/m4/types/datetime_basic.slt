----
2024-03-16 2024-03-14 2024-03-16 2024-03-15

query ????
SELECT '2024-02-28'::date + 2, '2024-03-01'::date - 1, '2023-12-31'::date + 1, '2024-12-31'::date + 366
----
2024-03-01 2024-02-29 2024-01-01 2026-01-01

query ?????
SELECT '2024-03-15'::date - '2024-03-01'::date, '2024-03-01'::date - '2024-03-15'::date, '2025-03-15'::date - '2024-03-15'::date, '2024-03-15'::date - '2024-03-15'::date, '2000-01-01'::date - '1999-01-01'::date
----
14 -14 365 0 365

query TTT
SELECT pg_typeof('2024-03-15'::date + 1), pg_typeof('2024-03-15'::date - '2024-03-01'::date), pg_typeof(1 + '2024-03-15'::date)
----
date integer date

