# pg_typeof
query TTTTT
SELECT pg_typeof(1), pg_typeof(1::int8), pg_typeof(1.5), pg_typeof('a'), pg_typeof(NULL)
----
integer bigint numeric unknown unknown

query TTTT
SELECT pg_typeof(true), pg_typeof('a'::text), pg_typeof('a'::varchar), pg_typeof(1.5::float8)
----
boolean text character varying double precision

query ??
SELECT pg_typeof(1)::text, pg_typeof(pg_typeof(1))
----
integer regtype

# カタログとの結合
query TT
SELECT t.typname, t.oid::regtype::text FROM pg_type t WHERE t.oid IN ('int4'::regtype, 'text'::regtype, 'numeric'::regtype) ORDER BY t.oid
----
int4 integer
text text
numeric numeric
