# BT_MAX_ITEM_SIZE の境界。圧縮されない値（乱数の 16 進文字列。slttools large-keys と同じ性質）を使う

statement ok
CREATE TABLE idx_lk_a (a text)

statement ok
CREATE INDEX idx_lk_a_i ON idx_lk_a (a)

statement ok
CREATE TABLE idx_lk_b (a int, b text)

statement ok
CREATE INDEX idx_lk_b_i ON idx_lk_b (a, b)

# (a text): 2692 バイトまで成功、2693 で 54000
statement ok
INSERT INTO idx_lk_a VALUES ('')

statement error (54000)
INSERT INTO idx_lk_a VALUES ('')

statement error (?s)index row size 2712 exceeds btree version 4 maximum 2704 for index "idx_lk_a_i"
INSERT INTO idx_lk_a VALUES ('')

# (a int, b text): a = 1 なら 2688 まで、a = NULL なら 2684 まで
statement ok
INSERT INTO idx_lk_b VALUES (1, '')

statement error (54000)
INSERT INTO idx_lk_b VALUES (1, '')

statement ok
INSERT INTO idx_lk_b VALUES (NULL, '')

statement error (54000)
INSERT INTO idx_lk_b VALUES (NULL, '')

# 失敗した行は残らない
query II
SELECT count(*), max(length(a)) FROM idx_lk_a
----
1 2692

query I
SELECT count(*) FROM idx_lk_b
----
2

