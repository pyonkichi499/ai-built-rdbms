# 既存の行がある表への CREATE INDEX の後
statement ok
CREATE INDEX idx_dm_d ON idx_dm_t (d)

statement ok
SET enable_seqscan = off

query I
SELECT id FROM idx_dm_t WHERE d = DATE '2024-01-06' ORDER BY id
----
5

query I
SELECT id FROM idx_dm_t WHERE d >= DATE '2024-01-15' ORDER BY d, id
----
15
16
17
18
20
23

query I
SELECT id FROM idx_dm_t WHERE d IS NULL ORDER BY id
----
4
22
100

statement ok
RESET enable_seqscan

query I
SELECT id FROM idx_dm_t WHERE d = DATE '2024-01-06' ORDER BY id
----
5

query I
SELECT id FROM idx_dm_t WHERE d >= DATE '2024-01-15' ORDER BY d, id
----
15
16
17
18
20
23

query I
SELECT id FROM idx_dm_t WHERE d IS NULL ORDER BY id
----
