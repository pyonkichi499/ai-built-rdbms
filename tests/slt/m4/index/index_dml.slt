22
100

# 全行を消して、入れ直す
statement ok
DELETE FROM idx_dm_t

query I
SELECT id FROM idx_dm_t WHERE k = 1
----

statement count 5
INSERT INTO idx_dm_t SELECT g, g, 's' || g, NULL FROM generate_series(1, 5) g

statement ok
SET enable_seqscan = off

query I
SELECT id FROM idx_dm_t WHERE k >= 2 ORDER BY k
----
2
3
4
5

statement ok
RESET enable_seqscan

statement ok
DROP TABLE idx_dm_t
