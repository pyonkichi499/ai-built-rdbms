DROP INDEX IF EXISTS idx_ce_i

# KNOWN-DIFF: KD-30 INCLUDE 列は yuzhu では未対応
onlyif yuzhu
statement error (0A000)
CREATE INDEX idx_ce_i ON idx_ce_t (a) INCLUDE (b)

