onlyif yuzhu
statement error (0A000)
CREATE INDEX idx_ce_x ON idx_ce_t ((a + 1))

# KNOWN-DIFF: KD-30 部分索引は yuzhu では未対応
skipif yuzhu
statement ok
CREATE INDEX idx_ce_p ON idx_ce_t (a) WHERE a > 0

statement ok
DROP INDEX IF EXISTS idx_ce_p

# KNOWN-DIFF: KD-30 部分索引は yuzhu では未対応
onlyif yuzhu
statement error (0A000)
CREATE INDEX idx_ce_p ON idx_ce_t (a) WHERE a > 0

