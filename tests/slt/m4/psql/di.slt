# psql 17 の \di が送る SQL（自分のインデックスだけに絞る）

statement ok
CREATE TABLE psql_t_i1 (id int PRIMARY KEY, a int, b text)

statement ok
CREATE TABLE psql_t_i2 (k text UNIQUE, v int)

statement ok
CREATE UNIQUE INDEX psql_t_i1_a_idx ON psql_t_i1 (a)

statement ok
CREATE INDEX psql_t_i1_b_idx ON psql_t_i1 (b DESC, a)

query TTTTT
SELECT n.nspname as "Schema",
  c.relname as "Name",
  CASE c.relkind WHEN 'r' THEN 'table' WHEN 'v' THEN 'view' WHEN 'm' THEN 'materialized view' WHEN 'i' THEN 'index' WHEN 'S' THEN 'sequence' WHEN 't' THEN 'TOAST table' WHEN 'f' THEN 'foreign table' WHEN 'p' THEN 'partitioned table' WHEN 'I' THEN 'partitioned index' END as "Type",
  pg_catalog.pg_get_userbyid(c.relowner) as "Owner",
  c2.relname as "Table"
FROM pg_catalog.pg_class c
     LEFT JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
     LEFT JOIN pg_catalog.pg_am am ON am.oid = c.relam
     LEFT JOIN pg_catalog.pg_index i ON i.indexrelid = c.oid
     LEFT JOIN pg_catalog.pg_class c2 ON i.indrelid = c2.oid
WHERE c.relkind IN ('i','I','')
      AND n.nspname <> 'pg_catalog'
      AND n.nspname !~ '^pg_toast'
      AND n.nspname <> 'information_schema'
  AND pg_catalog.pg_table_is_visible(c.oid)
  AND c.relname LIKE 'psql\_t\_%'
ORDER BY 1,2
----
public psql_t_i1_a_idx index postgres psql_t_i1
public psql_t_i1_b_idx index postgres psql_t_i1
public psql_t_i1_pkey index postgres psql_t_i1
public psql_t_i2_k_key index postgres psql_t_i2

# パターンつき（\di psql_t_i1*）
query TTTTT
SELECT n.nspname as "Schema",
  c.relname as "Name",
  CASE c.relkind WHEN 'r' THEN 'table' WHEN 'v' THEN 'view' WHEN 'm' THEN 'materialized view' WHEN 'i' THEN 'index' WHEN 'S' THEN 'sequence' WHEN 't' THEN 'TOAST table' WHEN 'f' THEN 'foreign table' WHEN 'p' THEN 'partitioned table' WHEN 'I' THEN 'partitioned index' END as "Type",
  pg_catalog.pg_get_userbyid(c.relowner) as "Owner",
  c2.relname as "Table"
FROM pg_catalog.pg_class c
     LEFT JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
     LEFT JOIN pg_catalog.pg_am am ON am.oid = c.relam
     LEFT JOIN pg_catalog.pg_index i ON i.indexrelid = c.oid
     LEFT JOIN pg_catalog.pg_class c2 ON i.indrelid = c2.oid
WHERE c.relkind IN ('i','I','')
  AND c.relname OPERATOR(pg_catalog.~) '^(psql_t_i1.*)$' COLLATE pg_catalog.default
  AND pg_catalog.pg_table_is_visible(c.oid)
ORDER BY 1,2
----
public psql_t_i1_a_idx index postgres psql_t_i1
public psql_t_i1_b_idx index postgres psql_t_i1
public psql_t_i1_pkey index postgres psql_t_i1

# \dt には索引が出ない
query T
SELECT c.relname
FROM pg_catalog.pg_class c LEFT JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
WHERE c.relkind IN ('r','p','') AND n.nspname <> 'pg_catalog' AND n.nspname !~ '^pg_toast' AND n.nspname <> 'information_schema'
  AND pg_catalog.pg_table_is_visible(c.oid) AND c.relname LIKE 'psql\_t\_%'
ORDER BY 1
----
psql_t_i1
psql_t_i2

statement ok
DROP INDEX psql_t_i1_a_idx

query T
SELECT c.relname
FROM pg_catalog.pg_class c LEFT JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
WHERE c.relkind IN ('i','I','') AND n.nspname <> 'pg_catalog' AND n.nspname !~ '^pg_toast' AND n.nspname <> 'information_schema'
  AND pg_catalog.pg_table_is_visible(c.oid) AND c.relname LIKE 'psql\_t\_%'
ORDER BY 1
----
psql_t_i1_b_idx
psql_t_i1_pkey
psql_t_i2_k_key

statement ok
