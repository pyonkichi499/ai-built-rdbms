# 引数 1 つの形は非 pretty と同じ
query ?
SELECT pg_get_constraintdef(oid) = pg_get_constraintdef(oid, false) FROM pg_constraint WHERE conrelid = 'ex_ds_t'::regclass AND conname = 'ex_ds_c01'
