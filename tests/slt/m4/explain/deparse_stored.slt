query T
SELECT conname || ' ## ' || pg_get_constraintdef(oid, false) || ' ## ' || pg_get_constraintdef(oid, true) FROM pg_constraint WHERE conrelid = 'ex_ds_t'::regclass ORDER BY conname
----
ex_ds_c01 ## CHECK ((i > 0)) ## CHECK (i > 0)
ex_ds_c02 ## CHECK ((((i + 1) + 2) > 0)) ## CHECK ((i + 1 + 2) > 0)
ex_ds_c03 ## CHECK (((i + (1 * 2)) > 3)) ## CHECK ((i + 1 * 2) > 3)
ex_ds_c04 ## CHECK ((((i + 1) * 2) > 3)) ## CHECK (((i + 1) * 2) > 3)
ex_ds_c05 ## CHECK (((i - (1 - 2)) > 0)) ## CHECK ((i - (1 - 2)) > 0)
ex_ds_c06 ## CHECK ((((i - 1) - 2) > 0)) ## CHECK ((i - 1 - 2) > 0)
ex_ds_c07 ## CHECK (((- i) < 0)) ## CHECK ((- i) < 0)
ex_ds_c08 ## CHECK (((i / (2 * 3)) > 0)) ## CHECK ((i / (2 * 3)) > 0)
ex_ds_c09 ## CHECK ((((i % 2) * 3) > 0)) ## CHECK ((i % 2 * 3) > 0)
ex_ds_c10 ## CHECK ((i = (bi + 1))) ## CHECK (i = (bi + 1))
ex_ds_c11 ## CHECK ((t = 'abc'::text)) ## CHECK (t = 'abc'::text)
ex_ds_c12 ## CHECK (((v)::text = 'x'::text)) ## CHECK (v::text = 'x'::text)
ex_ds_c13 ## CHECK ((c = 'ab'::bpchar)) ## CHECK (c = 'ab'::bpchar)
ex_ds_c14 ## CHECK (((t || 'x'::text) = 'yx'::text)) ## CHECK ((t || 'x'::text) = 'yx'::text)
ex_ds_c15 ## CHECK ((lower(t) = 'abc'::text)) ## CHECK (lower(t) = 'abc'::text)
ex_ds_c16 ## CHECK ((lower((t || 'a'::text)) = 'x'::text)) ## CHECK (lower(t || 'a'::text) = 'x'::text)
ex_ds_c17 ## CHECK ((t ~~ 'a%'::text)) ## CHECK (t ~~ 'a%'::text)
ex_ds_c18 ## CHECK ((t !~~* 'a%'::text)) ## CHECK (t !~~* 'a%'::text)
ex_ds_c19 ## CHECK ((t ~ '^a'::text)) ## CHECK (t ~ '^a'::text)
ex_ds_c20 ## CHECK ((i = ANY (ARRAY[1, 2, 3]))) ## CHECK (i = ANY (ARRAY[1, 2, 3]))
ex_ds_c21 ## CHECK ((i <> ALL (ARRAY[1, 2, 3]))) ## CHECK (i <> ALL (ARRAY[1, 2, 3]))
ex_ds_c22 ## CHECK ((i = 1)) ## CHECK (i = 1)
ex_ds_c23 ## CHECK (((i = 1) OR (i = bi))) ## CHECK (i = 1 OR i = bi)
ex_ds_c24 ## CHECK ((i = ANY (ARRAY[1, NULL::integer]))) ## CHECK (i = ANY (ARRAY[1, NULL::integer]))
ex_ds_c25 ## CHECK (((i >= 1) AND (i <= 5))) ## CHECK (i >= 1 AND i <= 5)
ex_ds_c26 ## CHECK (((i < 1) OR (i > 5))) ## CHECK (i < 1 OR i > 5)
ex_ds_c27 ## CHECK ((t IS NULL)) ## CHECK (t IS NULL)
ex_ds_c28 ## CHECK ((t IS NOT NULL)) ## CHECK (t IS NOT NULL)
ex_ds_c29 ## CHECK ((b IS NOT TRUE)) ## CHECK (b IS NOT TRUE)
ex_ds_c30 ## CHECK (b) ## CHECK (b)
ex_ds_c31 ## CHECK ((NOT b)) ## CHECK (NOT b)
ex_ds_c32 ## CHECK ((b AND (i > 1))) ## CHECK (b AND i > 1)
ex_ds_c33 ## CHECK (((b AND (i > 1)) OR (i < 0))) ## CHECK (b AND i > 1 OR i < 0)
ex_ds_c34 ## CHECK ((b AND ((i > 1) OR (i < 0)))) ## CHECK (b AND (i > 1 OR i < 0))
ex_ds_c35 ## CHECK ((NOT (b AND (i > 1)))) ## CHECK (NOT (b AND i > 1))
ex_ds_c36 ## CHECK ((NOT (i > 1))) ## CHECK (NOT i > 1)
ex_ds_c37 ## CHECK (((NOT b) AND b)) ## CHECK (NOT b AND b)
ex_ds_c38 ## CHECK ((NOT (NOT b))) ## CHECK (NOT (NOT b))
ex_ds_c39 ## CHECK ((b AND (b AND b))) ## CHECK (b AND b AND b)
ex_ds_c40 ## CHECK (((b OR b) AND (b OR b))) ## CHECK ((b OR b) AND (b OR b))
ex_ds_c41 ## CHECK (((i > 0) = (bi > 0))) ## CHECK ((i > 0) = (bi > 0))
ex_ds_c42 ## CHECK (((i + 1) IS NULL)) ## CHECK ((i + 1) IS NULL)
ex_ds_c43 ## CHECK ((((i + 1))::text IS NULL)) ## CHECK (((i + 1)::text) IS NULL)
ex_ds_c44 ## CHECK ((COALESCE((b AND b), true) = b)) ## CHECK (COALESCE(b AND b, true) = b)
ex_ds_c45 ## CHECK ((COALESCE(t, (v)::text, 'z'::text) = 'q'::text)) ## CHECK (COALESCE(t, v::text, 'z'::text) = 'q'::text)
ex_ds_c46 ## CHECK ((NULLIF(i, 0) = 1)) ## CHECK (NULLIF(i, 0) = 1)
ex_ds_c47 ## CHECK (((i)::bigint > 1)) ## CHECK (i::bigint > 1)
ex_ds_c48 ## CHECK ((((i + 1))::bigint > 0)) ## CHECK ((i + 1)::bigint > 0)
ex_ds_c49 ## CHECK ((((i)::bigint)::text = t)) ## CHECK (i::bigint::text = t)
ex_ds_c50 ## CHECK (((i)::numeric > 1.5)) ## CHECK (i::numeric > 1.5)
ex_ds_c51 ## CHECK ((n > (1)::numeric)) ## CHECK (n > 1::numeric)
ex_ds_c52 ## CHECK ((n = 1.50)) ## CHECK (n = 1.50)
ex_ds_c53 ## CHECK ((f > (1)::double precision)) ## CHECK (f > 1::double precision)
ex_ds_c54 ## CHECK ((f > 'Infinity'::double precision)) ## CHECK (f > 'Infinity'::double precision)
ex_ds_c55 ## CHECK ((i > '-1'::integer)) ## CHECK (i > '-1'::integer)
ex_ds_c56 ## CHECK ((i > '2147483648'::bigint)) ## CHECK (i > '2147483648'::bigint)
ex_ds_c57 ## CHECK ((i > (1)::bigint)) ## CHECK (i > 1::bigint)
ex_ds_c58 ## CHECK ((d > '2020-01-01'::date)) ## CHECK (d > '2020-01-01'::date)
ex_ds_c59 ## CHECK ((ts > '2020-01-01 10:00:00'::timestamp without time zone)) ## CHECK (ts > '2020-01-01 10:00:00'::timestamp without time zone)
ex_ds_c60 ## CHECK ((tz > '2020-01-01 10:00:00+00'::timestamp with time zone)) ## CHECK (tz > '2020-01-01 10:00:00+00'::timestamp with time zone)
ex_ds_c61 ## CHECK ((tz > now())) ## CHECK (tz > now())
ex_ds_c62 ## CHECK ((tz > CURRENT_TIMESTAMP)) ## CHECK (tz > CURRENT_TIMESTAMP)
ex_ds_c63 ## CHECK ((d > CURRENT_DATE)) ## CHECK (d > CURRENT_DATE)
ex_ds_c64 ## CHECK (((ts)::date = d)) ## CHECK (ts::date = d)
ex_ds_c65 ## CHECK ((t = ''::text)) ## CHECK (t = ''::text)
ex_ds_c66 ## CHECK ((t = 'it''s'::text)) ## CHECK (t = 'it''s'::text)
