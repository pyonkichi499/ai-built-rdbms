statement ok
DROP TABLE ex_ds_t

# DEFAULT 式（pg_get_expr）
statement ok
CREATE SEQUENCE ex_ds_s

statement ok
CREATE TABLE ex_ds_d (
  x bigint DEFAULT 1,
  w varchar(5) DEFAULT 'ab',
  z text DEFAULT 'a',
  h int DEFAULT -1,
  i int DEFAULT 1+2,
  n text DEFAULT 'a'||'b',
  p bigint DEFAULT (1)::bigint,
  q int DEFAULT nextval('ex_ds_s'),
  t timestamp DEFAULT now(),
  t2 timestamp DEFAULT current_timestamp,
  e int
)

query T
SELECT a.attname || ' ## ' || pg_get_expr(d.adbin, d.adrelid) || ' ## ' || pg_get_expr(d.adbin, d.adrelid, true) FROM pg_attrdef d JOIN pg_attribute a ON a.attrelid = d.adrelid AND a.attnum = d.adnum WHERE d.adrelid = 'ex_ds_d'::regclass ORDER BY a.attnum
----
x ## 1 ## 1
w ## 'ab'::character varying ## 'ab'::character varying
z ## 'a'::text ## 'a'::text
h ## '-1'::integer ## '-1'::integer
i ## (1 + 2) ## 1 + 2
n ## ('a'::text || 'b'::text) ## 'a'::text || 'b'::text
p ## (1)::bigint ## 1::bigint
q ## nextval('ex_ds_s'::regclass) ## nextval('ex_ds_s'::regclass)
t ## now() ## now()
t2 ## CURRENT_TIMESTAMP ## CURRENT_TIMESTAMP

statement ok
DROP TABLE ex_ds_d

statement ok
DROP SEQUENCE ex_ds_s
