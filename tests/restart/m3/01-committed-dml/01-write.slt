# フェーズ 1: CREATE / INSERT / UPDATE / DELETE をコミットして、そのまま kill -9 される。

statement ok
CREATE TABLE cr1_t (id int NOT NULL, v text)

statement count 5
INSERT INTO cr1_t VALUES (1, 'a'), (2, 'b'), (3, 'c'), (4, 'd'), (5, 'e')

statement count 2
UPDATE cr1_t SET v = v || v WHERE id IN (2, 4)

statement count 1
DELETE FROM cr1_t WHERE id = 5

statement ok
BEGIN

statement count 1
INSERT INTO cr1_t VALUES (6, 'f')

statement ok
COMMIT

query IT
SELECT id, v FROM cr1_t ORDER BY id
----
1 a
2 bb
3 c
4 dd
6 f
