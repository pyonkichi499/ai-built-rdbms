# フェーズ 1: DDL の途中（トランザクションブロックの中）で kill -9 される。
# 別の接続で CREATE TABLE（INSERT 付き）と DROP TABLE を実行したまま、コミットしない。

statement ok
CREATE TABLE cr7_keep (id int NOT NULL, v text)

statement count 3
INSERT INTO cr7_keep VALUES (1, 'a'), (2, 'b'), (3, 'c')

statement ok
CREATE TABLE cr7_drop_pending (id int)

statement count 2
INSERT INTO cr7_drop_pending VALUES (10), (20)

connection other
statement ok
BEGIN

connection other
statement ok
CREATE TABLE cr7_ghost (g int)

connection other
statement count 2
INSERT INTO cr7_ghost VALUES (1), (2)

connection other
statement ok
DROP TABLE cr7_drop_pending

connection other
statement error (42P01)
SELECT id FROM cr7_drop_pending
