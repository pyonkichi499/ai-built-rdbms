# フェーズ 2: 未コミットの CREATE TABLE のテーブルはなく、未コミットの DROP TABLE のテーブルは中身ごと残っている。

statement error (42P01)
SELECT g FROM cr7_ghost

query T
SELECT relname FROM pg_class WHERE relname LIKE 'cr7\_%' ORDER BY relname
----
cr7_drop_pending
cr7_keep

query I
SELECT id FROM cr7_drop_pending ORDER BY id
----
10
20

query IT
SELECT id, v FROM cr7_keep ORDER BY id
----
1 a
2 b
3 c

# 同名のテーブルを作れる（OID・ファイル名が衝突しない）
statement ok
CREATE TABLE cr7_ghost (g text)

statement count 1
INSERT INTO cr7_ghost VALUES ('real')

# コミットした DROP は次のクラッシュのあとも消えている
statement ok
DROP TABLE cr7_drop_pending
