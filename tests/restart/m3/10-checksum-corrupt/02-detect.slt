# フェーズ 2: 壊れたページを読むと XX001 になり、黙って値を返さない。ほかのテーブルは読める。
# サーバはチェックサム不一致で落ちない（ERROR で接続が続く）。

statement error (XX001)
SELECT id, v FROM cr10_bad

statement error (XX001)
SELECT id FROM cr10_bad WHERE id = 2

statement error (XX001)
INSERT INTO cr10_bad VALUES (4, 'd')

statement error (XX001)
UPDATE cr10_bad SET v = 'z'

# 接続は生きていて、壊れていないテーブルは読み書きできる
query IT
SELECT id, v FROM cr10_ok ORDER BY id
----
1 x
2 y

statement count 1
INSERT INTO cr10_ok VALUES (3, 'z')

# 壊れたテーブルも DROP はできる（ページを読まない）
statement ok
DROP TABLE cr10_bad

statement error (42P01)
SELECT id FROM cr10_bad

statement ok
CHECKPOINT
