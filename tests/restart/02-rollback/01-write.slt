# フェーズ 1: コミットした変更と ROLLBACK した変更を交互に行う。

statement ok
CREATE TABLE rs2_t (id int, v text)

statement ok
INSERT INTO rs2_t VALUES (1, 'a'), (2, 'b'), (3, 'c')

# ROLLBACK した UPDATE / DELETE / INSERT
statement ok
BEGIN

statement count 3
UPDATE rs2_t SET v = 'rolled-back'

statement count 1
DELETE FROM rs2_t WHERE id = 1

statement ok
INSERT INTO rs2_t VALUES (9, 'rolled-back')

statement ok
ROLLBACK

query IT
SELECT id, v FROM rs2_t ORDER BY id
----
1 a
2 b
3 c

# 間にコミットを挟む（XID が連続しない）
statement count 1
UPDATE rs2_t SET v = 'committed' WHERE id = 2

statement ok
BEGIN

statement count 1
UPDATE rs2_t SET v = 'rolled-back-2' WHERE id = 2

statement ok
ROLLBACK

statement ok
INSERT INTO rs2_t VALUES (4, 'd')

# 失敗した文を含むブロックは中断される
statement ok
BEGIN

statement count 1
UPDATE rs2_t SET v = 'rolled-back-3' WHERE id = 3

statement error (22012)
SELECT 1 / 0

statement ok
COMMIT

query IT
SELECT id, v FROM rs2_t ORDER BY id
----
1 a
2 committed
3 c
4 d
