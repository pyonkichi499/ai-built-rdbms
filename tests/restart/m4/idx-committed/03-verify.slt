2 20 200 b
3 31 301 c
4 40 NULL d
5 NULL 500 e
6 NULL 600 NULL
7 70 700 g
8 10 800 reuse k

statement ok
SET enable_seqscan = off

query IIIT
SELECT id, k, w, v FROM m4r_ic_t WHERE w >= 301 ORDER BY w
----
3 31 301 c
5 NULL 500 e
6 NULL 600 NULL
7 70 700 g
8 10 800 reuse k

