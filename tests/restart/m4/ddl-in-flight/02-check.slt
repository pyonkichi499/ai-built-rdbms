# フェーズ 2: 索引も制約も作りかけの表もない。データは無事。同じ名前で再作成できる。

query T
SELECT relname FROM pg_class WHERE relname LIKE 'm4r\_df\_%' ORDER BY relname
----
m4r_df_a
m4r_df_b

query I
SELECT count(*) FROM pg_index WHERE indrelid IN ('m4r_df_a'::regclass, 'm4r_df_b'::regclass)
----
0

query I
SELECT count(*) FROM pg_constraint WHERE conname LIKE 'm4r\_df\_%'
----
0

query T
SELECT attnotnull::text FROM pg_attribute WHERE attrelid = 'm4r_df_b'::regclass AND attname = 'id'
----
false

query II
SELECT count(*), sum(id) FROM m4r_df_a
----
20000 200010000

query II
SELECT count(*), sum(id) FROM m4r_df_b
----
20000 200010000

# 重複は拒否されず、再作成できる
statement count 1
INSERT INTO m4r_df_b VALUES (1, 0, 'dup id is allowed without PK')

statement count 1
DELETE FROM m4r_df_b WHERE id = 1 AND pad <> repeat('x', 50)

statement ok
CREATE INDEX m4r_df_a_k ON m4r_df_a (k)

statement ok
ALTER TABLE m4r_df_b ADD PRIMARY KEY (id)

statement ok
CREATE TABLE m4r_df_c (id int PRIMARY KEY)

statement ok
SET enable_seqscan = off

query I
SELECT count(*) FROM m4r_df_a WHERE k = 5
----
200

statement ok
RESET enable_seqscan

statement error (23505)
INSERT INTO m4r_df_b VALUES (2, 0, 'dup')

statement ok
DROP TABLE m4r_df_a

statement ok
DROP TABLE m4r_df_b

statement ok
DROP TABLE m4r_df_c

query I
SELECT count(*) FROM pg_class WHERE relname LIKE 'm4r\_df\_%'
----
0

# --- カタログの整合（07 §8.3 の条件 1〜9。ユーザーオブジェクト oid >= 16384）---
query I
SELECT count(*) FROM pg_attribute a WHERE a.attrelid >= 16384 AND a.attrelid NOT IN (SELECT oid FROM pg_class)
----
0

query I
SELECT count(*) FROM pg_attrdef d WHERE d.adrelid >= 16384 AND d.adrelid NOT IN (SELECT oid FROM pg_class)
----
0

query I
SELECT count(*) FROM pg_constraint c WHERE c.conrelid <> 0 AND c.conrelid >= 16384 AND c.conrelid NOT IN (SELECT oid FROM pg_class)
----
0

query I
SELECT count(*) FROM pg_index i WHERE i.indexrelid >= 16384 AND (i.indrelid NOT IN (SELECT oid FROM pg_class) OR i.indexrelid NOT IN (SELECT oid FROM pg_class))
----
0

query I
SELECT count(*) FROM pg_index i WHERE i.indexrelid >= 16384 AND ((SELECT relkind::text FROM pg_class WHERE oid = i.indexrelid) <> 'i' OR (SELECT relkind::text FROM pg_class WHERE oid = i.indrelid) NOT IN ('r', 't'))
----
0

query I
SELECT count(*) FROM pg_class c WHERE c.oid >= 16384 AND c.relkind = 'i' AND c.oid NOT IN (SELECT indexrelid FROM pg_index)
----
0

query I
SELECT count(*) FROM pg_constraint c WHERE c.conrelid >= 16384 AND c.contype IN ('p', 'u') AND (c.conindid = 0 OR c.conindid NOT IN (SELECT indexrelid FROM pg_index WHERE indrelid = c.conrelid))
----
0

query I
SELECT count(*) FROM pg_constraint c WHERE c.conrelid >= 16384 AND c.contype IN ('p', 'u') AND (SELECT count(*) FROM pg_depend d WHERE d.classid = 'pg_class'::regclass AND d.objid = c.conindid AND d.refclassid = 'pg_constraint'::regclass AND d.refobjid = c.oid AND d.deptype = 'i') <> 1
----
0

query I
SELECT count(*) FROM pg_depend d WHERE d.classid = 'pg_class'::regclass AND d.refclassid <> 'pg_namespace'::regclass AND d.objid >= 16384 AND d.objid NOT IN (SELECT oid FROM pg_class)
----
0

query I
SELECT count(*) FROM pg_depend d WHERE d.refclassid = 'pg_class'::regclass AND d.refobjid >= 16384 AND d.refobjid NOT IN (SELECT oid FROM pg_class)
----
0

query I
SELECT count(*) FROM pg_depend d WHERE d.classid = 'pg_constraint'::regclass AND d.objid >= 16384 AND d.objid NOT IN (SELECT oid FROM pg_constraint)
----
0

query I
SELECT count(*) FROM pg_class c WHERE c.oid >= 16384 AND c.relkind = 'S' AND c.oid NOT IN (SELECT seqrelid FROM pg_sequence)
----
0

query I
SELECT count(*) FROM pg_sequence s WHERE s.seqrelid >= 16384 AND s.seqrelid NOT IN (SELECT oid FROM pg_class)
----
0

query I
SELECT count(*) FROM pg_class c WHERE c.oid >= 16384 AND c.relkind = 'r' AND c.relnatts <> (SELECT count(*) FROM pg_attribute a WHERE a.attrelid = c.oid AND a.attnum > 0 AND NOT a.attisdropped)
----
0

query I
SELECT count(*) FROM pg_class c WHERE c.oid >= 16384 AND c.relkind = 'r' AND c.relchecks <> (SELECT count(*) FROM pg_constraint k WHERE k.conrelid = c.oid AND k.contype = 'c')
----
0

query I
SELECT count(*) FROM pg_class c WHERE c.oid >= 16384 AND c.relkind = 'r' AND NOT c.relhasindex AND EXISTS (SELECT 1 FROM pg_index i WHERE i.indrelid = c.oid)
----
0

query I
SELECT count(*) FROM pg_attribute a WHERE a.attrelid >= 16384 AND a.attnum > 0 AND a.atthasdef AND NOT EXISTS (SELECT 1 FROM pg_attrdef d WHERE d.adrelid = a.attrelid AND d.adnum = a.attnum)
----
0

query I
SELECT count(*) FROM pg_attrdef d WHERE d.adrelid >= 16384 AND NOT EXISTS (SELECT 1 FROM pg_attribute a WHERE a.attrelid = d.adrelid AND a.attnum = d.adnum AND a.atthasdef)
----
0

query I
SELECT count(*) FROM pg_attribute a WHERE a.attrelid >= 16384 AND a.attidentity <> '' AND NOT EXISTS (SELECT 1 FROM pg_depend d WHERE d.classid = 'pg_class'::regclass AND d.refclassid = 'pg_class'::regclass AND d.refobjid = a.attrelid AND d.refobjsubid = a.attnum AND d.deptype = 'i')
----
0
