# フェーズ 1: DROP INDEX をコミットする。

statement ok
CREATE TABLE m4r_id_t (id int PRIMARY KEY, a int, b int)

statement ok
CREATE INDEX m4r_id_a ON m4r_id_t (a)

statement ok
CREATE INDEX m4r_id_b ON m4r_id_t (b)

statement count 4
