-- case scan_limit
-- schema
create table t(a int4, b int4, c text);
create table u(a int4, d int4, e text);
create table p(id int4 primary key, v int4);
create table w(k int4 unique, v int4);
-- sql
select a from t order by a limit 5 offset 2
-- build
Limit limit=CAST(5 AS bigint) offset=CAST(2 AS bigint)
  Sort [#0:t.a ASC NULLS LAST]
    Project [#0:t.a]
      Get t [#0:t.a #1:t.b #2:t.c]
-- const_fold
Limit limit=5 offset=2
  Sort [#0:t.a ASC NULLS LAST]
    Project [#0:t.a]
      Get t [#0:t.a #1:t.b #2:t.c]
-- sublink
