-- case star_avoids_cross
-- schema
create table t(a int4, b int4, c text);
create table u(a int4, d int4, e text);
create table v(x int4, y int4);
create table p(id int4 primary key, v int4);
-- sql
select * from t, u, v where t.a = v.x and u.d = v.y
-- build
Project [#0:t.a #1:t.b #2:t.c #3:u.a #4:u.d #5:u.e #6:v.x #7:v.y]
  Filter ((#0:t.a = #6:v.x) AND (#4:u.d = #7:v.y))
    Join Inner
      Join Inner
        Get t [#0:t.a #1:t.b #2:t.c]
        Get u [#3:u.a #4:u.d #5:u.e]
      Get v [#6:v.x #7:v.y]
-- const_fold
(unchanged)
-- sublink
(unchanged)
-- subquery_pullup
(unchanged)
-- outer_join
(unchanged)
-- pushdown
Project [#0:t.a #1:t.b #2:t.c #3:u.a #4:u.d #5:u.e #6:v.x #7:v.y]
  Join Inner on ((#0:t.a = #6:v.x) AND (#4:u.d = #7:v.y))
    Join Inner
      Get t [#0:t.a #1:t.b #2:t.c]
      Get u [#3:u.a #4:u.d #5:u.e]
    Get v [#6:v.x #7:v.y]
-- join_keys
(unchanged)
-- join_order
Project [#0:t.a #1:t.b #2:t.c #3:u.a #4:u.d #5:u.e #6:v.x #7:v.y]
  Join Inner on (#7:v.y = #4:u.d)
    Join Inner on (#0:t.a = #6:v.x)
      Get t [#0:t.a #1:t.b #2:t.c]
      Get v [#6:v.x #7:v.y]
    Get u [#3:u.a #4:u.d #5:u.e]
-- prune
(unchanged)
-- case chain_keeps_order
