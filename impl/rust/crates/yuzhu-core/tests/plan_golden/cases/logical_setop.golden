-- case setop_union
-- schema
create table t(a int4, b int4, c text);
create table u(a int4, d int4, e text);
create table p(id int4 primary key, v int4);
create table w(k int4 unique, v int4);
-- sql
select a from t union select a from u
-- build
SetOp Union all=false cols=[#6:a] left=[#0:t.a] right=[#3:u.a]
  Project [#0:t.a]
    Get t [#0:t.a #1:t.b #2:t.c]
  Project [#3:u.a]
    Get u [#3:u.a #4:u.d #5:u.e]
-- const_fold
(unchanged)
-- sublink
(unchanged)
-- subquery_pullup
(unchanged)
-- outer_join
