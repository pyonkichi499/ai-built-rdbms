-- case setop_except_order
-- schema
create table t(a int4, b int4, c text);
create table u(a int4, d int4, e text);
create table p(id int4 primary key, v int4);
create table w(k int4 unique, v int4);
-- sql
select a from t except select a from u order by 1
-- build
Sort [#6:a ASC NULLS LAST]
  SetOp Except all=false cols=[#6:a] left=[#0:t.a] right=[#3:u.a]
    Project [#0:t.a]
      Get t [#0:t.a #1:t.b #2:t.c]
    Project [#3:u.a]
      Get u [#3:u.a #4:u.d #5:u.e]
