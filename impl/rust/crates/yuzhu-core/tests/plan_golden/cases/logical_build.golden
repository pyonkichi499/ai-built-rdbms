-- case group_by_order
-- schema
create table t(a int4, b int4, c text);
create table u(a int4, d int4, e text);
create table v(x int4, y int4);
create table p(id int4 primary key, v int4);
-- sql
select t.c, count(*) from t join u on t.a = u.a where u.d > 1 group by t.c order by 2 desc
-- build
Sort [#6:count DESC NULLS FIRST]
  Project [#2:t.c #6:count]
    Aggregate group=[#2:t.c] aggs=[#6 := count(*)]
      Filter (#4:u.d > 1)
        Join Inner on (#0:t.a = #3:u.a)
          Get t [#0:t.a #1:t.b #2:t.c]
          Get u [#3:u.a #4:u.d #5:u.e]
-- const_fold
(unchanged)
-- sublink
(unchanged)
-- subquery_pullup
(unchanged)
-- outer_join
(unchanged)
-- pushdown
Sort [#6:count DESC NULLS FIRST]
  Project [#2:t.c #6:count]
    Aggregate group=[#2:t.c] aggs=[#6 := count(*)]
      Join Inner on (#0:t.a = #3:u.a)
        Get t [#0:t.a #1:t.b #2:t.c]
        Filter (#4:u.d > 1)
          Get u [#3:u.a #4:u.d #5:u.e]
-- join_keys
(unchanged)
-- join_order
(unchanged)
-- prune
Sort [#6:count DESC NULLS FIRST]
  Project [#2:t.c #6:count]
    Aggregate group=[#2:t.c] aggs=[#6 := count(*)]
      Join Inner on (#0:t.a = #3:u.a)
        Project [#0:t.a #2:t.c]
          Get t [#0:t.a #1:t.b #2:t.c]
        Project [#3:u.a]
          Filter (#4:u.d > 1)
            Get u [#3:u.a #4:u.d #5:u.e]
-- case right_join_swapped
