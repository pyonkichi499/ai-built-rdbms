create table p(id int4 primary key, v int4);
-- sql
select a from t union select a from u order by 1 limit 3
-- build
Limit limit=CAST(3 AS bigint)
  Sort [#6:a ASC NULLS LAST]
    SetOp Union all=false cols=[#6:a] left=[#0:t.a] right=[#3:u.a]
      Project [#0:t.a]
        Get t [#0:t.a #1:t.b #2:t.c]
      Project [#3:u.a]
        Get u [#3:u.a #4:u.d #5:u.e]
