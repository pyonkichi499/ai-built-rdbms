create table u(a int4, d int4, e text);
create table v(x int4, y int4);
create table p(id int4 primary key, v int4);
-- sql
with x as materialized (select a from t) select * from x join x y on x.a = y.a
-- build
Project [#3:x.a #4:y.a]
  Join Inner on (#3:x.a = #4:y.a)
    CteScan x [#3:x.a]
    CteScan x as y [#4:y.a]
CTE x [#0] output=[#0:t.a]
  Project [#0:t.a]
    Get t [#0:t.a #1:t.b #2:t.c]
