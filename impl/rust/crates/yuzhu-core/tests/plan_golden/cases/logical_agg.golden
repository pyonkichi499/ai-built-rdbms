-- case agg_group
-- schema
create table t(a int4, b int4, c text);
create table u(a int4, d int4, e text);
create table p(id int4 primary key, v int4);
create table w(k int4 unique, v int4);
-- sql
select b, count(*), sum(a) from t group by b
-- build
Project [#1:t.b #3:count #4:sum]
  Aggregate group=[#1:t.b] aggs=[#3 := count(*) #4 := sum(#0:t.a)]
    Get t [#0:t.a #1:t.b #2:t.c]
-- const_fold
(unchanged)
-- sublink
(unchanged)
-- subquery_pullup
(unchanged)
