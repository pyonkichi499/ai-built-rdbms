create table u(a int4, d int4, e text);
create table p(id int4 primary key, v int4);
create table w(k int4 unique, v int4);
-- sql
delete from u where d in (select b from t)
-- build
Delete u old=[#0:u.a #1:u.d #2:u.e] ctid=#3:u.ctid
  Project [#0:u.a #1:u.d #2:u.e #3:u.ctid]
    Filter {SubLink Any test=(#1:u.d = out0)}
      ~ Project [#5:t.b]
          Get t [#4:t.a #5:t.b #6:t.c]
      Get u [#0:u.a #1:u.d #2:u.e #3:u.ctid]
