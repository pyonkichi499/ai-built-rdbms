create table u(a int4, d int4, e text);
create table p(id int4 primary key, v int4);
create table w(k int4 unique, v int4);
-- sql
update t set b = b + 1 where a = 3
-- build
Update t old=[#0:t.a #1:t.b #2:t.c] ctid=#3:t.ctid new=[1:=#4:b]
  Project [#0:t.a #1:t.b #2:t.c #3:t.ctid #4 := (#1:t.b + 1)]
    Filter (#0:t.a = 3)
      Get t [#0:t.a #1:t.b #2:t.c #3:t.ctid]
