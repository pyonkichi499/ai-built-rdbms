-- case dml_update_pk
-- schema
create table t(a int4, b int4, c text);
create table u(a int4, d int4, e text);
create table p(id int4 primary key, v int4);
create table w(k int4 unique, v int4);
-- sql
update p set v = 0 where id = 1
-- build
Update p old=[#0:p.id #1:p.v] ctid=#2:p.ctid new=[1:=#3:v]
  Project [#0:p.id #1:p.v #2:p.ctid #3 := 0]
    Filter (#0:p.id = 1)
      Get p [#0:p.id #1:p.v #2:p.ctid]
