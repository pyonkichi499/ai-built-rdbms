-- case inline_cte
-- schema
create table t(a int4, b int4, c text);
create table u(a int4, d int4, e text);
create table v(x int4, y int4);
create table p(id int4 primary key, v int4);
-- sql
with x as (select a, b from t where b > 0) select x.a from x join u on x.a = u.a
-- build
Project [#0:t.a]
  Join Inner on (#0:t.a = #3:u.a)
    Project [#0:t.a #1:t.b]
      Filter (#1:t.b > 0)
        Get t [#0:t.a #1:t.b #2:t.c]
    Get u [#3:u.a #4:u.d #5:u.e]
-- const_fold
(unchanged)
-- sublink
(unchanged)
-- subquery_pullup
Project [#0:t.a]
  Join Inner on (#0:t.a = #3:u.a)
    Filter (#1:t.b > 0)
      Get t [#0:t.a #1:t.b #2:t.c]
    Get u [#3:u.a #4:u.d #5:u.e]
-- outer_join
(unchanged)
-- pushdown
(unchanged)
-- join_keys
(unchanged)
-- join_order
(unchanged)
-- prune
Project [#0:t.a]
  Join Inner on (#0:t.a = #3:u.a)
    Project [#0:t.a]
      Filter (#1:t.b > 0)
        Get t [#0:t.a #1:t.b #2:t.c]
    Project [#3:u.a]
      Get u [#3:u.a #4:u.d #5:u.e]
